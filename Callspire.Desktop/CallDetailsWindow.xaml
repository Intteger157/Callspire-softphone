<Window x:Class="Softphone.CallDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Call Details" Height="700" Width="900" MinHeight="400" MinWidth="600"
        WindowStyle="None" 
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8,8,8,8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <ResourceDictionary>
            <!-- Theme dictionaries are provided by App.xaml (System/Dark/Light). -->
            
            <!-- Slider Button Style -->
            <Style x:Key="SliderButtonStyle" TargetType="RepeatButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" Height="4"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Global ScrollBar Style -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{DynamicResource BackgroundDarkBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="GridRoot" Background="{DynamicResource BackgroundDarkBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition MaxHeight="{x:Static SystemParameters.VerticalScrollBarButtonHeight}"/>
                                    <RowDefinition Height="0.00001*"/>
                                    <RowDefinition MaxHeight="{x:Static SystemParameters.VerticalScrollBarButtonHeight}"/>
                                </Grid.RowDefinitions>
                                
                                <Border Grid.Row="1" Background="{DynamicResource BackgroundDarkBrush}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                        <Track.Thumb>
                                            <Thumb Background="{DynamicResource BackgroundLightBrush}">
                                                <Thumb.Style>
                                                    <Style TargetType="Thumb">
                                                        <Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            BorderThickness="0"
                                                                            CornerRadius="4"
                                                                            Margin="2"/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Thumb.Style>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Primary CTA for AmoCRM upload (green stays on hover; ModernButtonStyle uses gray hover) -->
            <Style x:Key="AmoUploadPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1B8A4A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#167A40"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border x:Name="WindowSurface"
                Background="{DynamicResource BackgroundDarkBrush}" 
                CornerRadius="8" 
                ClipToBounds="False"
                Margin="0">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{DynamicResource BackgroundMediumBrush}" 
                    CornerRadius="8,8,0,0"
                    ClipToBounds="False"
                    Margin="0">
                <Grid MouseDown="TitleBar_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Call Details" 
                              FontSize="14" FontWeight="SemiBold" 
                              Margin="16,10,0,10" 
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="─" Width="46"
                               Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                               BorderThickness="0" Click="MinimizeButton_Click"
                               FontSize="16" Cursor="Hand"
                               VerticalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="✕"
                               Click="CloseButton_Click"
                               Style="{DynamicResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Hidden" 
                         HorizontalScrollBarVisibility="Disabled"
                         PanningMode="VerticalOnly"
                         Margin="12">
                <StackPanel>
                    <!-- Call Information -->
                    <TextBlock Text="Call Information" 
                              FontSize="17" FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,8"/>
                    
                    <!-- Two-column layout: left = call info, right = timing info -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: General call information -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource BackgroundMediumBrush}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="128"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Phone Number:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,12,5"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,5">
                                    <TextBlock Name="PhoneNumberTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Name="CopyPhoneNumberButton"
                                            Content="Copy"
                                            Click="CopyPhoneNumberButton_Click"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            BorderThickness="0"
                                            Padding="8,4"
                                            FontSize="11"
                                            Cursor="Hand"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Row 1: Outbound CallerID (P-Asserted-Identity) -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Name="OutboundCallerIdLabel" Text="Outbound CallerID:"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,12,5"
                                           Visibility="Collapsed"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="OutboundCallerIdTextBlock"
                                           Foreground="{DynamicResource AccentGreenBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"
                                           Visibility="Collapsed"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Call Time:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,12,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Name="CallTimeTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Direction:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,12,5"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Name="DirectionTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               Margin="0,0,8,0"/>
                                    <Border x:Name="TransportBadgeBorder"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource BackgroundLightBrush}">
                                        <TextBlock x:Name="TransportBadgeTextBlock"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,12,5"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Name="StatusTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Duration:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,12,5"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Name="DurationTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Was Answered:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,12,5"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Name="WasAnsweredTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Call Ended By:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,12,0"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Name="EndedByTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Right: Timing information -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource BackgroundMediumBrush}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Timing Information"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ringback Duration:" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               Margin="0,0,10,5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Name="RingbackDurationTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               Margin="0,0,0,5"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ringback Start:" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               Margin="0,0,10,5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Name="RingbackStartTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               Margin="0,0,0,5"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Answer Time:" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               Margin="0,0,12,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Name="AnswerTimeTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               Margin="0,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Call Recording -->
                    <TextBlock Name="CallRecordingSectionTitle" Text="Call Recording" 
                              FontSize="17" FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,12,0,8"/>
                    
                    <Border Background="{DynamicResource BackgroundMediumBrush}"
                           CornerRadius="4"
                           Padding="10"
                           Margin="0,0,0,12"
                           Name="RecordingBorder"
                           Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" 
                                          Text="Call Recording:" 
                                          Foreground="{DynamicResource TextSecondaryBrush}" 
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"/>
                                
                                <TextBlock Grid.Column="1" 
                                          Name="RecordingFilePathTextBlock"
                                          Foreground="{DynamicResource TextPrimaryBrush}" 
                                          VerticalAlignment="Center"
                                          TextTrimming="CharacterEllipsis"/>
                                
                                <StackPanel Grid.Column="2" 
                                           Orientation="Horizontal"
                                           Margin="10,0,0,0"
                                           HorizontalAlignment="Right">
                                    <Button Name="PlayRecordingButton"
                                           Content="Play" 
                                           Click="PlayRecordingButton_Click"
                                           Style="{DynamicResource ModernButtonStyle}"
                                           Padding="10,5"
                                           Margin="0,0,6,0"/>
                                    <Button Name="OpenFolderButton"
                                           Content="Open folder" 
                                           Click="OpenFolderButton_Click"
                                           Style="{DynamicResource ModernButtonStyle}"
                                           Padding="10,5"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AmoCRM: status + manual upload (hidden when integration is off in settings) -->
                    <Border x:Name="AmoCrmSectionBorder"
                            Margin="0,12,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="AmoCRM"
                                      FontSize="17" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,0,0,8"/>

                            <Border Background="{DynamicResource BackgroundMediumBrush}"
                                   CornerRadius="8"
                                   Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="148"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Name="RecordAddedLabel" Text="Record added to:"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,12,6" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Name="AmoCrmLeadTextBlock"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,8,0"/>
                                        <Button Name="OpenAmoCrmLeadButton"
                                                Content="Open lead"
                                                Click="OpenAmoCrmLeadButton_Click"
                                                Style="{DynamicResource ModernButtonStyle}"
                                                Padding="8,4"
                                                FontSize="11"
                                                Visibility="Collapsed"
                                                Margin="0,0,8,0"/>
                                        <Button Name="OpenAmoCrmContactButton"
                                                Content="Open contact"
                                                Click="OpenAmoCrmContactButton_Click"
                                                Style="{DynamicResource ModernButtonStyle}"
                                                Padding="8,4"
                                                FontSize="11"
                                                Visibility="Collapsed"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Name="AmoCrmContactNameLabel" Text="AmoCRM contact name:"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,12,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Name="AmoCrmContactNameTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,6"
                                               TextWrapping="Wrap"
                                               Text="Loading..."/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Name="AmoCrmUploadStatusLabel" Text="Recording upload status:"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,12,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Name="AmoCrmUploadStatusTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,6"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Name="AmoCrmUploadedRecordingSourceLabel" Text="Uploaded recording:"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,12,0" VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Name="AmoCrmUploadedRecordingSourceTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,6"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Border Name="AmoCrmManualUploadBorder"
                                    Margin="0,8,0,0"
                                    CornerRadius="8"
                                    Padding="12"
                                    Background="{DynamicResource BackgroundLightBrush}"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource AccentGreenBrush}"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Send result to CRM"
                                              FontSize="14" FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                  Text="Recording:"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1"
                                                  Name="CrmRecordingFileTextBlock"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  VerticalAlignment="Center"
                                                  TextTrimming="CharacterEllipsis"
                                                  Text="Loading..."/>
                                        <Button Grid.Column="2"
                                                Name="PlayCrmRecordingButton"
                                                Content="Play"
                                                Click="PlayCrmRecordingButton_Click"
                                                Style="{DynamicResource ModernButtonStyle}"
                                                Padding="10,5"
                                                Margin="10,0,0,0"
                                                IsEnabled="False"/>
                                    </Grid>
                                    <Button Name="UploadCallResultButton"
                                            Content="Upload local recording"
                                            Click="UploadCallResultButton_Click"
                                            HorizontalAlignment="Left"
                                            MinWidth="220"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Padding="16,9"
                                            Style="{DynamicResource AmoUploadPrimaryButtonStyle}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Technical Details -->
                    <TextBlock Text="Technical Details" 
                              FontSize="17" FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,12,0,8"/>
                    
                    <Border Background="{DynamicResource BackgroundMediumBrush}"
                           CornerRadius="4"
                           Padding="0"
                           Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Tab Control -->
                            <TabControl Name="LogsTabControl"
                                       Grid.Row="0"
                                       SelectionChanged="LogsTabControl_SelectionChanged"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Margin="0,0,0,0">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TabItem">
                                                    <Border Name="Border"
                                                           Background="{TemplateBinding Background}"
                                                           BorderThickness="0"
                                                           Margin="0,0,4,0">
                                                        <ContentPresenter ContentSource="Header"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.Resources>
                                
                                <TabItem Header="All Logs" Name="AllLogsTab"/>
                                <TabItem Header="AmoCRM Logs" Name="AmoCrmLogsTab"/>
                                <TabItem Header="WebRTC Logs" Name="WebRtcLogsTab"/>
                                <TabItem Header="SIP Logs" Name="SipLogsTab"/>
                            </TabControl>
                            
                            <!-- Log Content Area -->
                            <Grid Grid.Row="1" Margin="8,0,8,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                             HorizontalScrollBarVisibility="Disabled"
                                             MaxHeight="400"
                                             VerticalAlignment="Stretch"
                                             PanningMode="VerticalOnly">
                                    <TextBox Name="TechnicalDetailsTextBlock"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            TextWrapping="Wrap"
                                            IsReadOnly="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Text="Loading logs..."
                                            VerticalScrollBarVisibility="Disabled"
                                            HorizontalScrollBarVisibility="Disabled"
                                            SelectionBrush="{DynamicResource AccentGreenBrush}"
                                            SelectionOpacity="0.5">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </ScrollViewer>
                                <Button HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Content="Copy" 
                                       Click="CopyTechnicalDetailsButton_Click"
                                       Background="Transparent"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       BorderThickness="0"
                                       Padding="8,4"
                                       FontSize="11"
                                       Cursor="Hand"
                                       Margin="0,4,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="12,6,12,12">
                <Button Content="Close" 
                       Click="CloseButton_Click"
                       Style="{DynamicResource ModernButtonStyle}"
                       HorizontalAlignment="Right"
                       Padding="16,8"/>
            </Grid>
            </Grid>
        </Border>

        <Border x:Name="WindowStroke"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
    </Grid>
</Window>

