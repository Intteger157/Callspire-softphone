<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Minimal fallback resources so the app never crashes on missing theme keys. -->

    <!-- Colors -->
    <Color x:Key="BackgroundDark">#1E1E1E</Color>
    <Color x:Key="BackgroundMedium">#252525</Color>
    <Color x:Key="BackgroundLight">#2D2D2D</Color>
    <Color x:Key="AccentBlue">#5865F2</Color>
    <Color x:Key="AccentGreen">#23A55A</Color>
    <Color x:Key="AccentRed">#F23F42</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#9CA3AF</Color>
    <Color x:Key="HoverBackground">#3A3A3A</Color>
    <Color x:Key="BorderColor">#404040</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDark}"/>
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{StaticResource BackgroundMedium}"/>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLight}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackground}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <!-- Opaque surfaces for layered dialogs/popups -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="{StaticResource BackgroundDark}"/>
    <SolidColorBrush x:Key="DialogChromeBrush" Color="{StaticResource BackgroundMedium}"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{StaticResource BackgroundMedium}"/>
</ResourceDictionary>

