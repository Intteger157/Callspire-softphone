<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Windows 11 native look: make surfaces slightly transparent so Mica can show through.
      These override the normal DarkTheme brushes ONLY on Win11.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="#CC1E1E1E"/>
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="#B3252525"/>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="#A02D2D2D"/>

    <!-- Opaque surfaces for layered dialogs/popups (avoid alpha blending artifacts) -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="DialogChromeBrush" Color="#FF252525"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FF252525"/>

    <!-- Hover + border tuned for Mica -->
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#553A3A3A"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#66404040"/>
</ResourceDictionary>


