<Window x:Class="Softphone.Avalonia.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vm="using:Softphone.AppHost.ViewModels"
        xmlns:core="using:Softphone"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="Callspire"
        Height="720" Width="1250"
        MinHeight="560" MinWidth="780"
        WindowDecorations="None"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundDarkBrush}"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="None">

    <Window.Styles>

        <!-- History status colouring driven by view-model booleans -->
        <Style Selector="TextBlock.statusOk">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="TextBlock.statusBad">
            <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}"/>
        </Style>
        <Style Selector="Border.statusDot">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.statusDot.online">
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="Border.statusDot.error">
            <Setter Property="Background" Value="{DynamicResource AccentRedBrush}"/>
        </Style>
        <Style Selector="TextBlock.statusText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.statusText.online">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.statusText.error">
            <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource BackgroundMediumBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style Selector="Border.kpi">
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="Border.kpi:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
        </Style>
        <Style Selector="TextBlock.statsCardLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.statsCardValue">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style Selector="TextBlock.statsCardHint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Styles>

    <Border Name="WindowSurface"
            Background="{DynamicResource BackgroundDarkBrush}"
            CornerRadius="8"
            ClipToBounds="True">

        <Grid Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════ Title Bar (custom chrome; hidden on macOS/Linux) ══════════════════════ -->
            <Border Grid.Row="0" Name="CustomTitleBar"
                    Background="{DynamicResource BackgroundMediumBrush}"
                    CornerRadius="8,8,0,0">
                <Grid PointerPressed="TitleBar_PointerPressed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Margin="16,10,0,10" VerticalAlignment="Center">
                        <Image Width="18" Height="18" Margin="0,0,8,0"
                               Source="avares://Callspire/Assets/icon.png"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <TextBlock Text="Callspire"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                        <Panel IsVisible="{Binding AnyOnline}" Margin="0,0,6,0" VerticalAlignment="Center">
                            <ic:SymbolIcon Classes="hasFallback" Symbol="CheckmarkCircle" Width="14" Height="14" IconVariant="Filled"
                                           Foreground="{DynamicResource AccentGreenBrush}"/>
                            <TextBlock Classes="iconFallback" Text="●" FontSize="10" Foreground="{DynamicResource AccentGreenBrush}"/>
                        </Panel>
                        <TextBlock Text="{Binding AccountText}"
                                   ToolTip.Tip="{Binding AccountToolTip}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="─" Width="46" Height="32"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0" FontSize="16"
                                VerticalAlignment="Stretch"
                                Click="MinimizeButton_Click"
                                Cursor="Hand"/>
                        <Button Content="✕"
                                Click="CloseButton_Click"
                                Theme="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════ Main Content ══════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Sidebar ── -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BackgroundMediumBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,8"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="4,16,4,16" Height="48">
                            <Border Background="{DynamicResource AccentBlueBrush}"
                                    CornerRadius="24" Width="48" Height="48">
                                <TextBlock Text="C" FontSize="20" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Border>

                        <StackPanel Grid.Row="1">
                            <Button Theme="{StaticResource SidebarButtonStyle}"
                                    Click="DialerButton_Click" Name="DialerButton"
                                    ToolTip.Tip="Dialer">
                                <Panel>
                                    <ic:SymbolIcon Classes="hasFallback" Symbol="Dialpad" Width="22" Height="22" FontSize="22" IconVariant="Filled"/>
                                    <TextBlock Classes="iconFallback" Text="⌨"/>
                                </Panel>
                            </Button>
                            <Button Theme="{StaticResource SidebarButtonStyle}"
                                    Click="HistoryButton_Click" Name="HistoryButton"
                                    ToolTip.Tip="History">
                                <Panel>
                                    <ic:SymbolIcon Classes="hasFallback" Symbol="History" Width="22" Height="22" FontSize="22" IconVariant="Filled"/>
                                    <TextBlock Classes="iconFallback" Text="⏱"/>
                                </Panel>
                            </Button>
                            <Button Theme="{StaticResource SidebarButtonStyle}"
                                    Click="StatisticsButton_Click" Name="StatisticsButton"
                                    ToolTip.Tip="Statistics">
                                <Panel>
                                    <ic:SymbolIcon Classes="hasFallback" Symbol="ChartMultiple" Width="22" Height="22" FontSize="22" IconVariant="Filled"/>
                                    <TextBlock Classes="iconFallback" Text="▦"/>
                                </Panel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Button Theme="{StaticResource SidebarButtonStyle}"
                                    Click="SettingsButton_Click"
                                    ToolTip.Tip="Settings">
                                <Panel>
                                    <ic:SymbolIcon Classes="hasFallback" Symbol="Settings" Width="22" Height="22" FontSize="22" IconVariant="Filled"/>
                                    <TextBlock Classes="iconFallback" Text="⚙"/>
                                </Panel>
                            </Button>
                            <Button Theme="{StaticResource SidebarButtonStyle}"
                                    Click="ShowLogsButton_Click"
                                    Margin="0,0,0,16"
                                    ToolTip.Tip="Logs">
                                <Panel>
                                    <ic:SymbolIcon Classes="hasFallback" Symbol="DocumentText" Width="22" Height="22" FontSize="22" IconVariant="Filled"/>
                                    <TextBlock Classes="iconFallback" Text="≡"/>
                                </Panel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Content Area ── -->
                <Grid Grid.Column="1" Background="{DynamicResource BackgroundDarkBrush}">

                    <!-- ── Dialer View ── -->
                    <Grid Name="DialerView" IsVisible="True"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="0,0,0,24"
                          MaxWidth="420" MinWidth="280">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Connection status block -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center">

                                <!-- Main line -->
                                <Grid Margin="0,0,0,4" VerticalAlignment="Center"
                                      IsVisible="{Binding Main.IsConfigured}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" MinWidth="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Main.Label}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Classes="statusDot"
                                            Classes.online="{Binding Main.IsOnline}"
                                            Classes.error="{Binding Main.IsError}"/>
                                    <TextBlock Grid.Column="2" Classes="statusText"
                                               Classes.online="{Binding Main.IsOnline}"
                                               Classes.error="{Binding Main.IsError}"
                                               Text="{Binding Main.Text}"/>
                                    <Button Grid.Column="3" Width="20" Height="20" Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Reconnect main connection"
                                            Click="MainRefreshButton_Click"
                                            Theme="{StaticResource StatusRefreshButtonStyle}">
                                        <Panel>
                                            <ic:SymbolIcon Classes="hasFallback" Symbol="ArrowClockwise" Width="12" Height="12"/>
                                            <TextBlock Classes="iconFallback" Text="↻" FontSize="12"/>
                                        </Panel>
                                    </Button>
                                </Grid>

                                <!-- Secondary line -->
                                <Grid Margin="0,0,0,4" VerticalAlignment="Center"
                                      IsVisible="{Binding Secondary.IsConfigured}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" MinWidth="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Secondary.Label}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Classes="statusDot"
                                            Classes.online="{Binding Secondary.IsOnline}"
                                            Classes.error="{Binding Secondary.IsError}"/>
                                    <TextBlock Grid.Column="2" Classes="statusText"
                                               Classes.online="{Binding Secondary.IsOnline}"
                                               Classes.error="{Binding Secondary.IsError}"
                                               Text="{Binding Secondary.Text}"/>
                                    <Button Grid.Column="3" Width="20" Height="20" Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Reconnect secondary connection"
                                            Click="SecondaryRefreshButton_Click"
                                            Theme="{StaticResource StatusRefreshButtonStyle}">
                                        <Panel>
                                            <ic:SymbolIcon Classes="hasFallback" Symbol="ArrowClockwise" Width="12" Height="12"/>
                                            <TextBlock Classes="iconFallback" Text="↻" FontSize="12"/>
                                        </Panel>
                                    </Button>
                                </Grid>

                                <!-- Kommo -->
                                <Grid VerticalAlignment="Center" IsVisible="{Binding AmoCrmConfigured}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" MinWidth="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Kommo:" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Classes="statusDot"
                                            Classes.online="{Binding AmoCrmOnline}"/>
                                    <TextBlock Grid.Column="2" Classes="statusText"
                                               Classes.online="{Binding AmoCrmOnline}"
                                               Text="{Binding AmoCrmStatusText}"/>
                                </Grid>
                            </StackPanel>

                            <!-- SIP auth-failure warning banner -->
                            <Border Background="#3c1f12" BorderBrush="#b0532f" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Margin="0,8,0,0"
                                    IsVisible="{Binding ShowSipAuthFailureBanner}">
                                <TextBlock Text="{Binding SipAuthFailureText}" Foreground="#ffd9b0" FontSize="12"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Phone number input + backspace -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Grid.ColumnSpan="2"
                                     Name="PhoneNumberTextBox"
                                     Text="{Binding PhoneNumber, Mode=TwoWay}"
                                     Watermark="Enter the number"
                                     FontSize="28" FontWeight="Light"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Center"
                                     CaretBrush="{DynamicResource AccentBlueBrush}"
                                     KeyDown="PhoneNumberTextBox_KeyDown"/>
                            <Button Grid.Column="1"
                                    Theme="{StaticResource BackspaceButtonStyle}"
                                    Click="BackspaceButton_Click"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <Panel>
                                    <ic:SymbolIcon Classes="hasFallback" Symbol="Backspace" Width="20" Height="20" IconVariant="Filled"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Classes="iconFallback" Text="⌫" FontSize="18"/>
                                </Panel>
                            </Button>
                            <Border Grid.Column="0" Grid.ColumnSpan="2"
                                    BorderThickness="0,0,0,2"
                                    BorderBrush="{DynamicResource AccentBlueBrush}"
                                    VerticalAlignment="Bottom"/>
                        </Grid>

                        <!-- Numpad + Call buttons -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top">

                            <!-- CallerID selector -->
                            <StackPanel IsVisible="{Binding ShowCallerIdPicker}"
                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="Caller ID" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <ComboBox Classes="field" Margin="0" ItemsSource="{Binding CallerIds}"
                                          SelectedItem="{Binding SelectedCallerId, Mode=TwoWay}"
                                          SelectionChanged="CallerIdComboBox_SelectionChanged"
                                          HorizontalAlignment="Center" Width="260" FontSize="13"
                                          ToolTip.Tip="Select outbound Caller ID"/>
                            </StackPanel>

                            <!-- Numpad grid -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Content="1" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="2" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="3" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                                <Button Grid.Row="1" Grid.Column="0" Content="4" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="5" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="6" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                                <Button Grid.Row="2" Grid.Column="0" Content="7" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="8" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="9" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                                <Button Grid.Row="3" Grid.Column="0" Content="*" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                                <Button Grid.Row="3" Grid.Column="1" Content="0" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="#" Theme="{StaticResource NumpadButtonStyle}" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="64" MinHeight="64" Click="NumpadButton_Click" Margin="8,2"/>
                            </Grid>

                            <!-- Call buttons row -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">

                                <!-- Single call button -->
                                <Button Theme="{StaticResource NumpadCallButtonStyle}"
                                        Click="CallButton_Click"
                                        HorizontalAlignment="Center"
                                        Margin="8,0"
                                        IsVisible="{Binding ShowSingleCallButton}"
                                        IsEnabled="{Binding CanCall}">
                                    <Panel>
                                        <ic:SymbolIcon Classes="hasFallback" Symbol="Call" Width="26" Height="26" FontSize="26" IconVariant="Filled" Foreground="White"/>
                                        <TextBlock Classes="iconFallback" Text="☎" Foreground="White"/>
                                    </Panel>
                                </Button>

                                <!-- Split call button (two lines) -->
                                <Grid IsVisible="{Binding ShowSplitCallButtons}" HorizontalAlignment="Center"
                                      Margin="8,0" Height="64" Width="150">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Background="{DynamicResource AccentGreenBrush}"
                                            Click="SplitCallPrimary_Click"
                                            IsEnabled="{Binding CanCall}"
                                            ToolTip.Tip="Call via main connection"
                                            Cursor="Hand" BorderThickness="0" CornerRadius="32,0,0,32">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Panel HorizontalAlignment="Center">
                                                <ic:SymbolIcon Classes="hasFallback" Symbol="Call" Width="22" Height="22" FontSize="22" IconVariant="Filled" Foreground="White"/>
                                                <TextBlock Classes="iconFallback" Text="☎" FontSize="18" Foreground="White"/>
                                            </Panel>
                                            <TextBlock Text="{Binding SplitPrimaryLabel}" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="#CCFFFFFF" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Grid.Column="1" Width="1.5" Background="#33FFFFFF" VerticalAlignment="Stretch"/>

                                    <Button Grid.Column="2"
                                            Background="{DynamicResource AccentGreenBrush}"
                                            Click="SplitCallSecondary_Click"
                                            IsEnabled="{Binding CanCall}"
                                            ToolTip.Tip="Call via secondary connection"
                                            Cursor="Hand" BorderThickness="0" CornerRadius="0,32,32,0">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Panel HorizontalAlignment="Center">
                                                <ic:SymbolIcon Classes="hasFallback" Symbol="Call" Width="22" Height="22" FontSize="22" IconVariant="Filled" Foreground="White"/>
                                                <TextBlock Classes="iconFallback" Text="☎" FontSize="18" Foreground="White"/>
                                            </Panel>
                                            <TextBlock Text="{Binding SplitSecondaryLabel}" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="#CCFFFFFF" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ── History View ── -->
                    <Grid Name="HistoryView" IsVisible="False" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Call History" FontSize="24" FontWeight="Light"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" IsVisible="{Binding HasHistoryFilter}" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding HistoryFilterHint}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button Content="Clear filter" FontSize="11" Padding="8,2" Margin="8,0,0,0"
                                            Background="Transparent" Foreground="{DynamicResource AccentBlueBrush}"
                                            BorderThickness="0" Cursor="Hand" Click="ClearHistoryFilter_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Clear History"
                                    HorizontalAlignment="Right"
                                    Foreground="{DynamicResource AccentRedBrush}"
                                    Background="{DynamicResource BackgroundMediumBrush}"
                                    BorderThickness="0"
                                    Padding="12,6" FontSize="14" Cursor="Hand"
                                    Click="ClearHistoryButton_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                        <Border Background="{DynamicResource BackgroundMediumBrush}"
                                                CornerRadius="8" Padding="16,12" Margin="0,0,0,8"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                Cursor="Hand"
                                                DoubleTapped="HistoryItem_DoubleTapped"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Panel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <Panel IsVisible="{Binding IsOutgoing}">
                                                        <ic:SymbolIcon Classes="hasFallback" Symbol="ArrowUpRight" Width="20" Height="20" IconVariant="Filled"
                                                                       Foreground="{DynamicResource AccentBlueBrush}"/>
                                                        <TextBlock Classes="iconFallback" Text="↗" FontSize="18" Foreground="{DynamicResource AccentBlueBrush}"/>
                                                    </Panel>
                                                    <Panel IsVisible="{Binding IsIncomingAnswered}">
                                                        <ic:SymbolIcon Classes="hasFallback" Symbol="ArrowDownLeft" Width="20" Height="20" IconVariant="Filled"
                                                                       Foreground="{DynamicResource AccentGreenBrush}"/>
                                                        <TextBlock Classes="iconFallback" Text="↙" FontSize="18" Foreground="{DynamicResource AccentGreenBrush}"/>
                                                    </Panel>
                                                    <Panel IsVisible="{Binding IsMissed}">
                                                        <ic:SymbolIcon Classes="hasFallback" Symbol="CallMissed" Width="20" Height="20" IconVariant="Filled"
                                                                       Foreground="{DynamicResource AccentRedBrush}"/>
                                                        <TextBlock Classes="iconFallback" Text="✕" FontSize="16" Foreground="{DynamicResource AccentRedBrush}"/>
                                                    </Panel>
                                                </Panel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PhoneNumberDisplay}"
                                                                   FontSize="16" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <Border Background="{DynamicResource AccentBlueBrush}"
                                                                CornerRadius="4" Padding="6,2"
                                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TransportLabel}"
                                                                       FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding ConnectionLabel}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CrmStatus}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CallTimeText}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Vertical"
                                                            VerticalAlignment="Center" Margin="16,0">
                                                    <TextBlock Text="{Binding DurationText}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="12"
                                                               Classes.statusOk="{Binding IsStatusOk}"
                                                               Classes.statusBad="{Binding IsStatusBad}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Right"/>
                                                </StackPanel>
                                                <Button Grid.Column="3"
                                                        Width="36" Height="36"
                                                        Theme="{StaticResource NumpadCallButtonStyle}"
                                                        Background="{DynamicResource AccentGreenBrush}"
                                                        Margin="8,0,0,0" Padding="10"
                                                        Tag="{Binding PhoneNumber}"
                                                        Click="CallFromHistoryButton_Click">
                                                    <Panel>
                                                        <ic:SymbolIcon Classes="hasFallback" Symbol="Call" IconVariant="Filled" Foreground="White"
                                                                       Width="16" Height="16" FontSize="16"/>
                                                        <TextBlock Classes="iconFallback" Text="☎" FontSize="14" Foreground="White"/>
                                                    </Panel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="1"
                                   Text="No call history" FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding HistoryIsEmpty}"/>
                    </Grid>

                    <!-- ── Statistics View ── -->
                    <Grid Name="StatisticsView" IsVisible="False" Margin="24"
                          DataContext="{Binding Statistics}" x:DataType="vm:StatisticsViewModel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Call Statistics" FontSize="24" FontWeight="Light"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Operational analytics from the last 7 days of call history"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="Export CSV"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Padding="14,8" FontSize="13" Cursor="Hand"
                                    Background="{DynamicResource BackgroundMediumBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4"
                                    Click="StatisticsExportCsvButton_Click"/>
                        </Grid>

                        <!-- Filters -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" Spacing="10">
                            <TextBlock Text="Period" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Classes="field" Margin="0" Width="180" FontSize="13"
                                      ItemsSource="{x:Static vm:StatisticsViewModel.PeriodOptions}"
                                      SelectedIndex="{Binding PeriodIndex, Mode=TwoWay}"
                                      SelectionChanged="StatisticsFilter_Changed"/>
                            <TextBlock Text="Connection" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Classes="field" Margin="0" Width="180" FontSize="13"
                                      ItemsSource="{Binding ConnectionOptions}"
                                      SelectedIndex="{Binding ConnectionIndex, Mode=TwoWay}"
                                      SelectionChanged="StatisticsFilter_Changed"/>
                            <TextBlock Text="Direction" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Classes="field" Margin="0" Width="150" FontSize="13"
                                      ItemsSource="{x:Static vm:StatisticsViewModel.DirectionOptions}"
                                      SelectedIndex="{Binding DirectionIndex, Mode=TwoWay}"
                                      SelectionChanged="StatisticsFilter_Changed"/>
                        </StackPanel>

                        <!-- Custom date range -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12" Spacing="8"
                                    IsVisible="{Binding IsCustomPeriod}">
                            <TextBlock Text="From" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <CalendarDatePicker SelectedDate="{Binding CustomFrom, Mode=TwoWay}"
                                                SelectedDateChanged="StatisticsCustomDatePicker_SelectedDateChanged"
                                                Margin="0,0,16,0"/>
                            <TextBlock Text="To" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <CalendarDatePicker SelectedDate="{Binding CustomTo, Mode=TwoWay}"
                                                SelectedDateChanged="StatisticsCustomDatePicker_SelectedDateChanged"/>
                        </StackPanel>

                        <!-- Dashboard -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding PeriodHint}" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- KPI row -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="card kpi" Cursor="Hand" PointerReleased="StatisticsKpi_PointerReleased" Tag="All">
                                        <StackPanel>
                                            <TextBlock Text="Total" Classes="statsCardLabel"/>
                                            <TextBlock Text="{Binding KpiTotal}" Classes="statsCardValue"/>
                                            <TextBlock Text="{Binding KpiDirectionHint}" Classes="statsCardHint"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="card kpi" Cursor="Hand" PointerReleased="StatisticsKpi_PointerReleased" Tag="Answered">
                                        <StackPanel>
                                            <TextBlock Text="Answered" Classes="statsCardLabel"/>
                                            <TextBlock Text="{Binding KpiAnswered}" Classes="statsCardValue" Foreground="{DynamicResource AccentGreenBrush}"/>
                                            <TextBlock Text="{Binding KpiSuccessRate}" Classes="statsCardHint"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="card kpi" Cursor="Hand" PointerReleased="StatisticsKpi_PointerReleased" Tag="Unanswered">
                                        <StackPanel>
                                            <TextBlock Text="Unanswered" Classes="statsCardLabel"/>
                                            <TextBlock Text="{Binding KpiUnanswered}" Classes="statsCardValue" Foreground="{DynamicResource AccentRedBrush}"/>
                                            <TextBlock Text="{Binding KpiUnansweredHint}" Classes="statsCardHint"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Classes="card kpi">
                                        <StackPanel>
                                            <TextBlock Text="Talk time" Classes="statsCardLabel"/>
                                            <TextBlock Text="{Binding KpiTalkTime}" Classes="statsCardValue"/>
                                            <TextBlock Text="{Binding KpiAvgTalk}" Classes="statsCardHint"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Classes="card kpi">
                                        <StackPanel>
                                            <TextBlock Text="Contact rate" Classes="statsCardLabel"/>
                                            <TextBlock Text="{Binding KpiContactRate}" Classes="statsCardValue"/>
                                            <TextBlock Text="{Binding KpiRingTime}" Classes="statsCardHint"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="5" Classes="card kpi" Margin="0" Cursor="Hand" PointerReleased="StatisticsKpi_PointerReleased" Tag="Missed">
                                        <StackPanel>
                                            <TextBlock Text="Missed incoming" Classes="statsCardLabel"/>
                                            <TextBlock Text="{Binding KpiMissed}" Classes="statsCardValue" Foreground="{DynamicResource AccentRedBrush}"/>
                                            <TextBlock Text="{Binding KpiFailedCancelled}" Classes="statsCardHint"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Charts row -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="Calls by day" Classes="sectionTitle"/>
                                            <ItemsControl ItemsSource="{Binding Daily}" Height="140">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="core:CallDayBucket">
                                                        <StackPanel VerticalAlignment="Bottom" Margin="2,0">
                                                            <Border Height="{Binding BarHeight}" MinHeight="4"
                                                                    VerticalAlignment="Bottom"
                                                                    Background="{DynamicResource AccentBlueBrush}"
                                                                    CornerRadius="3,3,0,0"
                                                                    ToolTip.Tip="{Binding ToolTipText}"/>
                                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       TextAlignment="Center" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="Activity by hour" Classes="sectionTitle" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding PeakHourText}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Hourly}" Height="110">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="core:CallHourBucket">
                                                            <StackPanel Width="28" VerticalAlignment="Bottom" Margin="1,0">
                                                                <Border Height="{Binding BarHeight}" MinHeight="2"
                                                                        VerticalAlignment="Bottom"
                                                                        Background="{DynamicResource AccentGreenBrush}"
                                                                        CornerRadius="2,2,0,0"
                                                                        ToolTip.Tip="{Binding Total}"/>
                                                                <TextBlock Text="{Binding Label}" FontSize="9"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Outcome + Connection compare -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="card">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Outcome breakdown" Classes="sectionTitle"/>
                                            <TextBlock Text="{Binding OutcomeAnswered}" Classes="statsCardHint"/>
                                            <TextBlock Text="{Binding OutcomeCancelled}" Classes="statsCardHint"/>
                                            <TextBlock Text="{Binding OutcomeAgentCancel}" Classes="statsCardHint"/>
                                            <TextBlock Text="{Binding OutcomeFailed}" Classes="statsCardHint"/>
                                            <TextBlock Text="{Binding OutcomeMissed}" Classes="statsCardHint"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="card" IsVisible="{Binding SecondaryEnabled}">
                                        <StackPanel>
                                            <TextBlock Text="By connection" Classes="sectionTitle"/>
                                            <ItemsControl ItemsSource="{Binding ConnectionCompare}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StatsRow">
                                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="0,0,0,10" Margin="0,0,0,10">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding Detail}" FontSize="12"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Caller ID + Top numbers -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="Outbound Caller ID" Classes="sectionTitle"/>
                                            <ItemsControl ItemsSource="{Binding CallerIds}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StatsRow">
                                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="0,0,0,6"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       IsVisible="{Binding !HasCallerIds}"
                                                       Text="No Caller ID data in this period"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="Top numbers" Classes="sectionTitle"/>
                                            <TextBlock Text="Click a row to view in history" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding TopNumbers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StatsRow">
                                                        <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="4"
                                                                Background="{DynamicResource BackgroundDarkBrush}"
                                                                Cursor="Hand"
                                                                PointerReleased="StatisticsTopNumber_PointerReleased"
                                                                Tag="{Binding PhoneNumber}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding PhoneNumber}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Detail}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           FontSize="12"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       IsVisible="{Binding !HasTopNumbers}"
                                                       Text="No calls in this period"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Calls before dual-line tracking may appear under the main connection in exports."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           IsVisible="{Binding HasLegacyUnknownConnection}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ══════════════════════ Hidden WebRTC engine (NativeWebView: WKWebView / WebKit / WebView2) ══════════════════════
                 Hosts WebRtcClient/index.html (phone.js + JsSIP). Kept in the visual tree with a tiny footprint:
                 WKWebView needs a live native view for getUserMedia / AudioContext, so it must not be collapsed. -->
            <Border Grid.Row="1" Name="WebRtcEngineHostContainer"
                    Width="4" Height="4" Opacity="0.01"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    IsHitTestVisible="False" ZIndex="-1"
                    IsVisible="False"/>
        </Grid>
    </Border>
</Window>
