<Window x:Class="Softphone.Avalonia.ConnectionSelectionWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        Title="Select Connection"
        Width="340"
        SizeToContent="Height"
        WindowDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDarkBrush}"
        ExtendClientAreaToDecorationsHint="True"

        TransparencyLevelHint="None">

    <Border Background="{DynamicResource BackgroundDarkBrush}"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BackgroundMediumBrush}"
                    CornerRadius="8,8,0,0">
                <Grid PointerPressed="TitleBar_PointerPressed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Select Connection"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="12,10,0,10"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseButton_Click"
                            Theme="{DynamicResource TitleBarCloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="12,10,12,12">
                <StackPanel Name="ConnectionsPanel">
                    <!-- Connection buttons added programmatically -->
                </StackPanel>
            </StackPanel>

        </Grid>
    </Border>
</Window>
