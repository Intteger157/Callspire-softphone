<Window x:Class="Softphone.Avalonia.CallWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        Title="Active Call"
        Height="750" Width="380"
        MinWidth="380" MinHeight="750"
        WindowDecorations="None"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"

        TransparencyLevelHint="None">

    <Grid>
        <Border Name="WindowSurface"
                Background="{DynamicResource BackgroundDarkBrush}"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BackgroundMediumBrush}"
                        CornerRadius="8,8,0,0">
                    <Grid PointerPressed="TitleBar_PointerPressed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Active Call"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="16,10"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Name="MinimizeButton"
                                    Content="─"
                                    Width="46"
                                    Height="32"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    BorderThickness="0"
                                    FontSize="16"
                                    VerticalAlignment="Stretch"
                                    Click="MinimizeButton_Click"
                                    Cursor="Hand"/>
                            <Button Name="CloseButton"
                                    Content="✕"
                                    Click="CloseButton_Click"
                                    Theme="{DynamicResource TitleBarCloseButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="24,24,24,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Phone Number / Caller Name -->
                    <TextBlock Grid.Row="0"
                               Name="CallerNameTextBlock"
                               Text="Unknown"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="28"
                               FontWeight="Light"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,16,0,8"/>

                    <!-- Call Status + Timer -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Name="CallStatusTextBlock"
                                   Text="Calling"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Name="CallTimerTextBlock"
                                   Text=""
                                   Foreground="{DynamicResource AccentGreenBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- DTMF Keypad (hidden by default, animated in/out in code-behind) -->
                    <Grid Grid.Row="2"
                          Name="KeypadGrid"
                          IsVisible="False"
                          Opacity="0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="1" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="2" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="3" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>

                        <Button Grid.Row="1" Grid.Column="0" Content="4" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="5" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="6" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>

                        <Button Grid.Row="2" Grid.Column="0" Content="7" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="2" Grid.Column="1" Content="8" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="9" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>

                        <Button Grid.Row="3" Grid.Column="0" Content="*" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="3" Grid.Column="1" Content="0" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="#" Theme="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    </Grid>

                    <!-- Call Control Buttons -->
                    <StackPanel Grid.Row="3"
                                Name="ControlButtonsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,16">

                        <Button Name="MuteButton"
                                Theme="{DynamicResource CallControlButton}"
                                ToolTip.Tip="Mute"
                                Click="MuteButton_Click"
                                Margin="8,0">
                            <Grid>
                                <ic:SymbolIcon Name="MuteIconOn"
                                               Symbol="Mic"
                                               Width="24" Height="24"
                                               IconVariant="Regular"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ic:SymbolIcon Name="MuteIconOff"
                                               Symbol="MicOff"
                                               Width="24" Height="24"
                                               IconVariant="Regular"
                                               IsVisible="False"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </Button>

                        <Button Name="HoldButton"
                                Theme="{DynamicResource CallControlButton}"
                                ToolTip.Tip="Hold"
                                Click="HoldButton_Click"
                                Margin="8,0">
                            <Grid>
                                <ic:SymbolIcon Name="HoldIconPause"
                                               Symbol="Pause"
                                               Width="24" Height="24"
                                               IconVariant="Regular"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ic:SymbolIcon Name="HoldIconPlay"
                                               Symbol="Play"
                                               Width="24" Height="24"
                                               IconVariant="Regular"
                                               IsVisible="False"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </Button>

                        <Button Name="SpeakerButton"
                                Theme="{DynamicResource CallControlButton}"
                                ToolTip.Tip="Speaker"
                                Click="SpeakerButton_Click"
                                Margin="8,0">
                            <ic:SymbolIcon Symbol="Speaker2"
                                           Width="24" Height="24"
                                           IconVariant="Regular"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>

                        <Button Name="KeypadToggleButton"
                                Theme="{DynamicResource CallControlButton}"
                                ToolTip.Tip="Toggle keypad"
                                Click="KeypadToggleButton_Click"
                                Margin="8,0">
                            <ic:SymbolIcon Symbol="Dialpad"
                                           Width="24" Height="24"
                                           IconVariant="Regular"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Hang Up Button (outgoing / active call) -->
                    <Button Grid.Row="4"
                            Name="HangupButton"
                            Theme="{DynamicResource EndCallButton}"
                            Click="HangupButton_Click"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,32">
                        <ic:SymbolIcon Symbol="CallEnd" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                    </Button>

                    <!-- Incoming Call Buttons -->
                    <StackPanel Grid.Row="4"
                                Name="IncomingCallButtonsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,32"
                                IsVisible="False">
                        <Button Name="AnswerButton"
                                Theme="{DynamicResource NumpadCallButtonStyle}"
                                Click="AnswerButton_Click"
                                Margin="0,0,28,0">
                            <ic:SymbolIcon Symbol="Call" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                        </Button>
                        <Button Name="RejectButton"
                                Theme="{DynamicResource EndCallButton}"
                                Click="RejectButton_Click"
                                Margin="28,0,0,0">
                            <ic:SymbolIcon Symbol="CallEnd" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                        </Button>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
