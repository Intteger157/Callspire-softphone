<Window x:Class="Softphone.Avalonia.CallWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vm="using:Softphone.AppHost.ViewModels"
        x:DataType="vm:CallViewModel"
        x:CompileBindings="True"
        Title="{Binding WindowTitle}"
        Height="640" Width="380"
        MinWidth="340" MinHeight="560"
        WindowDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="None">

    <Window.Styles>
        <Style Selector="TextBlock.callStatus">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.callStatus.good">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="TextBlock.callStatus.bad">
            <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}"/>
        </Style>
        <Style Selector="Button.controlActive">
            <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Name="WindowSurface"
                Background="{DynamicResource BackgroundDarkBrush}"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar (custom chrome; hidden on macOS/Linux) -->
                <Border Grid.Row="0" Name="CustomTitleBar"
                        Background="{DynamicResource BackgroundMediumBrush}"
                        CornerRadius="8,8,0,0">
                    <Grid PointerPressed="TitleBar_PointerPressed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding WindowTitle}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="16,10"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="─" Width="46" Height="32"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="16"
                                    VerticalAlignment="Stretch"
                                    Click="MinimizeButton_Click" Cursor="Hand"/>
                            <Button Content="✕" Click="CloseButton_Click"
                                    Theme="{StaticResource TitleBarCloseButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="24,24,24,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Phone number -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding CallerDisplay}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="28" FontWeight="Light"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,8,0,4"/>

                    <!-- Transport / line badge -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,0,0,12">
                        <Border Background="{DynamicResource AccentBlueBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding TransportLabel}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding ConnectionLabel}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AccentRedBrush}" CornerRadius="4" Padding="6,2"
                                IsVisible="{Binding IsRecordingIndicatorVisible}">
                            <TextBlock Text="REC" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Status + Timer -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Classes="callStatus"
                                   Classes.good="{Binding IsStatusGood}"
                                   Classes.bad="{Binding IsStatusBad}"
                                   Text="{Binding StatusText}"
                                   FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TimerText}"
                                   Foreground="{DynamicResource AccentGreenBrush}"
                                   FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- DTMF Keypad -->
                    <Grid Grid.Row="3"
                          IsVisible="{Binding IsKeypadVisible}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="1" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="2" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="3" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="4" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="5" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="6" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="2" Grid.Column="0" Content="7" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="2" Grid.Column="1" Content="8" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="9" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="3" Grid.Column="0" Content="*" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="3" Grid.Column="1" Content="0" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="#" Theme="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    </Grid>

                    <!-- Call Control Buttons -->
                    <StackPanel Grid.Row="4"
                                IsVisible="{Binding ShowControls}"
                                Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,16">

                        <Button Theme="{StaticResource CallControlButton}"
                                Classes.controlActive="{Binding IsMuted}"
                                ToolTip.Tip="Mute" Click="MuteButton_Click" Margin="8,0">
                            <Panel>
                                <ic:SymbolIcon Symbol="Mic" Width="24" Height="24" IconVariant="Regular"
                                               IsVisible="{Binding IsNotMuted}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ic:SymbolIcon Symbol="MicOff" Width="24" Height="24" IconVariant="Regular"
                                               IsVisible="{Binding IsMuted}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Panel>
                        </Button>

                        <Button Theme="{StaticResource CallControlButton}"
                                Classes.controlActive="{Binding IsOnHold}"
                                ToolTip.Tip="Hold" Click="HoldButton_Click" Margin="8,0">
                            <Panel>
                                <ic:SymbolIcon Symbol="Pause" Width="24" Height="24" IconVariant="Regular"
                                               IsVisible="{Binding IsNotOnHold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ic:SymbolIcon Symbol="Play" Width="24" Height="24" IconVariant="Regular"
                                               IsVisible="{Binding IsOnHold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Panel>
                        </Button>

                        <Button Theme="{StaticResource CallControlButton}"
                                Classes.controlActive="{Binding IsKeypadVisible}"
                                ToolTip.Tip="Toggle keypad" Click="KeypadToggleButton_Click" Margin="8,0">
                            <ic:SymbolIcon Symbol="Dialpad" Width="24" Height="24" IconVariant="Regular"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Hang Up -->
                    <Button Grid.Row="5"
                            IsVisible="{Binding ShowHangupButton}"
                            Theme="{StaticResource EndCallButton}"
                            Click="HangupButton_Click"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,8">
                        <ic:SymbolIcon Symbol="CallEnd" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                    </Button>

                    <!-- Incoming: Answer / Reject -->
                    <StackPanel Grid.Row="5"
                                IsVisible="{Binding ShowIncomingButtons}"
                                Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,8">
                        <Button Theme="{StaticResource NumpadCallButtonStyle}"
                                Click="AnswerButton_Click" Margin="0,0,28,0" ToolTip.Tip="Answer">
                            <ic:SymbolIcon Symbol="Call" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                        </Button>
                        <Button Theme="{StaticResource EndCallButton}"
                                Click="RejectButton_Click" Margin="28,0,0,0" ToolTip.Tip="Reject">
                            <ic:SymbolIcon Symbol="CallEnd" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
