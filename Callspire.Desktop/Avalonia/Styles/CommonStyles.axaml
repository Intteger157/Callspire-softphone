<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         TitleBarCloseButtonStyle — red on hover, like WPF version
         ========================================================= -->
    <ControlTheme x:Key="TitleBarCloseButtonStyle" TargetType="Button">
        <Setter Property="Width"            Value="46"/>
        <Setter Property="Height"           Value="32"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="0">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#bg">
            <Setter Property="Background" Value="#C42B1C"/>
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </ControlTheme>

    <!-- =========================================================
         SidebarButtonStyle — 64×64 icon buttons in the left rail
         ========================================================= -->
    <ControlTheme x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Width"           Value="64"/>
        <Setter Property="Height"         Value="64"/>
        <Setter Property="Margin"          Value="0,4,0,4"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#bg">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#bg">
            <Setter Property="Background" Value="#4C4C4F"/>
        </Style>
    </ControlTheme>

    <!-- =========================================================
         NumpadButtonStyle — round numpad keys (64×64)
         ========================================================= -->
    <ControlTheme x:Key="NumpadButtonStyle" TargetType="Button">
        <Setter Property="Width"           Value="64"/>
        <Setter Property="Height"          Value="64"/>
        <Setter Property="FontSize"        Value="22"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Background"      Value="{DynamicResource BackgroundLightBrush}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="32">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#bg">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#bg">
            <Setter Property="Background" Value="#4C4C4F"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#bg">
            <Setter Property="Background" Value="#4A4A4A"/>
        </Style>
    </ControlTheme>

    <!-- =========================================================
         NumpadCallButtonStyle — green call button (round, 56×56)
         ========================================================= -->
    <ControlTheme x:Key="NumpadCallButtonStyle" TargetType="Button">
        <Setter Property="Width"           Value="56"/>
        <Setter Property="Height"          Value="56"/>
        <Setter Property="Background"      Value="{DynamicResource AccentGreenBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="28">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#bg">
            <Setter Property="Background" Value="#1E8E3E"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#bg">
            <Setter Property="Background" Value="#178835"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#bg">
            <Setter Property="Background" Value="#556455"/>
        </Style>
    </ControlTheme>

    <!-- =========================================================
         CallControlButton — 60×60 round control buttons (mute/hold/etc.)
         ========================================================= -->
    <ControlTheme x:Key="CallControlButton" TargetType="Button">
        <Setter Property="Width"           Value="60"/>
        <Setter Property="Height"          Value="60"/>
        <Setter Property="Background"      Value="{DynamicResource BackgroundMediumBrush}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="30">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#bg">
            <Setter Property="Background" Value="#4C4C4F"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#bg">
            <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
        </Style>
    </ControlTheme>

    <!-- =========================================================
         EndCallButton — 72×72 red round button
         ========================================================= -->
    <ControlTheme x:Key="EndCallButton" TargetType="Button">
        <Setter Property="Width"           Value="72"/>
        <Setter Property="Height"          Value="72"/>
        <Setter Property="Background"      Value="{DynamicResource AccentRedBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="36">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#bg">
            <Setter Property="Background" Value="#A73340"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#bg">
            <Setter Property="Background" Value="#70222B"/>
        </Style>
    </ControlTheme>

    <!-- =========================================================
         ModernButtonStyle — general rounded button
         ========================================================= -->
    <ControlTheme x:Key="ModernButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource BackgroundMediumBrush}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="16,8"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#bg">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#bg">
            <Setter Property="Background" Value="#4C4C4F"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
    </ControlTheme>

    <!-- =========================================================
         BackspaceButtonStyle — small transparent icon button
         ========================================================= -->
    <ControlTheme x:Key="BackspaceButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#bg">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>
    </ControlTheme>

    <!-- =========================================================
         StatusRefreshButtonStyle — small circular refresh icon
         ========================================================= -->
    <ControlTheme x:Key="StatusRefreshButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#bg">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </ControlTheme>

    <!-- NOTE: Selector-based Styles cannot live in a ResourceDictionary.
         Per-element stats card typography is applied inline in MainWindow.axaml. -->

</ResourceDictionary>
