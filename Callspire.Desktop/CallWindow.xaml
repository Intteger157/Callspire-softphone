<Window x:Class="Softphone.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Active Call" Height="750" Width="380" MinWidth="380" MinHeight="750"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        KeyDown="CallWindow_KeyDown">
    <WindowChrome.WindowChrome>
        <!-- Как в SettingsWindow: без системного заголовка, но с корректной областью ресайза -->
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="8,8,8,8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <!-- Theme dictionaries are provided by App.xaml (System/Dark/Light). -->

            <!-- Анимация показа нумпада -->
            <Storyboard x:Key="ShowKeypadStoryboard">
                <DoubleAnimation Storyboard.TargetName="KeypadGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1"
                                 Duration="0:0:0.18" />
                <DoubleAnimation Storyboard.TargetName="KeypadTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="20" To="0"
                                 Duration="0:0:0.18" />
            </Storyboard>
            
            <!-- Анимация скрытия нумпада -->
            <Storyboard x:Key="HideKeypadStoryboard">
                <DoubleAnimation Storyboard.TargetName="KeypadGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0"
                                 Duration="0:0:0.18" />
                <DoubleAnimation Storyboard.TargetName="KeypadTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="0" To="20"
                                 Duration="0:0:0.18" />
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border x:Name="WindowSurface"
                Background="{DynamicResource BackgroundDarkBrush}"
                CornerRadius="8"
                ClipToBounds="False"
                Margin="0">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{DynamicResource BackgroundMediumBrush}" 
                    CornerRadius="8,8,0,0"
                    ClipToBounds="False"
                    Margin="0">
                <Grid MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Active Call" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontSize="16" 
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          Margin="16,10"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="MinimizeButton" Content="─" Width="46"
                            Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="0" FontSize="16" Click="MinimizeButton_Click"
                            VerticalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Name="CloseButton"
                            Content="✕"
                            Click="CloseButton_Click"
                            Style="{DynamicResource TitleBarCloseButtonStyle}"/>
                </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="24,24,24,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Phone Number -->
                <TextBlock Grid.Row="0" Name="CallerNameTextBlock"
                          Text="Unknown (555-0199)" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontSize="28"
                          FontWeight="Light"
                          HorizontalAlignment="Center"
                          TextWrapping="Wrap"
                          TextAlignment="Center"
                          Margin="0,16,0,8"/>

                <!-- Call Status + Timer -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                    <TextBlock Name="CallStatusTextBlock"
                              Text="Calling"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="16"
                              FontWeight="SemiBold"
                              HorizontalAlignment="Center"/>
                    <TextBlock Name="CallTimerTextBlock"
                              Text=""
                              Foreground="{DynamicResource AccentGreenBrush}"
                              FontSize="18"
                              FontWeight="SemiBold"
                              HorizontalAlignment="Center"
                              Margin="0,6,0,0"/>
                </StackPanel>

                <!-- DTMF Keypad (появляется в центре) -->
                <Grid Grid.Row="2"
                      x:Name="KeypadGrid"
                      Opacity="0"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="KeypadTranslate" Y="20"/>
                    </Grid.RenderTransform>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>

                    <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>

                    <Button Grid.Row="3" Grid.Column="0" Content="*" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="#" Style="{DynamicResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                </Grid>

                <!-- Кнопки управления вызовом (всегда внизу) -->
                <StackPanel Grid.Row="3"
                            Name="ControlButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,16">

                    <Button Name="MuteButton"
                            Style="{DynamicResource CallControlButton}"
                            ToolTip="Mute"
                            Click="MuteButton_Click"
                            Margin="8,0">
                        <Grid>
                            <ic:SymbolIcon x:Name="MuteIconOn"
                                           Symbol="Mic"
                                           Width="24" Height="24"
                                           IconVariant="Regular"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <ic:SymbolIcon x:Name="MuteIconOff"
                                           Symbol="MicOff"
                                           Width="24" Height="24"
                                           IconVariant="Regular"
                                           Visibility="Collapsed"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Button>

                    <Button Name="HoldButton"
                            Style="{DynamicResource CallControlButton}"
                            ToolTip="Hold"
                            Click="HoldButton_Click"
                            Margin="8,0">
                        <Grid>
                            <!-- Pause = put on hold, Play = resume -->
                            <ic:SymbolIcon x:Name="HoldIconPause"
                                           Symbol="Pause"
                                           Width="24" Height="24"
                                           IconVariant="Regular"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <ic:SymbolIcon x:Name="HoldIconPlay"
                                           Symbol="Play"
                                           Width="24" Height="24"
                                           IconVariant="Regular"
                                           Visibility="Collapsed"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Button>

                    <Button Name="SpeakerButton"
                            Style="{DynamicResource CallControlButton}"
                            ToolTip="Speaker"
                            Click="SpeakerButton_Click"
                            Margin="8,0">
                        <ic:SymbolIcon Symbol="Speaker2"
                                       Width="24" Height="24"
                                       IconVariant="Regular"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <Button Name="KeypadToggleButton"
                            Style="{DynamicResource CallControlButton}"
                            Click="KeypadToggleButton_Click"
                            ToolTip="Toggle keypad"
                            Margin="8,0">

                        <ic:SymbolIcon Symbol="Dialpad"
                                       Width="24"
                                       Height="24"
                                       IconVariant="Regular"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>

                    </Button>

                </StackPanel>

                <!-- Hang Up Button (всегда внизу) -->
                <Button Grid.Row="4" Name="HangupButton"
                        Style="{DynamicResource EndCallButton}"
                        Click="HangupButton_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,32">
                    <ic:SymbolIcon Symbol="CallEnd" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                </Button>

                <!-- Кнопки для входящего звонка -->
                <StackPanel Grid.Row="4" Name="IncomingCallButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,32"
                            Visibility="Collapsed">
                    <Button Name="AnswerButton"
                            Style="{DynamicResource NumpadCallButtonStyle}"
                            Click="AnswerButton_Click"
                            Margin="0,0,28,0">
                        <ic:SymbolIcon Symbol="Call" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                    </Button>
                    
                    <Button Name="RejectButton"
                            Style="{DynamicResource EndCallButton}"
                            Click="RejectButton_Click"
                            Margin="28,0,0,0">
                        <ic:SymbolIcon Symbol="CallEnd" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                    </Button>
                </StackPanel>
                
            </Grid>
            
            <!-- WebRTC Container (скрыт по умолчанию, поверх всего контента) -->
            <Grid x:Name="WebRtcContainer" 
                  Grid.Row="1" 
                  Visibility="Collapsed" 
                  Background="Transparent"
                  Margin="24,24,24,40">
                <wv2:WebView2 x:Name="WebRtcWebView" />
            </Grid>
            </Grid>
        </Border>

        <!-- Border stroke overlay (Win10); hidden on Win11 by NativeWindowAppearanceManager -->
        <Border x:Name="WindowStroke"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
    </Grid>
</Window>

