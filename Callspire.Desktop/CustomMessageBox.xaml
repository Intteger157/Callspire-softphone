<Window x:Class="Softphone.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Message" 
        SizeToContent="WidthAndHeight"
        MinWidth="400"
        MaxHeight="800"
        MaxWidth="900"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4752C4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A45C1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundMediumBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource DialogBackgroundBrush}" Margin="0">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border x:Name="WindowSurface"
                    Background="{DynamicResource DialogBackgroundBrush}" 
                    CornerRadius="8" 
                    ClipToBounds="False"
                    Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="TitleBarBorder"
                            Grid.Row="0"
                            Background="{DynamicResource DialogChromeBrush}" 
                            CornerRadius="8,8,0,0"
                            ClipToBounds="False">
                        <Grid MouseDown="TitleBar_MouseDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Name="TitleTextBlock"
                                       Text="Message" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       VerticalAlignment="Center"
                                       Margin="16,12,0,12"/>
                            
                            <Button Grid.Column="1"
                                    Name="CloseButton"
                                    Content="✕"
                                    Click="CloseButton_Click"
                                    Style="{DynamicResource TitleBarCloseButtonStyle}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="20,16,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <ic:SymbolIcon Grid.Column="0"
                                       Name="IconSymbol"
                                       Symbol="Info"
                                       Width="32"
                                       Height="32"
                                       IconVariant="Regular"
                                       Foreground="{DynamicResource AccentBlueBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,2,12,0"/>
                        
                        <TextBlock Name="MessageTextBlock"
                                   Grid.Column="1"
                                   Text="Message text" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   MaxWidth="380"/>
                    </Grid>

                    <Border Grid.Row="2" 
                            Background="{DynamicResource DialogChromeBrush}" 
                            CornerRadius="0,0,8,8" 
                            ClipToBounds="False"
                            Padding="0,0,0,1">
                        <Grid x:Name="ButtonsPanel" Margin="16,12,16,14">
                            <Button Name="OkButton"
                                    Content="OK"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"
                                    Click="OkButton_Click"
                                    HorizontalAlignment="Right"/>

                            <StackPanel x:Name="YesNoButtonsPanel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Visibility="Collapsed">
                                <Button x:Name="YesButton"
                                        Content="Yes"
                                        MinWidth="90"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource DialogPrimaryButtonStyle}"
                                        Click="YesButton_Click"/>
                                <Button x:Name="NoButton"
                                        Content="No"
                                        MinWidth="80"
                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                        Click="NoButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="WindowStroke"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    SnapsToDevicePixels="True"
                    IsHitTestVisible="False"
                    Visibility="Visible"/>
        </Grid>
    </Grid>
</Window>
