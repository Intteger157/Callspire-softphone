<Window x:Class="Softphone.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Update Available" Height="400" Width="550"
        WindowStyle="None" 
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border x:Name="WindowSurface"
                Background="{DynamicResource BackgroundDarkBrush}" 
                CornerRadius="8" 
                ClipToBounds="True">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{DynamicResource BackgroundMediumBrush}" 
                    CornerRadius="8,8,0,0"
                    ClipToBounds="False"
                    Margin="0">
                <Grid MouseDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,12,0,12">
                        <ic:SymbolIcon Symbol="ArrowDownload" Width="20" Height="20" IconVariant="Regular" 
                                       Foreground="{DynamicResource AccentBlueBrush}" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Update Available" 
                                  FontSize="16" FontWeight="SemiBold" 
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseButton_Click"
                            Style="{DynamicResource TitleBarCloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Content (wheel scroll, no visible scrollbars) -->
            <ScrollViewer Grid.Row="1"
                          Name="ContentScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Margin="24">
                <StackPanel>
                    <TextBlock Name="UpdateMessageTextBlock"
                              Text="A new version is available!"
                              FontSize="16"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,16"
                              TextWrapping="Wrap"/>
                    
                    <TextBlock Name="CurrentVersionTextBlock"
                              FontSize="13"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Margin="0,0,0,4"/>
                    
                    <TextBlock Name="LatestVersionTextBlock"
                              FontSize="13"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Margin="0,0,0,12"/>
                    
                    <!-- Admin Warning -->
                    <Border Background="#33F23F42"
                            CornerRadius="4"
                            Padding="12,8"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" 
                                      FontSize="16"
                                      Foreground="{DynamicResource AccentRedBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="Administrator rights may be required for update installation."
                                      FontSize="12"
                                      FontWeight="SemiBold"
                                      Foreground="White"
                                      TextWrapping="Wrap"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock Name="ReleaseNotesTextBlock"
                              Text="Release notes:"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,8"/>
                    
                    <Border Background="{DynamicResource BackgroundMediumBrush}"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="12">
                        <TextBlock Name="ReleaseNotesContentTextBlock"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Download progress (fixed area so it's always visible while downloading) -->
            <StackPanel Grid.Row="2" Name="DownloadProgressPanel" Visibility="Collapsed" Margin="24,0,24,12">
                <TextBlock Name="DownloadStatusTextBlock"
                          FontSize="12"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Margin="0,0,0,8"
                          TextWrapping="Wrap"/>
                <ProgressBar Name="DownloadProgressBar"
                             Height="10"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="{DynamicResource BackgroundMediumBrush}"
                             Foreground="{DynamicResource AccentBlueBrush}"/>
            </StackPanel>

            <!-- Buttons -->
            <Border Grid.Row="3" Background="{DynamicResource BackgroundMediumBrush}" 
                    CornerRadius="0,0,8,8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="1" Name="LaterButton"
                           Content="Update Later"
                           Background="{DynamicResource BackgroundDarkBrush}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           BorderThickness="0"
                           Padding="20,8"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Cursor="Hand"
                           Click="LaterButton_Click"
                           Margin="0,0,8,0"
                           Width="130">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Grid.Column="2" Name="UpdateButton"
                           Content="Update Now"
                           Background="{DynamicResource AccentBlueBrush}"
                           Foreground="White"
                           BorderThickness="0"
                           Padding="20,8"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Cursor="Hand"
                           Click="UpdateButton_Click"
                           Width="130">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4752C4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            </Grid>
        </Border>

        <Border x:Name="WindowStroke"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
    </Grid>
</Window>

