<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows WPF desktop. macOS is Callspire.Mac (SwiftUI) + Callspire.Service (sidecar). -->
		<TargetFramework>net8.0-windows10.0.17763</TargetFramework>
		<UseWPF>true</UseWPF>
		<OutputType>WinExe</OutputType>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<AssemblyName>Callspire</AssemblyName>
		<RootNamespace>Softphone</RootNamespace>
		<Configurations>Debug;Release;Callspire Softphone</Configurations>
	</PropertyGroup>

	<PropertyGroup>
		<IsWindowsBuild>true</IsWindowsBuild>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Callspire.Core\Callspire.Core.csproj" />
		<!-- DesktopAppController, ViewModels, AmoCrmService, PortAudio backend (shared with Callspire.Service) -->
		<ProjectReference Include="..\Callspire.AppHost\Callspire.AppHost.csproj" />
	</ItemGroup>

	<!-- ── Windows packages ─────────────────────────────────────────────── -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
		<PackageReference Include="FluentIcons.Wpf" Version="2.1.341" />
		<PackageReference Include="NAudio" Version="2.2.1" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Fonts\**\*" />
		<Resource Include="icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- WebView2 loads these from disk (virtual host). With PublishSingleFile they must stay outside the bundle. -->
		<Content Include="..\WebRtcClient\**\*" Link="WebRtcClient\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Incoming call ringtone audio files -->
		<Content Include="..\ringtone\**\*.wav" Link="ringtone\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Windows publish: Windows ffmpeg only -->
		<Content Include="..\tools\Windows\**\*" Link="tools\Windows\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Native AEC: must sit next to Callspire.exe (P/Invoke). PublishSingleFile does not bundle it. -->
		<Content Include="..\native-aec\build\Release\webrtc_apm.dll" Condition="Exists('..\native-aec\build\Release\webrtc_apm.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<Link>webrtc_apm.dll</Link>
		</Content>
	</ItemGroup>

	<!-- Production publish (Inno Setup): strip debug symbols and non-Windows tools -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(PublishDir)' != ''">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
	</PropertyGroup>

	<Target Name="ExcludePdbFromPublish" BeforeTargets="CopyFilesToPublishDirectory" Condition="'$(PublishDir)' != ''">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').EndsWith('.pdb'))" />
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.DestinationSubPath)').EndsWith('.pdb'))" />
		</ItemGroup>
	</Target>

	<Target Name="CleanupPublishDirForInnoSetup" AfterTargets="Publish" Condition="'$(PublishDir)' != '' And '$(IsWindowsBuild)' == 'true'">
		<Exec Command="powershell -NoProfile -NonInteractive -Command &quot;if (Test-Path -LiteralPath '$(PublishDir)') { Get-ChildItem -LiteralPath '$(PublishDir)' -Filter '*.pdb' -Recurse -File -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue }&quot;" />
		<RemoveDir Directories="$(PublishDir)tools\MacOS;$(PublishDir)tools\Linux" ContinueOnError="true" />
		<Delete Files="$(PublishDir)tools\README_FFMPEG.txt" TreatErrorsAsWarnings="true" />
	</Target>

</Project>
