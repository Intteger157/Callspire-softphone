<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
		  Dual-target build:
		    net8.0-windows10.0.17763  →  Windows: WPF + WinExe + WebView2 + NAudio WASAPI
		    net8.0                    →  macOS / Linux: Avalonia-only, PortAudio, SoftwareAec
		-->
		<TargetFrameworks>net8.0-windows10.0.17763;net8.0</TargetFrameworks>

		<!-- WPF only on the Windows TFM (generates entry point via App.xaml ApplicationDefinition) -->
		<UseWPF Condition="$(TargetFramework.StartsWith('net8.0-windows'))">true</UseWPF>

		<!-- WinExe on Windows suppresses the console window; Exe is fine on macOS/Linux -->
		<OutputType Condition="$(TargetFramework.StartsWith('net8.0-windows'))">WinExe</OutputType>
		<OutputType Condition="!$(TargetFramework.StartsWith('net8.0-windows'))">Exe</OutputType>

		<!-- Nullable and runtime identifier -->
		<Nullable>enable</Nullable>
		<!-- PortAudio callback code writes directly into native buffers -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>

		<ApplicationIcon Condition="$(TargetFramework.StartsWith('net8.0-windows'))">icon.ico</ApplicationIcon>

		<!-- Assembly / namespace identity -->
		<AssemblyName>Callspire</AssemblyName>
		<RootNamespace>Softphone</RootNamespace>

		<Configurations>Debug;Release;Callspire Softphone</Configurations>

		<!-- Application version: Directory.Build.props (AppVersion) -->

	</PropertyGroup>

	<!-- Convenience property for conditions below -->
	<PropertyGroup>
		<IsWindowsBuild Condition="$(TargetFramework.StartsWith('net8.0-windows'))">true</IsWindowsBuild>
		<IsWindowsBuild Condition="!$(TargetFramework.StartsWith('net8.0-windows'))">false</IsWindowsBuild>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Callspire.Core\Callspire.Core.csproj" />
	</ItemGroup>

	<!-- ── Windows-only packages ───────────────────────────────────────── -->
	<ItemGroup Condition="'$(IsWindowsBuild)' == 'true'">
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
		<!-- WPF icon library — needed only while WPF windows coexist (Phase 5 bridge) -->
		<PackageReference Include="FluentIcons.Wpf" Version="2.1.341" />
	</ItemGroup>

	<!-- ── Cross-platform packages (all TFMs) ─────────────────────────── -->
	<ItemGroup>
		<!-- NAudio: cross-platform WAV/PCM utilities; WASAPI classes guarded by #if WINDOWS -->
		<PackageReference Include="NAudio" Version="2.2.1" />
		<!-- PortAudio: macOS/Linux audio backend; also available on Windows as fallback.
		     PortAudioSharp2 bundles native libportaudio for osx-arm64/osx-x64/linux/win-x64. -->
		<PackageReference Include="PortAudioSharp2" Version="1.0.6" />
		<!-- Avalonia UI cross-platform shell -->
		<PackageReference Include="Avalonia" Version="12.0.4" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
		<!-- NativeWebView: WKWebView on macOS, WebView2 on Windows, WebKitGTK/WPE on Linux.
		     Hosts WebRtcClient/phone.js for the Avalonia shell (AvaloniaWebRtcEngineHost). -->
		<PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
		<!-- FluentIcons for Avalonia windows (all platforms).
		     Keep FluentIcons.Avalonia / .Resources.Avalonia / .Wpf on the same version:
		     they pin FluentIcons.Common exactly (2.1.328 pulled Resources 2.0.328). -->
		<PackageReference Include="FluentIcons.Avalonia" Version="2.1.341" />
		<PackageReference Include="FluentIcons.Resources.Avalonia" Version="2.1.341" />
	</ItemGroup>
	
	<!--
		App.axaml is a plain ResourceDictionary (no x:Class) used only at runtime.
		Marked as None so it is never passed to the WPF or Avalonia XAML compilers,
		but is still copied to output and loadable via AvaloniaXamlLoader.Load().
	-->
	<ItemGroup>
		<None Include="App.axaml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!--
		Avalonia Phase 5 window ports.
		Theme/style files are embedded as avares:// resources.
		Window AXAML files are compiled by the Avalonia XAML compiler (x:Class present).
		Using explicit build actions to avoid conflicts with UseWPF=true auto-globbing.
	-->
	<ItemGroup>
		<AvaloniaResource Include="Avalonia\Themes\DarkTheme.axaml" />
		<AvaloniaResource Include="Avalonia\Themes\LightTheme.axaml" />
		<AvaloniaResource Include="Avalonia\Styles\CommonStyles.axaml" />
		<AvaloniaResource Include="Avalonia\Styles\FormControls.axaml" />
		<!-- App icon for Avalonia windows (PNG — ICO is not reliably decoded on macOS) -->
		<AvaloniaResource Include="Assets\**\*.png" />
	</ItemGroup>

	<!--
		Avalonia XAML window files (Phase 5).  The Avalonia SDK auto-detects *.axaml
		files — no explicit <AvaloniaXaml Include> needed.
		
		UseWPF=true creates a _wpftmp.csproj (WPF XAML pre-compilation) that inherits
		ALL items.  Running the Avalonia XAML compiler inside the temp project causes
		AVLN2002; compiling Avalonia code-behind there causes CS0234 type errors.
		Both are blocked by removing the items inside the _wpftmp build:
	-->
	<ItemGroup Condition="$(MSBuildProjectFile.EndsWith('_wpftmp.csproj'))">
		<AvaloniaXaml Remove="Avalonia\**\*.axaml" />
		<Compile Remove="Avalonia\**\*.cs" />
		<!-- AvaloniaApp references Softphone.Avalonia.MainWindow, which is removed above -->
		<Compile Remove="App.axaml.cs" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Fonts\**\*" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- WebView2 loads these from disk (virtual host). With PublishSingleFile they must stay outside the bundle. -->
		<Content Include="..\WebRtcClient\**\*" Link="WebRtcClient\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Incoming call ringtone audio files -->
		<Content Include="..\ringtone\**\*.wav" Link="ringtone\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="'$(IsWindowsBuild)' == 'true'">
		<!-- Windows publish: Windows ffmpeg only -->
		<Content Include="..\tools\Windows\**\*" Link="tools\Windows\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="'$(IsWindowsBuild)' != 'true'">
		<!-- macOS / Linux: platform ffmpeg folders -->
		<Content Include="..\tools\MacOS\**\*" Link="tools\MacOS\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
		<Content Include="..\tools\Linux\**\*" Link="tools\Linux\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Native AEC: must sit next to Callspire.exe (P/Invoke). PublishSingleFile does not bundle it. -->
		<Content Include="..\native-aec\build\Release\webrtc_apm.dll" Condition="Exists('..\native-aec\build\Release\webrtc_apm.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<Link>webrtc_apm.dll</Link>
		</Content>
	</ItemGroup>

	<!-- Production publish (Inno Setup): strip debug symbols and non-Windows tools -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(PublishDir)' != ''">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
	</PropertyGroup>

	<Target Name="ExcludePdbFromPublish" BeforeTargets="CopyFilesToPublishDirectory" Condition="'$(PublishDir)' != ''">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').EndsWith('.pdb'))" />
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.DestinationSubPath)').EndsWith('.pdb'))" />
		</ItemGroup>
	</Target>

	<Target Name="CleanupPublishDirForInnoSetup" AfterTargets="Publish" Condition="'$(PublishDir)' != '' And '$(IsWindowsBuild)' == 'true'">
		<Exec Command="powershell -NoProfile -NonInteractive -Command &quot;if (Test-Path -LiteralPath '$(PublishDir)') { Get-ChildItem -LiteralPath '$(PublishDir)' -Filter '*.pdb' -Recurse -File -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue }&quot;" />
		<RemoveDir Directories="$(PublishDir)tools\MacOS;$(PublishDir)tools\Linux" ContinueOnError="true" />
		<Delete Files="$(PublishDir)tools\README_FFMPEG.txt" TreatErrorsAsWarnings="true" />
	</Target>

</Project>
