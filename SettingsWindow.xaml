<Window x:Class="Softphone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Settings" Height="550" Width="750"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    
    <Border Background="{StaticResource BackgroundDarkBrush}" 
            CornerRadius="8" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" 
                    CornerRadius="8,8,0,0" ClipToBounds="True">
                <Grid MouseDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Softphone Settings" 
                              FontSize="16" FontWeight="SemiBold" 
                              Foreground="{StaticResource TextSecondaryBrush}"
                              Margin="16,12,0,12" 
                              VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Width="46" Height="36" 
                           Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                           BorderThickness="0" Click="CloseButton_Click"
                           FontSize="16" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/> 
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource BackgroundMediumBrush}" 
                       BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                       CornerRadius="0,0,8,8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="10,16,10,0">
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}" 
                                   Click="ConnectionButton_Click" 
                                   Name="ConnectionButton">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="PlugConnected" Width="16" Height="16" IconVariant="Regular" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Connection" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}" 
                                   Click="AudioButton_Click" 
                                   Name="AudioButton">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Audio" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}" 
                                   Click="GeneralButton_Click" 
                                   Name="GeneralButton">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Settings" Width="16" Height="16" IconVariant="Regular" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="General" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}" 
                                   Click="AdvancedButton_Click" 
                                   Name="AdvancedButton">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Code" Width="16" Height="16" IconVariant="Regular" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Advanced" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}" 
                                   Click="AboutButton_Click" 
                                   Name="AboutButton">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Info" Width="16" Height="16" IconVariant="Regular" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="About" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Row="1" Content="Close" 
                               Style="{StaticResource SettingsSidebarButtonStyle}" 
                               Click="CloseButton_Click" 
                               Margin="10,0,10,10"
                               Foreground="{StaticResource AccentRedBrush}"/>
                    </Grid>
                </Border>

                <!-- Content Area (wheel scroll, no visible scrollbars) -->
                <ScrollViewer Grid.Column="1"
                              Background="{StaticResource BackgroundDarkBrush}"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                <Grid Background="{StaticResource BackgroundDarkBrush}">
                    <!-- About View -->
                    <Grid Name="AboutSettingsView" Visibility="Collapsed" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="About" 
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <Border Grid.Row="1"
                                Background="{StaticResource BackgroundMediumBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Padding="16"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="10"
                                        Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Top">
                                    <Image Width="32"
                                           Height="32"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="pack://application:,,,/icon.ico"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="Callspire Softphone" 
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Name="VersionTextBlock"
                                               Text="Version: 1.0.0"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <TextBlock Grid.Row="2" 
                                  Text="A modern softphone application for Windows."
                                  FontSize="13"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,30"/>
                        
                        <!-- Automatic Update Checker Section -->
                        <Expander Grid.Row="3" 
                                 Header="Updates"
                                 FontSize="16" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsExpanded="True"
                                 Margin="0,0,0,20">
                            <Grid Margin="20,10,20,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- GitHub Repository Link -->
                                <TextBlock Grid.Row="0"
                                           Text="GitHub repository URL:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13"
                                           Margin="0,0,0,6"/>
                                <TextBox Grid.Row="1"
                                         Name="GitHubRepositoryLinkTextBox"
                                         Background="{StaticResource BackgroundMediumBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         Padding="8,6"
                                         FontSize="13"
                                         Height="32"
                                         MinWidth="240"
                                         HorizontalAlignment="Stretch"
                                         MaxWidth="420"
                                         TextAlignment="Left"
                                         HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Center"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         TextChanged="GitHubRepositoryLinkTextBox_TextChanged"/>
                                <TextBlock Grid.Row="2"
                                           Text="Example: https://github.com/username/repository"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,14"
                                           TextWrapping="Wrap"
                                           Opacity="0.7"/>

                                <!-- GitHub Token -->
                                <TextBlock Grid.Row="3"
                                           Text="GitHub Personal Access Token (for private repositories):"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13"
                                           Margin="0,0,0,6"/>
                                <PasswordBox Grid.Row="4"
                                             Name="GitHubTokenPasswordBox"
                                             Background="{StaticResource BackgroundMediumBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             Padding="8,6"
                                             FontSize="13"
                                             Height="32"
                                             MinWidth="240"
                                             HorizontalAlignment="Stretch"
                                             MaxWidth="420"
                                             HorizontalContentAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             PasswordChanged="GitHubTokenPasswordBox_PasswordChanged"/>
                                <TextBlock Grid.Row="5"
                                           Text="The token will be encrypted and stored locally. Only needed for private repositories."
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,14"
                                           TextWrapping="Wrap"
                                           Opacity="0.7"/>

                                <!-- Actions -->
                                <WrapPanel Grid.Row="6" Margin="0,6,0,0">
                                    <Button Name="SaveUpdateSettingsButton"
                                            Content="Save"
                                            Background="{StaticResource AccentGreenBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="16,8"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="SaveUpdateSettingsButton_Click"
                                            Width="120"
                                            Height="36"
                                            Visibility="Visible">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    SnapsToDevicePixels="True">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#2E7D32"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Background" Value="#4A4A4A"/>
                                                                    <Setter Property="Foreground" Value="#6A6A6A"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Name="CheckForUpdatesButton"
                                            Content="Check for Updates"
                                            Background="{StaticResource AccentBlueBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="16,8"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="CheckForUpdatesButton_Click"
                                            Margin="10,0,0,0"
                                            Width="150"
                                            Height="36"
                                            Visibility="Collapsed">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    SnapsToDevicePixels="True">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#4752C4"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Background" Value="#4A4A4A"/>
                                                                    <Setter Property="Foreground" Value="#6A6A6A"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                </Expander>
            </Grid>
            
            <!-- Connection Settings View -->
                    <Grid Name="ConnectionSettingsView" Visibility="Visible" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Connection Settings" 
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,16"/>
                        
                        <TextBlock Grid.Row="1" Text="These credentials are used for both SIP and WebRTC connections. You can disable WebRTC in Advanced settings." 
                                  FontSize="12" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,16"
                                  TextWrapping="Wrap"/>

                        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,20">
                            <TextBlock Text="Server &amp; Port:" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="13"
                                      Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Name="SipServerTextBox" 
                                        Background="{StaticResource BackgroundMediumBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="8,6" 
                                        FontSize="13"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        HorizontalContentAlignment="Left"
                                        IsReadOnly="False"
                                        IsEnabled="True"
                                        Focusable="True"
                                        TextWrapping="NoWrap"
                                        AcceptsReturn="False"/>
                                <TextBox Grid.Column="1" Name="SipPortTextBox" 
                                        Background="{StaticResource BackgroundMediumBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="8,6" 
                                        FontSize="13"
                                        Height="32"
                                        Width="80"
                                        Text="5060"
                                        HorizontalContentAlignment="Left"
                                        IsReadOnly="False"
                                        IsEnabled="True"
                                        Focusable="True"
                                        TextWrapping="NoWrap"
                                        AcceptsReturn="False"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,20">
                            <TextBlock Text="Username:" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="13"
                                      Margin="0,0,0,8"/>
                            <TextBox Name="SipUsernameTextBox" 
                                    Background="{StaticResource BackgroundMediumBrush}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="8,6" 
                                    FontSize="13"
                                    MinWidth="400"
                                    HorizontalContentAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,0,0,20">
                            <TextBlock Text="Password:" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="13"
                                      Margin="0,0,0,8"/>
                            <PasswordBox Name="SipPasswordBox" 
                                        Background="{StaticResource BackgroundMediumBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="8,6" 
                                        FontSize="13"
                                        MinWidth="400"/>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Name="ConnectionStatusTextBlock" 
                                  Text="Status: Not connected" 
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  FontSize="13"
                                  FontWeight="Medium"
                                  Margin="0,0,0,16"
                                  HorizontalAlignment="Left"/>

                        <Button Grid.Row="6" Content="Save and Connect" 
                               Name="SaveAndConnectButton"
                               Background="{StaticResource AccentBlueBrush}"
                               Foreground="White"
                               BorderThickness="0"
                               Padding="16,8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               Click="SaveConnectionSettings_Click"
                               HorizontalAlignment="Left"
                               Width="150" Height="36">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4752C4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#4A4A4A"/>
                                                        <Setter Property="Foreground" Value="#6A6A6A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Audio Settings View -->
                    <Grid Name="AudioSettingsView" Visibility="Collapsed" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Audio Settings" 
                                  FontSize="20" FontWeight="Light" 
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,16"/>

                        <TextBlock Grid.Row="1" Text="Microphone Device:" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="13"
                                  Margin="0,0,0,4"/>

                        <ComboBox Grid.Row="2" Name="MicrophoneComboBox"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 Margin="0,0,0,12"
                                 DisplayMemberPath="Name"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="{StaticResource BackgroundMediumBrush}"
                                 SelectionChanged="MicrophoneComboBox_SelectionChanged"/>

                        <TextBlock Grid.Row="3" Text="Speaker Device:" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="13"
                                  Margin="0,0,0,4"/>

                        <ComboBox Grid.Row="4" Name="SpeakerComboBox"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 Margin="0,0,0,12"
                                 DisplayMemberPath="Name"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="{StaticResource BackgroundMediumBrush}"
                                 SelectionChanged="SpeakerComboBox_SelectionChanged"/>

                        <TextBlock Grid.Row="5" Text="Audio Codec:" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="13"
                                  Margin="0,0,0,4"/>

                        <ComboBox Grid.Row="6" Name="AudioCodecComboBox"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 Margin="0,0,0,12"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="{StaticResource BackgroundMediumBrush}"
                                 SelectionChanged="AudioCodecComboBox_SelectionChanged">
                            <ComboBoxItem Content="G.711 μ-law (PCMU) - Standard" Tag="PCMU" IsSelected="True"/>
                            <ComboBoxItem Content="G.711 A-law (PCMA) - Standard" Tag="PCMA"/>
                            <ComboBoxItem Content="G.722 - High Quality" Tag="G722"/>
                            <ComboBoxItem Content="Opus - Best Quality" Tag="opus"/>
                        </ComboBox>

                        <TextBlock Grid.Row="7" Text="Sample Rate:" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="13"
                                  Margin="0,0,0,4"/>

                        <ComboBox Grid.Row="8" Name="SampleRateComboBox"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 Margin="0,0,0,16"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="{StaticResource BackgroundMediumBrush}"
                                 SelectionChanged="SampleRateComboBox_SelectionChanged">
                            <ComboBoxItem Content="8000 Hz (Standard)" Tag="8000"/>
                            <ComboBoxItem Content="16000 Hz (High Quality)" Tag="16000" IsSelected="True"/>
                        </ComboBox>

                        <Button Grid.Row="9" Content="Save Audio Settings" 
                               Name="SaveAudioSettingsButton"
                               Background="{StaticResource AccentBlueBrush}"
                               Foreground="White"
                               BorderThickness="0"
                               Padding="24,10"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               Click="SaveAudioSettingsButton_Click"
                               HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4752C4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#4A4A4A"/>
                                                        <Setter Property="Foreground" Value="#6A6A6A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- General Settings View -->
                    <Grid Name="GeneralSettingsView" Visibility="Collapsed" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="General Settings" 
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <!-- Call Recording -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Name="EnableCallRecordingCheckBox" 
                                     Style="{StaticResource ToggleSwitchStyle}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0"
                                     Checked="EnableCallRecordingCheckBox_Checked"
                                     Unchecked="EnableCallRecordingCheckBox_Unchecked"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Call Recording" 
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          FontSize="14"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="Record WebRTC calls automatically" 
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          FontSize="12"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="Recording is available in WebRTC mode only." 
                                          Foreground="{StaticResource AccentBlueBrush}"
                                          FontSize="11"
                                          TextWrapping="Wrap"
                                          Opacity="0.85"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Open Recordings Button -->
                        <Button Grid.Row="2" Name="OpenRecordingsButton"
                               Content="Open Recordings Folder" 
                               Background="{StaticResource AccentBlueBrush}"
                               Foreground="White"
                               BorderThickness="0"
                               Padding="16,8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               Click="OpenRecordingsButton_Click"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,20">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4752C4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Advanced Settings View -->
                    <Grid Name="AdvancedSettingsView" Visibility="Collapsed" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- WebRTC Settings -->
                        <TextBlock Grid.Row="0" Text="WebRTC Audio Settings" 
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Name="UseWebRtcCheckBox" 
                                     Style="{StaticResource ToggleSwitchStyle}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" 
                                      Text="Use WebRTC for audio"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      VerticalAlignment="Center"
                                      FontSize="14"/>
                        </Grid>
                        
                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Name="WebRtcStatusTextBlock"
                                      Text="WebRTC Status: Not configured"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="13"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"/>
                            <Button Grid.Column="2" Name="TestWebRtcConnectionButton"
                                   Content="Test Connection"
                                   Background="{StaticResource AccentBlueBrush}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Padding="12,6"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Cursor="Hand"
                                   Click="TestWebRtcConnectionButton_Click"
                                   IsEnabled="False">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#4752C4"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#4A4A4A"/>
                                                            <Setter Property="Foreground" Value="#6A6A6A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        
                        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,20">
                            <TextBlock Text="WebSocket URI:" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="13"
                                      Margin="0,0,0,8"/>
                            <TextBox Name="WebRtcWsUriTextBox" 
                                    Background="{StaticResource BackgroundMediumBrush}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="8,6" 
                                    FontSize="13"
                                    MinWidth="400"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Row="4" 
                                  Text="Make sure your PBX supports WebSocket connections." 
                                  FontSize="12" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,20"/>
                        
                        <Button Grid.Row="5" Name="SaveGeneralSettingsButton"
                               Content="Save Settings"
                               Background="{StaticResource AccentBlueBrush}"
                               Foreground="White"
                               BorderThickness="0"
                               Padding="16,8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               Click="SaveGeneralSettingsButton_Click"
                               HorizontalAlignment="Left"
                               Width="150" Height="36">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4752C4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#4A4A4A"/>
                                                        <Setter Property="Foreground" Value="#6A6A6A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Grid>
            
            <!-- Hidden WebView2 for WebRTC testing (always in the visual tree) -->
            <!-- Use Hidden instead of Collapsed so it still participates in layout -->
            <wv2:WebView2 x:Name="WebRtcStatusWebView" 
                         Visibility="Hidden" 
                         Width="1" 
                         Height="1"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"/>
        </Grid>
    </Border>
</Window>

