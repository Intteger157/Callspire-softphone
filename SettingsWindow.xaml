<Window x:Class="Softphone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="550" Width="750"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    
    <Border Background="{StaticResource BackgroundDarkBrush}" 
            CornerRadius="8" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Softphone Settings" 
                          FontSize="16" FontWeight="SemiBold" 
                          Margin="16,12,0,12" 
                          VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="46" Height="36" 
                       Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                       BorderThickness="0" Click="CloseButton_Click"
                       FontSize="16" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/> 
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource BackgroundMediumBrush}" 
                       BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="10,16,10,0">
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}" 
                                   Click="ConnectionButton_Click" 
                                   Name="ConnectionButton"
                                   Foreground="{StaticResource AccentBlueBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE717;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Connection" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}" 
                                   Click="AudioButton_Click" 
                                   Name="AudioButton">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE94F;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Audio" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource SettingsSidebarButtonStyle}" 
                                   Click="GeneralButton_Click" 
                                   Name="GeneralButton">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="General" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Row="1" Content="Close" 
                               Style="{StaticResource SettingsSidebarButtonStyle}" 
                               Click="CloseButton_Click" 
                               Margin="10,0,10,10"
                               Foreground="{StaticResource AccentRedBrush}"/>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Column="1" Background="{StaticResource BackgroundDarkBrush}">
                    <!-- Connection Settings View -->
                    <Grid Name="ConnectionSettingsView" Visibility="Visible" Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Connection (SIP) Settings" 
                                  FontSize="24" FontWeight="Light" 
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,32"/>

                        <TextBlock Grid.Row="1" Text="SIP Server &amp; Port:" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,8"/>

                        <Grid Grid.Row="2" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Name="SipServerTextBox" 
                                    Style="{StaticResource ModernTextBoxStyle}" 
                                    Margin="0,0,16,0"
                                    Text="sip.example.com"/>
                            <TextBox Grid.Column="1" Name="SipPortTextBox" 
                                    Style="{StaticResource ModernTextBoxStyle}" 
                                    Text="5060"
                                    HorizontalContentAlignment="Center"/>
                        </Grid>

                        <TextBlock Grid.Row="3" Text="SIP Username:" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,8"/>

                        <TextBox Grid.Row="4" Name="SipUsernameTextBox" 
                                Style="{StaticResource ModernTextBoxStyle}" 
                                Margin="0,0,0,24"/>

                        <TextBlock Grid.Row="5" Text="SIP Password:" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,8"/>

                        <PasswordBox Grid.Row="6" Name="SipPasswordBox" 
                                    Style="{StaticResource ModernPasswordBoxStyle}" 
                                    Margin="0,0,0,32"/>

                        <Button Grid.Row="7" Content="Save and Connect" 
                               Name="SaveAndConnectButton"
                               Background="{StaticResource AccentBlueBrush}"
                               Foreground="White"
                               BorderThickness="0"
                               Padding="30,12"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               Click="SaveConnectionSettings_Click"
                               HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4752C4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#4A4A4A"/>
                                                        <Setter Property="Foreground" Value="#6A6A6A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <TextBlock Grid.Row="8" Name="ConnectionStatusTextBlock" 
                                  Text="Status: Not connected" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"
                                  Margin="0,16,0,0"
                                  HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Audio Settings View -->
                    <Grid Name="AudioSettingsView" Visibility="Collapsed" Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Audio Settings" 
                                  FontSize="24" FontWeight="Light" 
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,32"/>

                        <TextBlock Grid.Row="1" Text="Microphone Device:" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,8"/>

                        <ComboBox Grid.Row="2" Name="MicrophoneComboBox"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 Margin="0,0,0,24"
                                 DisplayMemberPath="Name"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="{StaticResource BackgroundMediumBrush}"
                                 SelectionChanged="MicrophoneComboBox_SelectionChanged"/>

                        <TextBlock Grid.Row="3" Text="Speaker Device:" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,8"/>

                        <ComboBox Grid.Row="4" Name="SpeakerComboBox"
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 Margin="0,0,0,32"
                                 DisplayMemberPath="Name"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="{StaticResource BackgroundMediumBrush}"
                                 SelectionChanged="SpeakerComboBox_SelectionChanged"/>

                        <Button Grid.Row="5" Content="Save Audio Settings" 
                               Name="SaveAudioSettingsButton"
                               Background="{StaticResource AccentBlueBrush}"
                               Foreground="White"
                               BorderThickness="0"
                               Padding="30,12"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               Click="SaveAudioSettingsButton_Click"
                               HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4752C4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#4A4A4A"/>
                                                        <Setter Property="Foreground" Value="#6A6A6A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- General Settings View -->
                    <Grid Name="GeneralSettingsView" Visibility="Collapsed" Margin="40">
                        <TextBlock Text="General settings — coming soon" 
                                  FontSize="18" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

