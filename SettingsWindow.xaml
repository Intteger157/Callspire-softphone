<Window x:Class="Softphone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:Softphone"
        Title="Settings" Height="680" Width="980"
        MinHeight="620" MinWidth="900"
        WindowStyle="None" 
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <local:ThemeIconConverter x:Key="ThemeIconConverter"/>
        <local:ThemeDescriptionConverter x:Key="ThemeDescriptionConverter"/>
    </Window.Resources>
    
    <!-- Surface (clipped) + Stroke overlay (does not affect layout), so corners stay rounded and close button can sit flush -->
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border x:Name="WindowSurface"
                Background="{DynamicResource BackgroundDarkBrush}"
                CornerRadius="16"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{DynamicResource BackgroundMediumBrush}" 
                    CornerRadius="16,16,0,0"
                    ClipToBounds="True">
                <Grid MouseDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Softphone Settings" 
                              FontSize="16" FontWeight="SemiBold" 
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Margin="16,12,0,12" 
                              VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="CloseButton_Click"
                            Style="{DynamicResource TitleBarCloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/> 
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border x:Name="SidebarBorder"
                       Grid.Column="0" Background="{DynamicResource BackgroundMediumBrush}" 
                       BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                       CornerRadius="0,0,0,16" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="10,16,10,0">
                            <Button Style="{DynamicResource SettingsSidebarButtonStyle}" 
                                   Click="ConnectionButton_Click" 
                                   Name="ConnectionButton">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="PlugConnected"
                                                   Width="16" Height="16"
                                                   IconVariant="Regular"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Connection" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{DynamicResource SettingsSidebarButtonStyle}" 
                                   Click="AudioButton_Click" 
                                   Name="AudioButton">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Speaker2"
                                                   Width="16" Height="16"
                                                   IconVariant="Regular"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Audio" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{DynamicResource SettingsSidebarButtonStyle}" 
                                   Click="GeneralButton_Click" 
                                   Name="GeneralButton">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Settings"
                                                   Width="16" Height="16"
                                                   IconVariant="Regular"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="General" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{DynamicResource SettingsSidebarButtonStyle}" 
                                   Click="AppearanceButton_Click" 
                                   Name="AppearanceButton">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Color"
                                                   Width="16" Height="16"
                                                   IconVariant="Regular"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Appearance" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{DynamicResource SettingsSidebarButtonStyle}" 
                                   Click="AdvancedButton_Click" 
                                   Name="AdvancedButton">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Code"
                                                   Width="16" Height="16"
                                                   IconVariant="Regular"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Advanced" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{DynamicResource SettingsSidebarButtonStyle}" 
                                   Click="IntegrationsButton_Click" 
                                   Name="IntegrationsButton">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Link"
                                                   Width="16" Height="16"
                                                   IconVariant="Regular"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Integrations" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{DynamicResource SettingsSidebarButtonStyle}" 
                                   Click="AboutButton_Click" 
                                   Name="AboutButton">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Info"
                                                   Width="16" Height="16"
                                                   IconVariant="Regular"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="About" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Row="1" Content="Close" 
                               Style="{DynamicResource SettingsSidebarButtonStyle}" 
                               Click="CloseButton_Click" 
                               Margin="10,0,10,10"
                               Foreground="{DynamicResource AccentRedBrush}"/>
                    </Grid>
                </Border>

                <!-- Content Area (wheel scroll, no visible scrollbars) -->
                <ScrollViewer Grid.Column="1"
                              Background="{DynamicResource BackgroundDarkBrush}"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                <Grid Background="{DynamicResource BackgroundDarkBrush}">
                    <!-- About View -->
                    <Grid Name="AboutSettingsView" Visibility="Collapsed" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="About" 
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <Border Grid.Row="1"
                                Background="{DynamicResource BackgroundMediumBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="16"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="10"
                                        Background="{DynamicResource BackgroundDarkBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Top">
                                    <Image Width="32"
                                           Height="32"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="pack://application:,,,/icon.ico"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="Callspire Softphone" 
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Name="VersionTextBlock"
                                               Text="Version: 1.0.0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <TextBlock Grid.Row="2" 
                                  Text="A modern softphone application for Windows."
                                  FontSize="13"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,24"/>
                        
                        <!-- Updates Section -->
                        <Border Grid.Row="3"
                                Background="{DynamicResource BackgroundMediumBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ic:SymbolIcon Symbol="ArrowDownload"
                                                   Width="20" Height="20"
                                                   IconVariant="Regular"
                                                   Foreground="{DynamicResource AccentBlueBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                    <TextBlock Text="Updates"
                                              FontSize="16"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <TextBlock Text="Updates are checked automatically once per day when the application starts."
                                          FontSize="13"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,16"
                                          LineHeight="20"/>
                                
                                <Button Name="CheckForUpdatesButton"
                                        Content="Check for Updates"
                                        Background="{DynamicResource AccentBlueBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="20,10"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="CheckForUpdatesButton_Click"
                                        HorizontalAlignment="Left"
                                        MinWidth="160"
                                        Height="38">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6"
                                                                SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#4752C4"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Background" Value="#4A4A4A"/>
                                                                <Setter Property="Foreground" Value="#6A6A6A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
            </Grid>
            
            <!-- Connection Settings View -->
                    <Grid Name="ConnectionSettingsView" Visibility="Visible" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Connection Settings" 
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,16"/>
                        
                        <TextBlock Grid.Row="1" Text="These credentials are used for both SIP and WebRTC connections. You can disable WebRTC in Advanced settings." 
                                  FontSize="12" 
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Margin="0,0,0,16"
                                  TextWrapping="Wrap"/>

                        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,20">
                            <TextBlock Text="Server &amp; Port:" 
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      FontSize="13"
                                      Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Name="SipServerTextBox" 
                                        Background="{DynamicResource BackgroundMediumBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="8,6" 
                                        FontSize="13"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        HorizontalContentAlignment="Left"
                                        IsReadOnly="False"
                                        IsEnabled="True"
                                        Focusable="True"
                                        TextWrapping="NoWrap"
                                        AcceptsReturn="False"/>
                                <TextBox Grid.Column="1" Name="SipPortTextBox" 
                                        Background="{DynamicResource BackgroundMediumBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="8,6" 
                                        FontSize="13"
                                        Height="32"
                                        Width="80"
                                        Text="5060"
                                        HorizontalContentAlignment="Left"
                                        IsReadOnly="False"
                                        IsEnabled="True"
                                        Focusable="True"
                                        TextWrapping="NoWrap"
                                        AcceptsReturn="False"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,20">
                            <TextBlock Text="Username:" 
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      FontSize="13"
                                      Margin="0,0,0,8"/>
                            <TextBox Name="SipUsernameTextBox" 
                                    Background="{DynamicResource BackgroundMediumBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="8,6" 
                                    FontSize="13"
                                    MinWidth="400"
                                    HorizontalContentAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,0,0,20">
                            <TextBlock Text="Password:" 
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      FontSize="13"
                                      Margin="0,0,0,8"/>
                            <PasswordBox Name="SipPasswordBox" 
                                        Background="{DynamicResource BackgroundMediumBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="8,6" 
                                        FontSize="13"
                                        MinWidth="400"/>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Name="ConnectionStatusTextBlock" 
                                  Text="Status: Not connected" 
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  FontSize="13"
                                  FontWeight="Medium"
                                  Margin="0,0,0,16"
                                  HorizontalAlignment="Left"/>

                        <Button Grid.Row="6" Content="Save and Connect" 
                               Name="SaveAndConnectButton"
                               Background="{DynamicResource AccentBlueBrush}"
                               Foreground="White"
                               BorderThickness="0"
                               Padding="16,8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               Click="SaveConnectionSettings_Click"
                               HorizontalAlignment="Left"
                               Width="150" Height="36">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4752C4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#4A4A4A"/>
                                                        <Setter Property="Foreground" Value="#6A6A6A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Audio Settings View -->
                    <Grid Name="AudioSettingsView" Visibility="Collapsed" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Audio Settings"
                                  FontSize="20"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,16"/>

                        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,0">
                            <!-- Devices card -->
                            <Border Background="{DynamicResource BackgroundMediumBrush}"
                                    CornerRadius="12"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="18,14"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Devices"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              Margin="0,0,0,10"/>

                                    <!-- Microphone -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                            <TextBlock Text="Microphone"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,2"/>
                                            <TextBlock Text="Microphone device"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                 Name="MicrophoneComboBox"
                                                 Style="{DynamicResource ModernComboBoxStyle}"
                                                 MinWidth="320"
                                                 VerticalAlignment="Center"
                                                 DisplayMemberPath="Name"
                                                 SelectionChanged="MicrophoneComboBox_SelectionChanged"/>
                                    </Grid>

                                    <!-- Speaker -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                            <TextBlock Text="Speaker"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,2"/>
                                            <TextBlock Text="Speaker device"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                 Name="SpeakerComboBox"
                                                 Style="{DynamicResource ModernComboBoxStyle}"
                                                 MinWidth="320"
                                                 VerticalAlignment="Center"
                                                 DisplayMemberPath="Name"
                                                 SelectionChanged="SpeakerComboBox_SelectionChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Codec card -->
                            <Border Background="{DynamicResource BackgroundMediumBrush}"
                                    CornerRadius="12"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="18,14"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Codec"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              Margin="0,0,0,10"/>

                                    <!-- Audio codec -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                            <TextBlock Text="Audio codec"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,2"/>
                                            <TextBlock Text="Preferred codec for calls"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                 Name="AudioCodecComboBox"
                                                 Style="{DynamicResource ModernComboBoxStyle}"
                                                 MinWidth="320"
                                                 VerticalAlignment="Center"
                                                 SelectionChanged="AudioCodecComboBox_SelectionChanged">
                                            <ComboBoxItem Content="G.711 μ-law (PCMU) - Standard" Tag="PCMU" IsSelected="True"/>
                                            <ComboBoxItem Content="G.711 A-law (PCMA) - Standard" Tag="PCMA"/>
                                            <ComboBoxItem Content="G.722 - High Quality" Tag="G722"/>
                                            <ComboBoxItem Content="Opus - Best Quality" Tag="opus"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Sample rate -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                            <TextBlock Text="Sample rate"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,2"/>
                                            <TextBlock Text="Audio quality (Hz)"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                 Name="SampleRateComboBox"
                                                 Style="{DynamicResource ModernComboBoxStyle}"
                                                 MinWidth="320"
                                                 VerticalAlignment="Center"
                                                 SelectionChanged="SampleRateComboBox_SelectionChanged">
                                            <ComboBoxItem Content="8000 Hz (Standard)" Tag="8000"/>
                                            <ComboBoxItem Content="16000 Hz (High Quality)" Tag="16000" IsSelected="True"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Ringtone card -->
                            <Border Background="{DynamicResource BackgroundMediumBrush}"
                                    CornerRadius="12"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="18,14"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Ringtone"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              Margin="0,0,0,10"/>

                                    <!-- Ringtone sound -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                            <TextBlock Text="Ringtone sound"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,2"/>
                                            <TextBlock Text="Sound played on incoming call"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                 Name="RingtoneSoundComboBox"
                                                 Style="{DynamicResource ModernComboBoxStyle}"
                                                 MinWidth="320"
                                                 VerticalAlignment="Center"
                                                 SelectionChanged="RingtoneSoundComboBox_SelectionChanged">
                                            <ComboBoxItem Content="WAV file (ringtone/incoming_call.wav)" Tag="wav" IsSelected="True"/>
                                            <ComboBoxItem Content="Built-in tone" Tag="tone"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Output device -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                            <TextBlock Text="Output device"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,2"/>
                                            <TextBlock Text="Where the ringtone is played"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                 Name="RingtoneDeviceComboBox"
                                                 Style="{DynamicResource ModernComboBoxStyle}"
                                                 MinWidth="320"
                                                 VerticalAlignment="Center"
                                                 DisplayMemberPath="Name"
                                                 SelectionChanged="RingtoneDeviceComboBox_SelectionChanged"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                  Text="Ringtone volume"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  FontSize="12"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                  Name="RingtoneVolumeValueTextBlock"
                                                  Text="70%"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  FontSize="12"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <Slider Name="RingtoneVolumeSlider"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="70"
                                            Margin="0,0,0,0"
                                            ValueChanged="RingtoneVolumeSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Save Audio Settings"
                                   Name="SaveAudioSettingsButton"
                                   Background="{DynamicResource AccentBlueBrush}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Padding="22,10"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Cursor="Hand"
                                   Click="SaveAudioSettingsButton_Click"
                                   HorizontalAlignment="Left">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#4752C4"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#4A4A4A"/>
                                                            <Setter Property="Foreground" Value="#6A6A6A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Appearance Settings View -->
                    <Grid Name="AppearanceSettingsView" Visibility="Collapsed" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Appearance" 
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,20"/>

                        <!-- Theme (Win11-like row layout: label/description on left, ComboBox on right) -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource BackgroundMediumBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                        <TextBlock Text="Theme"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontSize="14"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,2"/>
                                        <TextBlock Text="Choose how the app looks"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  FontSize="12"/>
                                    </StackPanel>

                                    <ComboBox Grid.Column="1"
                                             Name="ThemeModeComboBox"
                                             Style="{DynamicResource ModernComboBoxStyle}"
                                             MinWidth="280"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ic:SymbolIcon Grid.Column="0"
                                                          Symbol="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Converter={StaticResource ThemeIconConverter}}"
                                                          Width="20"
                                                          Height="20"
                                                          IconVariant="Regular"
                                                          Foreground="{DynamicResource AccentBlueBrush}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          FontSize="13"
                                                          FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Converter={StaticResource ThemeDescriptionConverter}}"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          FontSize="11"
                                                          Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBoxItem Content="Use system theme" Tag="system"/>
                                <ComboBoxItem Content="Dark" Tag="dark"/>
                                <ComboBoxItem Content="Light" Tag="light"/>
                            </ComboBox>
                                </Grid>
                            </Border>

                            <Button Grid.Row="1"
                                   Name="ApplyThemeButton"
                                   Content="Apply Theme"
                                   Background="{DynamicResource AccentBlueBrush}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Padding="20,10"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Cursor="Hand"
                                   Click="ApplyThemeButton_Click"
                                   HorizontalAlignment="Left"
                                   Margin="0,16,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#4752C4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- General Settings View -->
                    <Grid Name="GeneralSettingsView" Visibility="Collapsed" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="General Settings" 
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <!-- Call Recording -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Name="EnableCallRecordingCheckBox" 
                                     Style="{DynamicResource ToggleSwitchStyle}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0"
                                     Checked="EnableCallRecordingCheckBox_Checked"
                                     Unchecked="EnableCallRecordingCheckBox_Unchecked"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Call Recording" 
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="14"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="Record WebRTC calls automatically" 
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          FontSize="12"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="Recording is available in WebRTC mode only." 
                                          Foreground="{DynamicResource AccentBlueBrush}"
                                          FontSize="11"
                                          TextWrapping="Wrap"
                                          Opacity="0.85"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Open Recordings Button -->
                        <Button Grid.Row="2" Name="OpenRecordingsButton"
                               Content="Open Recordings Folder" 
                               Background="{DynamicResource AccentBlueBrush}"
                               Foreground="White"
                               BorderThickness="0"
                               Padding="16,8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               Click="OpenRecordingsButton_Click"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,20">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4752C4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Integrations Settings View -->
                    <Grid Name="IntegrationsSettingsView" Visibility="Collapsed" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Integrations" 
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <!-- Kommo Integration -->
                        <Border Grid.Row="1" 
                                Background="{DynamicResource BackgroundMediumBrush}"
                                CornerRadius="12"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="18,14"
                                Margin="0,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Name="EnableAmoCrmIntegrationCheckBox" 
                                             Style="{DynamicResource ToggleSwitchStyle}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"
                                             Checked="EnableAmoCrmIntegrationCheckBox_Checked"
                                             Unchecked="EnableAmoCrmIntegrationCheckBox_Unchecked"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Kommo Integration" 
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontSize="14"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,4"/>
                                        <TextBlock Text="Automatically attach call logs and recordings to leads in Kommo" 
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  FontSize="12"
                                                  Margin="0,0,0,4"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Lead Selection Toggle (visible when integration is enabled) -->
                                <Grid Margin="0,16,0,16" Name="AmoCrmLeadSelectionGrid" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Name="EnableAmoCrmLeadSelectionCheckBox" 
                                             Style="{DynamicResource ToggleSwitchStyle}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Manual selection lead" 
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontSize="14"
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,4"/>
                                        <TextBlock Text="Used for manual selection of the lead to upload recordings to" 
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  FontSize="12"
                                                  Margin="0,0,0,4"/>
                                    </StackPanel>
                                </Grid>
                                
                                
                                <!-- Kommo Settings (visible when integration is enabled) -->
                                <StackPanel Name="AmoCrmSettingsPanel" Visibility="Collapsed" Margin="0,0,0,0">
                                    <TextBlock Text="Kommo Settings" 
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,12"/>
                                    
                                    <!-- Subdomain field (visible for both modes) -->
                                    <StackPanel Name="AmoCrmSubdomainPanel" Orientation="Vertical" Margin="0,0,0,16">
                                        <TextBlock Text="Subdomain:" 
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  FontSize="13"
                                                  Margin="0,0,0,8"/>
                                        <TextBox Name="AmoCrmSubdomainTextBox" 
                                                Background="{DynamicResource BackgroundDarkBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Padding="8,6" 
                                                FontSize="13"
                                                MinWidth="400"
                                                HorizontalContentAlignment="Left"/>
                                        <TextBlock Text="Example: yourcompany.amocrm.ru or just yourcompany"
                                                  FontSize="11"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  Margin="0,4,0,0"
                                                  TextWrapping="Wrap"
                                                  Opacity="0.7"/>
                                    </StackPanel>
                                    
                                    <!-- Authentication Mode Selection -->
                                    <StackPanel Orientation="Vertical" Margin="0,0,0,16">
                                        <TextBlock Text="Authentication Mode:" 
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  FontSize="13"
                                                  Margin="0,0,0,8"/>
                                        <!-- Modern Segmented Control -->
                                        <Border Background="{DynamicResource BackgroundMediumBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="2"
                                                HorizontalAlignment="Left">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Manual Token Button -->
                                                <Button Name="AmoCrmAuthModeManualButton"
                                                       Content="Manual Token"
                                                       Grid.Column="0"
                                                       Background="{DynamicResource AccentBlueBrush}"
                                                       Foreground="White"
                                                       BorderThickness="0"
                                                       Padding="16,8"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Cursor="Hand"
                                                       Click="AmoCrmAuthModeButton_Click"
                                                       Tag="manual_selected"
                                                       MinWidth="120"/>
                                                
                                                <!-- OAuth Button -->
                                                <Button Name="AmoCrmAuthModeOAuthButton"
                                                       Content="OAuth 2.0"
                                                       Grid.Column="1"
                                                       Background="Transparent"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       BorderThickness="0"
                                                       Padding="16,8"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Cursor="Hand"
                                                       Click="AmoCrmAuthModeButton_Click"
                                                       Tag="oauth"
                                                       MinWidth="120"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- Manual Token Mode -->
                                    <StackPanel Name="AmoCrmManualTokenPanel" Orientation="Vertical" Margin="0,0,0,16">
                                        <TextBlock Text="Access Token:" 
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  FontSize="13"
                                                  Margin="0,0,0,8"/>
                                        <PasswordBox Name="AmoCrmAccessTokenPasswordBox" 
                                                    Background="{DynamicResource BackgroundDarkBrush}"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Padding="8,6" 
                                                    FontSize="13"
                                                    MinWidth="400"
                                                    PasswordChanged="AmoCrmAccessTokenPasswordBox_PasswordChanged"/>
                                        <TextBlock Text="The token will be encrypted and stored locally. Get it from Kommo API settings."
                                                  FontSize="11"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  Margin="0,4,0,0"
                                                  TextWrapping="Wrap"
                                                  Opacity="0.7"/>
                                    </StackPanel>
                                    
                                    <!-- OAuth Mode -->
                                    <StackPanel Name="AmoCrmOAuthPanel" Orientation="Vertical" Margin="0,0,0,16" Visibility="Collapsed">
                                        <StackPanel Orientation="Vertical" Margin="0,0,0,16">
                                            <TextBlock Text="Client ID:" 
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      FontSize="13"
                                                      Margin="0,0,0,8"/>
                                            <TextBox Name="AmoCrmClientIdTextBox" 
                                                    Background="{DynamicResource BackgroundDarkBrush}"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Padding="8,6" 
                                                    FontSize="13"
                                                    MinWidth="400"
                                                    HorizontalContentAlignment="Left"/>
                                            <TextBlock Text="OAuth Client ID from your Kommo integration settings."
                                                      FontSize="11"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      Margin="0,4,0,0"
                                                      TextWrapping="Wrap"
                                                      Opacity="0.7"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Vertical" Margin="0,0,0,16">
                                            <TextBlock Text="Client Secret:" 
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      FontSize="13"
                                                      Margin="0,0,0,8"/>
                                            <PasswordBox Name="AmoCrmClientSecretPasswordBox" 
                                                        Background="{DynamicResource BackgroundDarkBrush}"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        Padding="8,6" 
                                                        FontSize="13"
                                                        MinWidth="400"/>
                                            <TextBlock Text="OAuth Client Secret from your Kommo integration settings."
                                                      FontSize="11"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      Margin="0,4,0,0"
                                                      TextWrapping="Wrap"
                                                      Opacity="0.7"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Vertical" Margin="0,0,0,16">
                                            <TextBlock Text="Redirect URI:" 
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      FontSize="13"
                                                      Margin="0,0,0,8"/>
                                            <TextBox Name="AmoCrmRedirectUriTextBox" 
                                                    Background="{DynamicResource BackgroundDarkBrush}"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Padding="8,6" 
                                                    FontSize="13"
                                                    MinWidth="400"
                                                    HorizontalContentAlignment="Left"
                                                    Text="http://localhost:8080/callback"/>
                                            <TextBlock Text="Redirect URI configured in your Kommo integration (e.g., http://localhost:8080/callback)."
                                                      FontSize="11"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      Margin="0,4,0,0"
                                                      TextWrapping="Wrap"
                                                      Opacity="0.7"/>
                                        </StackPanel>
                                        
                                        <!-- Authorize + Clear Settings buttons side by side -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Button Name="AmoCrmAuthorizeButton"
                                                   Content="Authorize with Kommo"
                                                   Background="{DynamicResource AccentBlueBrush}"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   Padding="16,8"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Cursor="Hand"
                                                   Click="AmoCrmAuthorizeButton_Click"
                                                   Width="200" Height="36"
                                                   Margin="0,0,12,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="4"
                                                                            SnapsToDevicePixels="True">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#4752C4"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="#4A4A4A"/>
                                                                            <Setter Property="Foreground" Value="#6A6A6A"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Name="ClearAmoCrmSettingsButton"
                                                   Content="Clear Settings"
                                                   Background="{DynamicResource BackgroundMediumBrush}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   BorderBrush="{DynamicResource BorderBrush}"
                                                   BorderThickness="1"
                                                   Padding="16,8"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Cursor="Hand"
                                                   Click="ClearAmoCrmSettingsButton_Click"
                                                   Width="150" Height="36">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="4"
                                                                            SnapsToDevicePixels="True">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter Property="Background" Value="#4C4C4F"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Background" Value="#4A4A4A"/>
                                                                            <Setter Property="Foreground" Value="#6A6A6A"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Save + Clear buttons (visible only for Manual Token mode) -->
                                    <StackPanel Name="AmoCrmManualTokenButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <Button Name="SaveAmoCrmSettingsButton"
                                               Content="Save"
                                               Background="{DynamicResource AccentBlueBrush}"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Padding="16,8"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Cursor="Hand"
                                               Click="SaveAmoCrmSettingsButton_Click"
                                               Width="150" Height="36"
                                               Margin="0,0,12,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        SnapsToDevicePixels="True">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#4752C4"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Background" Value="#4A4A4A"/>
                                                                        <Setter Property="Foreground" Value="#6A6A6A"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Clear Settings"
                                               Background="{DynamicResource BackgroundMediumBrush}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               BorderBrush="{DynamicResource BorderBrush}"
                                               BorderThickness="1"
                                               Padding="16,8"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Cursor="Hand"
                                               Click="ClearAmoCrmSettingsButton_Click"
                                               Width="150" Height="36">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4"
                                                                        SnapsToDevicePixels="True">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter Property="Background" Value="#4C4C4F"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Background" Value="#4A4A4A"/>
                                                                        <Setter Property="Foreground" Value="#6A6A6A"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                    
                                    <!-- Status indicators (different for Manual Token and OAuth) -->
                                    <!-- Manual Token Status (Connected/Not connected) -->
                                    <StackPanel Name="AmoCrmManualTokenStatusPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                                        <Ellipse Name="AmoCrmStatusIndicator"
                                                Width="10"
                                                Height="10"
                                                Margin="0,0,8,0"
                                                Fill="#6A6A6A"/>
                                        <TextBlock Name="AmoCrmStatusTextBlock"
                                                  Text="Not connected"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- OAuth Status (Authorized/Not authorized) -->
                                    <StackPanel Name="AmoCrmOAuthStatusPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0" Visibility="Collapsed">
                                        <TextBlock Name="AmoCrmOAuthStatusTextBlock"
                                                  Text="Not authorized"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Advanced Settings View -->
                    <Grid Name="AdvancedSettingsView" Visibility="Collapsed" Margin="30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- WebRTC Settings -->
                        <TextBlock Grid.Row="0" Text="WebRTC Audio Settings" 
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,20"/>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Name="UseWebRtcCheckBox" 
                                     Style="{DynamicResource ToggleSwitchStyle}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" 
                                      Text="Use WebRTC for audio"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      VerticalAlignment="Center"
                                      FontSize="14"/>
                        </Grid>
                        
                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Name="WebRtcStatusTextBlock"
                                      Text="WebRTC Status: Not configured"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      FontSize="13"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"/>
                            <Button Grid.Column="2" Name="TestWebRtcConnectionButton"
                                   Content="Test Connection"
                                   Background="{DynamicResource AccentBlueBrush}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Padding="12,6"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Cursor="Hand"
                                   Click="TestWebRtcConnectionButton_Click"
                                   IsEnabled="False">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#4752C4"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#4A4A4A"/>
                                                            <Setter Property="Foreground" Value="#6A6A6A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        
                        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,20">
                            <TextBlock Text="WebSocket URI:" 
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      FontSize="13"
                                      Margin="0,0,0,8"/>
                            <TextBox Name="WebRtcWsUriTextBox" 
                                    Background="{DynamicResource BackgroundMediumBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="8,6" 
                                    FontSize="13"
                                    MinWidth="400"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Row="4" 
                                  Text="Make sure your PBX supports WebSocket connections." 
                                  FontSize="12" 
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,20"/>
                        
                        <Button Grid.Row="5" Name="SaveGeneralSettingsButton"
                               Content="Save Settings"
                               Background="{DynamicResource AccentBlueBrush}"
                               Foreground="White"
                               BorderThickness="0"
                               Padding="16,8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               Click="SaveGeneralSettingsButton_Click"
                               HorizontalAlignment="Left"
                               Width="150" Height="36">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4752C4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#4A4A4A"/>
                                                        <Setter Property="Foreground" Value="#6A6A6A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Grid>
            
            <!-- Hidden WebView2 for WebRTC testing (always in the visual tree) -->
            <!-- Use Hidden instead of Collapsed so it still participates in layout -->
            <wv2:WebView2 x:Name="WebRtcStatusWebView" 
                         Visibility="Hidden" 
                         Width="1" 
                         Height="1"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- Border stroke overlay (no layout inset) -->
        <Border x:Name="WindowStroke"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                SnapsToDevicePixels="True"
                IsHitTestVisible="False"/>
    </Grid>
</Window>

