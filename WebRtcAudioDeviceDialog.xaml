<Window x:Class="Softphone.WebRtcAudioDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Audio Devices" Height="420" Width="520" MinHeight="380" MinWidth="520"
        WindowStyle="None" 
        AllowsTransparency="False"
        Background="{DynamicResource BackgroundDarkBrush}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <!-- Theme dictionaries are provided by App.xaml (System/Dark/Light). -->
    
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border x:Name="WindowSurface"
                Background="{DynamicResource BackgroundDarkBrush}" 
                CornerRadius="16" 
                ClipToBounds="True">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{DynamicResource BackgroundMediumBrush}" 
                    CornerRadius="16,16,0,0" 
                    Height="48">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                              Text="WebRTC Audio Devices" 
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="16" 
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="24,0,0,0"/>
                    
                    <Button Grid.Column="1"
                            Name="CloseButton"
                            Content="✕"
                            Click="CancelButton_Click"
                            Style="{DynamicResource TitleBarCloseButtonStyle}"
                            Height="32"
                            Margin="0,8,0,8"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Microphone -->
                <TextBlock Grid.Row="0" Text="Microphone:" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontSize="14" 
                          FontWeight="SemiBold"
                          Margin="0,0,0,8"/>

                <ComboBox Grid.Row="2" Name="MicrophoneComboBox"
                         Style="{DynamicResource ModernComboBoxStyle}"
                         DisplayMemberPath="Label"
                         Margin="0,0,0,0"/>

                <!-- Speaker -->
                <TextBlock Grid.Row="4" Text="Speaker:" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontSize="14" 
                          FontWeight="SemiBold"
                          Margin="0,0,0,8"/>

                <ComboBox Grid.Row="6" Name="SpeakerComboBox"
                         Style="{DynamicResource ModernComboBoxStyle}"
                         DisplayMemberPath="Label"
                         Margin="0,0,0,0"/>

            </Grid>

            <!-- Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundMediumBrush}" 
                    CornerRadius="0,0,16,16" 
                    Height="64">
                <Grid Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="2" 
                           Name="ApplyButton"
                           Content="Apply" 
                           Style="{DynamicResource ModernButtonStyle}"
                           Width="100" 
                           Height="32"
                           Click="ApplyButton_Click"
                           Background="{DynamicResource AccentBlueBrush}"
                           Foreground="White"
                           FontWeight="SemiBold"/>
                </Grid>
            </Border>
            </Grid>
        </Border>

        <Border x:Name="WindowStroke"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                IsHitTestVisible="False"/>
    </Grid>
</Window>

