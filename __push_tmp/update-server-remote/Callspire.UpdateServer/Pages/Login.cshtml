@page
@model Callspire.UpdateServer.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<article class="card card-narrow">
    <h1>Admin sign in</h1>
    <p class="lead">Publish installers and edit release notes. Use the credentials from server configuration.</p>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-err" role="alert">@Model.Error</div>
    }

    <form method="post">
        <label for="user">User</label>
        <input type="text" id="user" name="user" required autocomplete="username" placeholder="admin" />

        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••" />

        <div class="btn-row">
            <button type="submit">Sign in</button>
        </div>
    </form>
</article>
