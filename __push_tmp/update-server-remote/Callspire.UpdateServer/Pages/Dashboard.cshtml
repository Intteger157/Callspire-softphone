@page
@model Callspire.UpdateServer.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="page-title">Publish release</h1>
<p class="lead page-lead">Upload a new <code class="inline-code">Callspire-setup.exe</code>, set version and notes. Clients read <strong>update.json</strong> unchanged.</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-ok" role="status">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-err" role="alert">@Model.Error</div>
}

<section class="card">
    <h2>Currently published</h2>
    @if (Model.Current == null)
    {
        <p class="empty-hint">No <code class="inline-code">update.json</code> yet. Upload an installer and click <strong>Publish</strong> below.</p>
    }
    else
    {
        <dl class="meta-grid">
            <dt>Version</dt>
            <dd><strong>@Model.Current.Version</strong></dd>
            <dt>Download URL</dt>
            <dd><a href="@Model.Current.Url" target="_blank" rel="noopener">@Model.Current.Url</a></dd>
            <dt>SHA256</dt>
            <dd><code class="hash">@Model.Current.Sha256</code></dd>
            <dt>Mandatory</dt>
            <dd>@(Model.Current.Mandatory ? "Yes" : "No")</dd>
        </dl>

        @if (!string.IsNullOrEmpty(Model.Current.Notes))
        {
            <h2 style="margin-top:1.25rem;">Release notes</h2>
            <div class="notes-block">@Model.Current.Notes</div>
        }

        <div class="link-row">
            <a href="/Callspire-setup.exe">Download installer</a>
            <a href="/update.json" target="_blank" rel="noopener">Open update.json</a>
        </div>

        <div class="btn-row">
            <button type="button" id="delete-release-btn" class="btn-danger">Delete release</button>
        </div>
    }
</section>

<section class="card">
    <h2>New release</h2>
    <p class="lead lead-tight">Leave installer empty to keep the same file and only change version, notes, or mandatory flag.</p>

    @* We use raw <form> because Razor Pages FormTagHelper can redirect POST to /Dashboard. *@
    @Html.Raw("<form id=\"publish-form\" method=\"post\" enctype=\"multipart/form-data\" action=\"/api/publish\" onsubmit=\"return false;\">")
        <label asp-for="DraftVersion">Version</label>
        <input asp-for="DraftVersion" required placeholder="1.4.2" autocomplete="off" />

        <label asp-for="DraftNotes">Release notes</label>
        <textarea asp-for="DraftNotes" placeholder="- Fixed echo on SIP2&#10;- Improved update server UI"></textarea>

        <label class="checkbox-row">
            <input asp-for="DraftMandatory" />
            <span><strong>Mandatory update</strong> — client hides “Update later” until install.</span>
        </label>

        <label for="installer-input">Installer (.exe)</label>
        <div class="file-picker">
            <div class="file-picker-row">
                <span class="file-picker-btn">Choose file</span>
                <span class="file-picker-name" id="installer-filename">No file chosen</span>
            </div>
            <input type="file" id="installer-input" name="installer" class="file-picker-native" accept=".exe,application/octet-stream" />
        </div>

        <div class="btn-row">
            <button type="button" id="publish-btn" class="btn-primary">Publish</button>
            <button type="button" id="draft-btn" class="btn-ghost">Draft</button>
        </div>
    @Html.Raw("</form>")
</section>

<script>
(function () {
    var input = document.getElementById('installer-input');
    var nameEl = document.getElementById('installer-filename');
    if (input && nameEl) {
        input.addEventListener('change', function () {
            nameEl.textContent = (input.files && input.files.length) ? input.files[0].name : 'No file chosen';
        });
    }

    var form = document.getElementById('publish-form');
    var pubBtn = document.getElementById('publish-btn');
    var draftBtn = document.getElementById('draft-btn');
    if (!form || !pubBtn) return;

    pubBtn.addEventListener('click', function () {
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        var oldText = pubBtn.textContent;
        pubBtn.disabled = true;
        pubBtn.textContent = 'Publishing…';

        var fd = new FormData(form);
        fetch('/api/publish', { method: 'POST', body: fd, credentials: 'same-origin', redirect: 'follow' })
            .then(function (r) {
                if (r.status === 401 || r.status === 403) {
                    window.location.href = '/Login';
                    return;
                }
                if (!r.ok && !r.redirected) {
                    window.location.href = '/Dashboard?err=' + encodeURIComponent('HTTP ' + r.status);
                    return;
                }
                window.location.href = r.url;
            })
            .catch(function () {
                window.location.href = '/Dashboard?err=' + encodeURIComponent('Network or upload failed');
            })
            .finally(function () {
                pubBtn.disabled = false;
                pubBtn.textContent = oldText || 'Publish';
            });
    });

    if (draftBtn) {
        draftBtn.addEventListener('click', function () {
            var oldText = draftBtn.textContent;
            draftBtn.disabled = true;
            draftBtn.textContent = 'Saving…';
            var fd = new FormData(form);
            fetch('/api/draft/save', { method: 'POST', body: fd, credentials: 'same-origin', redirect: 'follow' })
                .then(function (r) { window.location.href = r.url; })
                .catch(function () {
                    window.location.href = '/Dashboard?err=' + encodeURIComponent('Draft save failed');
                })
                .finally(function () {
                    draftBtn.disabled = false;
                    draftBtn.textContent = oldText || 'Draft';
                });
        });
    }

    var delBtn = document.getElementById('delete-release-btn');
    if (delBtn) {
        delBtn.addEventListener('click', function () {
            if (!window.confirm('Delete current release and installer file?')) return;
            var oldText = delBtn.textContent;
            delBtn.disabled = true;
            delBtn.textContent = 'Deleting…';
            fetch('/api/delete-release', { method: 'POST', credentials: 'same-origin', redirect: 'follow' })
                .then(function (r) { window.location.href = r.url; })
                .catch(function () {
                    window.location.href = '/Dashboard?err=' + encodeURIComponent('Delete failed');
                })
                .finally(function () {
                    delBtn.disabled = false;
                    delBtn.textContent = oldText || 'Delete release';
                });
        });
    }
})();
</script>

