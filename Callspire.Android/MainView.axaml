<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Softphone.Android.MainView">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Callspire" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Android softphone shell (Phase 7)"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Opacity="0.7" />
        </StackPanel>
    </Grid>
</UserControl>
