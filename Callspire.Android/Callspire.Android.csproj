<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
		  Avalonia.Android 11.3.x requires net8.0-android34.0 (not android21).
		  Must use .NET 8 SDK in CI (SDK 10 infers TPV 21 and breaks publish).
		-->
		<TargetFramework>net8.0-android34.0</TargetFramework>
		<SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<CheckEolWorkloads>false</CheckEolWorkloads>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<RootNamespace>Softphone.Android</RootNamespace>
		<ApplicationId>com.callspire.softphone</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>$(AppVersion)</ApplicationDisplayVersion>
		<AndroidManifest>AndroidManifest.xml</AndroidManifest>
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Callspire.Core\Callspire.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.11" />
		<PackageReference Include="Avalonia.Android" Version="11.3.11" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
	</ItemGroup>

	<ItemGroup>
		<AndroidPermission Include="android.permission.INTERNET" />
		<AndroidPermission Include="android.permission.RECORD_AUDIO" />
		<AndroidPermission Include="android.permission.MODIFY_AUDIO_SETTINGS" />
		<AndroidPermission Include="android.permission.WAKE_LOCK" />
		<AndroidPermission Include="android.permission.FOREGROUND_SERVICE" />
		<AndroidPermission Include="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
		<AndroidPermission Include="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
		<AndroidPermission Include="android.permission.POST_NOTIFICATIONS" />
	</ItemGroup>

</Project>
