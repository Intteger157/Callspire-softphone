<Window x:Class="Softphone.AudioDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Audio Devices" Height="320" Width="400"
        WindowStyle="None" 
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <!-- Theme dictionaries are provided by App.xaml (System/Dark/Light). -->
    
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border x:Name="WindowSurface"
                Background="{DynamicResource BackgroundDarkBrush}" 
                CornerRadius="16" 
                ClipToBounds="True">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{DynamicResource BackgroundMediumBrush}" 
                    CornerRadius="16,16,0,0"
                    ClipToBounds="True">
                <Grid MouseDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Select Audio Devices" 
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="16" 
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="16,10"/>
                    
                    <Button Grid.Column="1"
                            Name="CloseButton"
                            Content="✕"
                            Click="CloseButton_Click"
                            Style="{DynamicResource TitleBarCloseButtonStyle}"
                            Height="36"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Microphone -->
                <TextBlock Grid.Row="0" Text="Microphone:" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontSize="14" 
                          FontWeight="SemiBold"
                          Margin="0,0,0,8"/>

                <ComboBox Grid.Row="2" Name="MicrophoneComboBox"
                         Style="{DynamicResource ModernComboBoxStyle}"
                         DisplayMemberPath="Name"
                         Margin="0,0,0,0"/>

                <!-- Speaker -->
                <TextBlock Grid.Row="4" Text="Speaker:" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontSize="14" 
                          FontWeight="SemiBold"
                          Margin="0,0,0,8"/>

                <ComboBox Grid.Row="6" Name="SpeakerComboBox"
                         Style="{DynamicResource ModernComboBoxStyle}"
                         DisplayMemberPath="Name"
                         Margin="0,0,0,0"/>

            </Grid>

            <!-- Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundMediumBrush}" 
                    CornerRadius="0,0,16,16" ClipToBounds="True" Margin="0,0,0,0">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Name="CancelButton" Content="Cancel"
                       Style="{DynamicResource ModernButtonStyle}"
                       Click="CancelButton_Click"
                       Margin="16,12,8,12"/>
                
                <Button Grid.Column="1" Name="ApplyButton" Content="Apply"
                       Style="{DynamicResource ModernButtonStyle}"
                       Click="ApplyButton_Click"
                       Margin="8,12,16,12"/>
                </Grid>
            </Border>
            </Grid>
        </Border>

        <Border x:Name="WindowStroke"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                IsHitTestVisible="False"/>
    </Grid>
</Window>

