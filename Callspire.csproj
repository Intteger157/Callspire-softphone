<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Делаем именно приложение, а не библиотеку -->
		<OutputType>WinExe</OutputType>

		<!-- .NET 8 + Windows 10.0.17763 (для SIPSorceryMedia.Windows) -->
		<TargetFramework>net8.0-windows10.0.17763</TargetFramework>

		<!-- Включаем WPF -->
		<UseWPF>true</UseWPF>

		<!-- Включаем поддержку nullable, чтобы убрать ворнинги позже -->
		<Nullable>enable</Nullable>

		<!-- Включаем Runtime Identifier для PortAudio.NET -->
		<UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>

		<ApplicationIcon>icon.ico</ApplicationIcon>

		<Configurations>Debug;Release;Callspire Softphone</Configurations>

		<!-- Application Version -->
		<!-- Измените ТОЛЬКО это значение перед каждым релизом -->
		<!-- Остальные версии (AssemblyVersion, FileVersion, InformationalVersion) вычисляются автоматически -->
		<AppVersion>1.1.8</AppVersion>
		
		<!-- Автоматически вычисляемые версии на основе AppVersion -->
		<Version>$(AppVersion)</Version>
		<AssemblyVersion>$(AppVersion).0</AssemblyVersion>
		<FileVersion>$(AppVersion).0</FileVersion>
		<InformationalVersion>$(AppVersion)</InformationalVersion>

	</PropertyGroup>

	<!-- update-server/ — отдельный ASP.NET-проект в том же репо; не компилировать его в WPF -->
	<PropertyGroup>
		<DefaultItemExcludes>$(DefaultItemExcludes);update-server\**\*</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SIPSorcery" Version="6.2.0" />
		<PackageReference Include="SIPSorceryMedia.Windows" Version="8.0.7" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="FluentIcons.Wpf" Version="1.2.315" />
		<PackageReference Include="PortAudioNet" Version="0.1.0" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
		<PackageReference Include="Concentus" Version="1.1.7" />
	</ItemGroup>
	
	<ItemGroup>
		<Resource Include="Fonts\**\*" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="WebRtcClient\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Incoming call ringtone audio files -->
		<Content Include="ringtone\**\*.wav">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Optional ffmpeg/tools folder (see tools/README_FFMPEG.txt) -->
		<Content Include="tools\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Native AEC: must sit next to Callspire.exe (P/Invoke). PublishSingleFile does not bundle it. -->
		<Content Include="native-aec\build\Release\webrtc_apm.dll" Condition="Exists('native-aec\build\Release\webrtc_apm.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<Link>webrtc_apm.dll</Link>
		</Content>
	</ItemGroup>

</Project>
