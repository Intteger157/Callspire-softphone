<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Делаем именно приложение, а не библиотеку -->
		<OutputType>WinExe</OutputType>

		<!-- .NET 8 + Windows 10.0.17763 (для SIPSorceryMedia.Windows) -->
		<TargetFramework>net8.0-windows10.0.17763</TargetFramework>

		<!-- Включаем WPF -->
		<UseWPF>true</UseWPF>

		<!-- Включаем поддержку nullable, чтобы убрать ворнинги позже -->
		<Nullable>enable</Nullable>

		<!-- Включаем Runtime Identifier для PortAudio.NET -->
		<UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>

		<ApplicationIcon>icon.ico</ApplicationIcon>

		<Configurations>Debug;Release;Callspire Softphone</Configurations>

		<!-- Application Version -->
		<!-- Измените эти значения перед каждым релизом -->
		<Version>1.0.1</Version>
		<AssemblyVersion>1.0.1</AssemblyVersion>
		<FileVersion>1.0.1</FileVersion>
		<InformationalVersion>1.0.1</InformationalVersion>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SIPSorcery" Version="6.2.0" />
		<PackageReference Include="SIPSorceryMedia.Windows" Version="8.0.7" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="FluentIcons.Wpf" Version="1.2.315" />
		<PackageReference Include="PortAudioNet" Version="0.1.0" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
		<PackageReference Include="Concentus" Version="1.1.7" />
	</ItemGroup>
	
	<ItemGroup>
		<Resource Include="Fonts\**\*" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="WebRtcClient\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
