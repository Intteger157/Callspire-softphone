<Window x:Class="Softphone.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Active Call" Height="750" Width="380" MinWidth="380" MinHeight="750"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        KeyDown="CallWindow_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Анимация показа нумпада -->
            <Storyboard x:Key="ShowKeypadStoryboard">
                <DoubleAnimation Storyboard.TargetName="KeypadGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1"
                                 Duration="0:0:0.18" />
                <DoubleAnimation Storyboard.TargetName="KeypadTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="20" To="0"
                                 Duration="0:0:0.18" />
            </Storyboard>
            
            <!-- Анимация скрытия нумпада -->
            <Storyboard x:Key="HideKeypadStoryboard">
                <DoubleAnimation Storyboard.TargetName="KeypadGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0"
                                 Duration="0:0:0.18" />
                <DoubleAnimation Storyboard.TargetName="KeypadTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="0" To="20"
                                 Duration="0:0:0.18" />
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="{StaticResource BackgroundDarkBrush}" 
            CornerRadius="16" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" 
                    CornerRadius="16,16,0,0" ClipToBounds="True">
                <Grid MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Active Call" 
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="16" 
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          Margin="16,10"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="MinimizeButton" Content="─" Width="46" Height="36"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" FontSize="16" Click="MinimizeButton_Click"/> 
                    
                    <Button Name="CloseButton" Content="✕" Width="46" Height="36"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" FontSize="16" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="24,24,24,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Phone Number -->
                <TextBlock Grid.Row="0" Name="CallerNameTextBlock"
                          Text="Unknown (555-0199)" 
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="28"
                          FontWeight="Light"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,8"/>

                <!-- Call Status -->
                <TextBlock Grid.Row="1" Name="CallStatusTextBlock"
                          Text="00:00:15" 
                          Foreground="{StaticResource AccentGreenBrush}"
                          FontSize="18"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,24"/>

                <!-- DTMF Keypad (появляется в центре) -->
                <Grid Grid.Row="2"
                      x:Name="KeypadGrid"
                      Opacity="0"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="KeypadTranslate" Y="20"/>
                    </Grid.RenderTransform>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>

                    <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>

                    <Button Grid.Row="3" Grid.Column="0" Content="*" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="#" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="6" Width="56" Height="56" FontSize="20"/>
                </Grid>

                <!-- Кнопки управления вызовом (всегда внизу) -->
                <StackPanel Grid.Row="3"
                            Name="ControlButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,16">

                    <Button Name="MuteButton"
                            Style="{StaticResource CallControlButton}"
                            ToolTip="Mute"
                            Click="MuteButton_Click"
                            Margin="8,0">
                        <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="24"/>
                    </Button>

                    <Button Name="HoldButton"
                            Content="&#xE769;"
                            Style="{StaticResource CallControlButton}"
                            ToolTip="Hold"
                            Click="HoldButton_Click"
                            Margin="8,0"/>

                    <Button Name="SpeakerButton"
                            Content="&#xE767;"
                            Style="{StaticResource CallControlButton}"
                            ToolTip="Speaker"
                            Click="SpeakerButton_Click"
                            Margin="8,0"/>

                    <Button Name="KeypadToggleButton"
                            Style="{StaticResource CallControlButton}"
                            Click="KeypadToggleButton_Click"
                            ToolTip="Toggle keypad"
                            Margin="8,0">

                        <ic:SymbolIcon Symbol="Dialpad"
                                       Width="24"
                                       Height="24"
                                       IconVariant="Regular"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>

                    </Button>

                </StackPanel>

                <!-- Hang Up Button (всегда внизу) -->
                <Button Grid.Row="4" Name="HangupButton"
                        Style="{StaticResource EndCallButton}"
                        Click="HangupButton_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,32">
                    <ic:SymbolIcon Symbol="CallEnd" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                </Button>

                <!-- Кнопки для входящего звонка -->
                <StackPanel Grid.Row="4" Name="IncomingCallButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,32"
                            Visibility="Collapsed">
                    <Button Name="AnswerButton"
                            Style="{StaticResource CallControlButton}"
                            Click="AnswerButton_Click"
                            Margin="8,0"
                            Width="72"
                            Height="72"
                            Background="{StaticResource AccentGreenBrush}">
                        <ic:SymbolIcon Symbol="Call" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                    </Button>
                    
                    <Button Name="RejectButton"
                            Style="{StaticResource EndCallButton}"
                            Click="RejectButton_Click"
                            Margin="8,0">
                        <ic:SymbolIcon Symbol="CallEnd" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                    </Button>
                </StackPanel>
                
            </Grid>
            
            <!-- WebRTC Container (скрыт по умолчанию, поверх всего контента) -->
            <Grid x:Name="WebRtcContainer" 
                  Grid.Row="1" 
                  Visibility="Collapsed" 
                  Background="Transparent"
                  Margin="24,24,24,40">
                <wv2:WebView2 x:Name="WebRtcWebView" />
            </Grid>
        </Grid>
    </Border>
</Window>

