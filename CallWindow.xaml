<Window x:Class="Softphone.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Active Call" Height="450" Width="380" MinWidth="380" MinHeight="450"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        KeyDown="CallWindow_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="{StaticResource BackgroundDarkBrush}" 
            CornerRadius="16" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Active Call" 
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="16" 
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          Margin="16,10"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="MinimizeButton" Content="─" Width="46" Height="36"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" FontSize="16" Click="MinimizeButton_Click"/> 
                    
                    <Button Name="CloseButton" Content="✕" Width="46" Height="36"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" FontSize="16" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Phone Number -->
                <TextBlock Grid.Row="0" Name="CallerNameTextBlock"
                          Text="Unknown (555-0199)" 
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="28"
                          FontWeight="Light"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,8"/>

                <!-- Call Status -->
                <TextBlock Grid.Row="1" Name="CallStatusTextBlock"
                          Text="00:00:15" 
                          Foreground="{StaticResource AccentGreenBrush}"
                          FontSize="18"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,36"/>

                <!-- Control Buttons and Keypad -->
                <Grid Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <!-- Кнопки управления вызовом -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Отступ -->
                        <ColumnDefinition Width="32"/>
                        <!-- Область под нумпад (фиксированная ширина, чтобы ничего не съезжало) -->
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Control Buttons -->
                    <StackPanel Grid.Column="0"
                                Name="ControlButtonsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        
                        <Button Name="MuteButton"
                                Content="&#xE720;"
                                Style="{StaticResource CallControlButton}"
                                ToolTip="Mute"
                                Click="MuteButton_Click"
                                Margin="8,0"/>
                        
                        <Button Name="HoldButton"
                                Content="&#xE769;"
                                Style="{StaticResource CallControlButton}"
                                ToolTip="Hold"
                                Click="HoldButton_Click"
                                Margin="8,0"/>
                        
                        <Button Name="SpeakerButton"
                                Content="&#xE767;"
                                Style="{StaticResource CallControlButton}"
                                ToolTip="Speaker"
                                Click="SpeakerButton_Click"
                                Margin="8,0"/>
                        
                        <Button Name="KeypadToggleButton"
                               Style="{StaticResource CallControlButton}"
                               Click="KeypadToggleButton_Click"
                               ToolTip="Keypad"
                               Margin="8,0">
                            <ic:SymbolIcon Symbol="Dialpad"
                                           Width="24"
                                           Height="24"
                                           IconVariant="Regular"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        
                    </StackPanel>
                    
                    <!-- Область под нумпад фиксированной ширины -->
                    <Grid Grid.Column="2"
                          Width="220"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                        
                        <!-- DTMF Keypad -->
                        <Grid x:Name="KeypadGrid"
                              Opacity="0"
                              Visibility="Collapsed"
                              Margin="0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="KeypadTranslate" X="40"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                            <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                            <Button Grid.Row="3" Grid.Column="0" Content="*" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="#" Style="{StaticResource NumpadButtonStyle}" Click="DtmfButton_Click" Margin="4" Width="56" Height="56" FontSize="20"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Hang Up Button -->
                <Button Grid.Row="3" Name="HangupButton"
                        Style="{StaticResource EndCallButton}"
                        Click="HangupButton_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24">
                    <ic:SymbolIcon Symbol="CallEnd" Width="32" Height="32" IconVariant="Regular" Foreground="White"/>
                </Button>
                
            </Grid>
        </Grid>
    </Border>
</Window>

