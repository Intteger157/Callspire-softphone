[Unit]
Description=Asterisk web config wrapper
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/asterisk-webcfg
Environment=ASTERISK_ETC=/etc/asterisk
Environment=ASTERISK_CONTAINER=asterisk
Environment=BACKUP_DIR=/var/backups/asterisk-webcfg
Environment=ADMIN_USER=admin
Environment=ADMIN_PASS=change-me
ExecStart=/opt/asterisk-webcfg/.venv/bin/uvicorn webcfg.main:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

