<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Platform-agnostic business logic: SIP/WebRTC signalling, CRM, МиКО АТС mapping, settings, recording pipeline -->
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<!-- Keep the historical namespace so moved files need no edits -->
		<RootNamespace>Softphone</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SIPSorcery" Version="10.0.13" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Concentus" Version="2.2.2" />
		<!-- DPAPI used by TokenEncryption on Windows; runtime no-op path on other platforms -->
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
	</PropertyGroup>

</Project>
