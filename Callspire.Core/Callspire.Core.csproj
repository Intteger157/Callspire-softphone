<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Platform-agnostic business logic: SIP/WebRTC signalling, CRM, МиКО АТС mapping, settings, recording pipeline -->
		<!-- net8.0-android34.0 lets Android head reference Core without android21 asset fallback -->
		<TargetFrameworks>net8.0;net8.0-android34.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<!-- Keep the historical namespace so moved files need no edits -->
		<RootNamespace>Softphone</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SIPSorcery" Version="6.2.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Concentus" Version="1.1.7" />
		<!-- DPAPI used by TokenEncryption on Windows; runtime no-op path on other platforms -->
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
	</ItemGroup>

</Project>
