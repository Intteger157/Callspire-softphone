<Window x:Class="Softphone.CallDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Call Details" Height="700" Width="900" MinHeight="400" MinWidth="600"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Slider Button Style -->
            <Style x:Key="SliderButtonStyle" TargetType="RepeatButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" Height="4"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Global ScrollBar Style -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="GridRoot" Background="{StaticResource BackgroundDarkBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}"/>
                                    <RowDefinition Height="0.00001*"/>
                                    <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}"/>
                                </Grid.RowDefinitions>
                                
                                <Border Grid.Row="1" Background="{StaticResource BackgroundDarkBrush}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                        <Track.Thumb>
                                            <Thumb Background="{StaticResource BackgroundLightBrush}">
                                                <Thumb.Style>
                                                    <Style TargetType="Thumb">
                                                        <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            BorderThickness="0"
                                                                            CornerRadius="4"
                                                                            Margin="2"/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Thumb.Style>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundDarkBrush}" 
            CornerRadius="8" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" 
                    CornerRadius="8,8,0,0" ClipToBounds="True">
                <Grid MouseDown="TitleBar_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Call Details" 
                              FontSize="14" FontWeight="SemiBold" 
                              Margin="16,10,0,10" 
                              VerticalAlignment="Center"
                              Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="─" Width="46" Height="32" 
                               Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                               BorderThickness="0" Click="MinimizeButton_Click"
                               FontSize="16" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="✕" Width="46" Height="32" 
                               Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                               BorderThickness="0" Click="CloseButton_Click"
                               FontSize="16" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Hidden" 
                         HorizontalScrollBarVisibility="Disabled"
                         PanningMode="VerticalOnly"
                         Margin="16">
                <StackPanel>
                    <!-- Call Information -->
                    <TextBlock Text="Call Information" 
                              FontSize="18" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Phone Number:" 
                                  Foreground="{StaticResource TextSecondaryBrush}" 
                                  Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Name="PhoneNumberTextBlock"
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Call Time:" 
                                  Foreground="{StaticResource TextSecondaryBrush}" 
                                  Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Name="CallTimeTextBlock"
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Direction:" 
                                  Foreground="{StaticResource TextSecondaryBrush}" 
                                  Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Name="DirectionTextBlock"
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Status:" 
                                  Foreground="{StaticResource TextSecondaryBrush}" 
                                  Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Name="StatusTextBlock"
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Duration:" 
                                  Foreground="{StaticResource TextSecondaryBrush}" 
                                  Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Name="DurationTextBlock"
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Was Answered:" 
                                  Foreground="{StaticResource TextSecondaryBrush}" 
                                  Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Name="WasAnsweredTextBlock"
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Call Ended By:" 
                                  Foreground="{StaticResource TextSecondaryBrush}" 
                                  Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Name="EndedByTextBlock"
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  Margin="0,0,0,8"/>
                    </Grid>

                    <!-- Timing Information -->
                    <TextBlock Text="Timing Information" 
                              FontSize="18" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,20,0,12"/>
                    
                    <Grid Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ringback Duration:" 
                                  Foreground="{StaticResource TextSecondaryBrush}" 
                                  Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Name="RingbackDurationTextBlock"
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ringback Start:" 
                                  Foreground="{StaticResource TextSecondaryBrush}" 
                                  Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Name="RingbackStartTextBlock"
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Answer Time:" 
                                  Foreground="{StaticResource TextSecondaryBrush}" 
                                  Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Name="AnswerTimeTextBlock"
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  Margin="0,0,0,8"/>
                    </Grid>

                    <!-- Call Recording -->
                    <TextBlock Name="CallRecordingHeader"
                              Text="Call Recording" 
                              FontSize="18" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,20,0,12"/>
                    
                    <Border Background="{StaticResource BackgroundMediumBrush}"
                           CornerRadius="4"
                           Padding="12"
                           Margin="0,0,0,20"
                           Name="RecordingBorder"
                           Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Controls Row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Grid.Column="0" Name="PlayButton"
                                       Click="PlayRecordingButton_Click"
                                       Style="{StaticResource ModernButtonStyle}"
                                       Padding="0"
                                       Margin="0,0,8,0"
                                       Width="40"
                                       Height="40"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}">
                                    <TextBlock Name="PlayButtonContent" Text="▶" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                                </Button>
                                
                                <Slider Grid.Column="1" Name="PositionSlider"
                                       VerticalAlignment="Center"
                                       Minimum="0"
                                       Maximum="0"
                                       Value="0"
                                       Margin="8,0"
                                       ValueChanged="PositionSlider_ValueChanged"
                                       PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                                       PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp">
                                    <Slider.Style>
                                        <Style TargetType="Slider">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Slider">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto" MinHeight="4"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Border Grid.Row="1" 
                                                                   Height="4"
                                                                   Background="{StaticResource BackgroundDarkBrush}"
                                                                   CornerRadius="2"
                                                                   Margin="0,8,0,8"/>
                                                            <Track Grid.Row="1" Name="PART_Track" Margin="0,8,0,8">
                                                                <Track.DecreaseRepeatButton>
                                                                    <RepeatButton Style="{StaticResource SliderButtonStyle}"/>
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.Thumb>
                                                                    <Thumb Name="Thumb">
                                                                        <Thumb.Style>
                                                                            <Style TargetType="Thumb">
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="Thumb">
                                                                                            <Ellipse Width="14" Height="14"
                                                                                                    Fill="{StaticResource AccentGreenBrush}"
                                                                                                    Stroke="{StaticResource BorderBrush}"
                                                                                                    StrokeThickness="1"/>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Template">
                                                                                            <Setter.Value>
                                                                                                <ControlTemplate TargetType="Thumb">
                                                                                                    <Ellipse Width="16" Height="16"
                                                                                                            Fill="{StaticResource AccentGreenBrush}"
                                                                                                            Stroke="{StaticResource BorderBrush}"
                                                                                                            StrokeThickness="2"/>
                                                                                                </ControlTemplate>
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsDragging" Value="True">
                                                                                        <Setter Property="Template">
                                                                                            <Setter.Value>
                                                                                                <ControlTemplate TargetType="Thumb">
                                                                                                    <Ellipse Width="18" Height="18"
                                                                                                            Fill="{StaticResource AccentGreenBrush}"
                                                                                                            Stroke="{StaticResource BorderBrush}"
                                                                                                            StrokeThickness="2"/>
                                                                                                </ControlTemplate>
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Thumb.Style>
                                                                    </Thumb>
                                                                </Track.Thumb>
                                                                <Track.IncreaseRepeatButton>
                                                                    <RepeatButton Style="{StaticResource SliderButtonStyle}"/>
                                                                </Track.IncreaseRepeatButton>
                                                            </Track>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Slider.Style>
                                </Slider>
                                
                                <TextBlock Grid.Column="2" Name="TimeTextBlock"
                                          Text="00:00 / 00:00"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          MinWidth="100"/>
                            </Grid>
                            
                            <!-- MediaElement оставлен скрытым для совместимости (не используется, заменен на NAudio) -->
                            <MediaElement Name="RecordingPlayer"
                                         Grid.Row="1"
                                         LoadedBehavior="Manual"
                                         UnloadedBehavior="Stop"
                                         Height="0"
                                         Visibility="Hidden"/>
                        </Grid>
                    </Border>

                    <!-- Technical Details -->
                    <TextBlock Text="Technical Details" 
                              FontSize="18" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,20,0,12"/>
                    
                    <Border Background="{StaticResource BackgroundMediumBrush}"
                           CornerRadius="4"
                           Padding="12"
                           Margin="0,0,0,20">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" 
                                         HorizontalScrollBarVisibility="Disabled"
                                         MaxHeight="300"
                                         VerticalAlignment="Stretch"
                                         PanningMode="VerticalOnly">
                                <TextBox Name="TechnicalDetailsTextBlock"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        IsReadOnly="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Text="No technical details available."
                                        VerticalScrollBarVisibility="Hidden"
                                        HorizontalScrollBarVisibility="Disabled"
                                        SelectionBrush="{StaticResource AccentGreenBrush}"
                                        SelectionOpacity="0.5">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </ScrollViewer>
                            <Button HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Content="Copy" 
                                   Click="CopyTechnicalDetailsButton_Click"
                                   Background="Transparent"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   BorderThickness="0"
                                   Padding="8,4"
                                   FontSize="11"
                                   Cursor="Hand"
                                   Margin="0,4,4,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="16,8,16,16">
                <Button Content="Close" 
                       Click="CloseButton_Click"
                       Style="{StaticResource ModernButtonStyle}"
                       HorizontalAlignment="Right"
                       Padding="16,8"/>
            </Grid>
        </Grid>
    </Border>
</Window>

