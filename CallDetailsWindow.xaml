<Window x:Class="Softphone.CallDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Call Details" Height="700" Width="900" MinHeight="400" MinWidth="600"
        WindowStyle="None" 
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8,8,8,8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <ResourceDictionary>
            <!-- Theme dictionaries are provided by App.xaml (System/Dark/Light). -->
            
            <!-- Slider Button Style -->
            <Style x:Key="SliderButtonStyle" TargetType="RepeatButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" Height="4"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Global ScrollBar Style -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{DynamicResource BackgroundDarkBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="GridRoot" Background="{DynamicResource BackgroundDarkBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition MaxHeight="{x:Static SystemParameters.VerticalScrollBarButtonHeight}"/>
                                    <RowDefinition Height="0.00001*"/>
                                    <RowDefinition MaxHeight="{x:Static SystemParameters.VerticalScrollBarButtonHeight}"/>
                                </Grid.RowDefinitions>
                                
                                <Border Grid.Row="1" Background="{DynamicResource BackgroundDarkBrush}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                        <Track.Thumb>
                                            <Thumb Background="{DynamicResource BackgroundLightBrush}">
                                                <Thumb.Style>
                                                    <Style TargetType="Thumb">
                                                        <Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            BorderThickness="0"
                                                                            CornerRadius="4"
                                                                            Margin="2"/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Thumb.Style>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border x:Name="WindowSurface"
                Background="{DynamicResource BackgroundDarkBrush}" 
                CornerRadius="8" 
                ClipToBounds="False"
                Margin="0">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{DynamicResource BackgroundMediumBrush}" 
                    CornerRadius="8,8,0,0"
                    ClipToBounds="False"
                    Margin="0">
                <Grid MouseDown="TitleBar_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Call Details" 
                              FontSize="14" FontWeight="SemiBold" 
                              Margin="16,10,0,10" 
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="─" Width="46"
                               Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                               BorderThickness="0" Click="MinimizeButton_Click"
                               FontSize="16" Cursor="Hand"
                               VerticalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="✕"
                               Click="CloseButton_Click"
                               Style="{DynamicResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Hidden" 
                         HorizontalScrollBarVisibility="Disabled"
                         PanningMode="VerticalOnly"
                         Margin="16">
                <StackPanel>
                    <!-- Call Information -->
                    <TextBlock Text="Call Information" 
                              FontSize="18" FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,12"/>
                    
                    <!-- Two-column layout: left = call info, right = timing info -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: General call information + AmoCRM -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource BackgroundMediumBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Phone Number:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,16,8"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,8">
                                    <TextBlock Name="PhoneNumberTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Name="CopyPhoneNumberButton"
                                            Content="Copy"
                                            Click="CopyPhoneNumberButton_Click"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            BorderThickness="0"
                                            Padding="8,4"
                                            FontSize="11"
                                            Cursor="Hand"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Row 1: Outbound CallerID (P-Asserted-Identity) -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Name="OutboundCallerIdLabel" Text="Outbound CallerID:"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,16,8"
                                           Visibility="Collapsed"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="OutboundCallerIdTextBlock"
                                           Foreground="{DynamicResource AccentGreenBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           Visibility="Collapsed"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Call Time:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,16,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Name="CallTimeTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Direction:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,16,8"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Name="DirectionTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               Margin="0,0,8,0"/>
                                    <Border x:Name="TransportBadgeBorder"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource BackgroundLightBrush}">
                                        <TextBlock x:Name="TransportBadgeTextBlock"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,16,8"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Name="StatusTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Duration:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,16,8"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Name="DurationTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Was Answered:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,16,8"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Name="WasAnsweredTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Call Ended By:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,16,8"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Name="EndedByTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Name="RecordAddedLabel" Text="Record added to:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,16,8"/>
                                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Name="AmoCrmLeadTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Margin="0,0,8,0"/>
                                    <Button Name="OpenAmoCrmLeadButton"
                                            Content="Open lead"
                                            Click="OpenAmoCrmLeadButton_Click"
                                            Style="{DynamicResource ModernButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Visibility="Collapsed"
                                            Margin="0,0,8,0"/>
                                    <Button Name="OpenAmoCrmContactButton"
                                            Content="Open Contact"
                                            Click="OpenAmoCrmContactButton_Click"
                                            Style="{DynamicResource ModernButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Visibility="Collapsed"/>
                                </StackPanel>

                                <TextBlock Grid.Row="9" Grid.Column="0" Name="AmoCrmContactNameLabel" Text="AmoCRM Contact Name:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,16,8"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Name="AmoCrmContactNameTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,8"
                                           Text="Loading..."/>

                                <TextBlock Grid.Row="10" Grid.Column="0" Name="AmoCrmUploadStatusLabel" Text="Recording Upload Status:" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,0,16,8"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Name="AmoCrmUploadStatusTextBlock"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- Right: Timing information -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource BackgroundMediumBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Timing Information"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ringback Duration:" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               Margin="0,0,12,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Name="RingbackDurationTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ringback Start:" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               Margin="0,0,12,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Name="RingbackStartTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Answer Time:" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               Margin="0,0,12,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Name="AnswerTimeTextBlock"
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               Margin="0,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Call Recording -->
                    <TextBlock Text="Call Recording" 
                              FontSize="18" FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,20,0,12"/>
                    
                    <Border Background="{DynamicResource BackgroundMediumBrush}"
                           CornerRadius="4"
                           Padding="12"
                           Margin="0,0,0,20"
                           Name="RecordingBorder"
                           Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" 
                                          Text="Call Recording:" 
                                          Foreground="{DynamicResource TextSecondaryBrush}" 
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>
                                
                                <TextBlock Grid.Column="1" 
                                          Name="RecordingFilePathTextBlock"
                                          Foreground="{DynamicResource TextPrimaryBrush}" 
                                          VerticalAlignment="Center"
                                          TextTrimming="CharacterEllipsis"/>
                                
                                <StackPanel Grid.Column="2" 
                                           Orientation="Horizontal"
                                           Margin="12,0,0,0"
                                           HorizontalAlignment="Right">
                                    <Button Name="PlayRecordingButton"
                                           Content="Play" 
                                           Click="PlayRecordingButton_Click"
                                           Style="{DynamicResource ModernButtonStyle}"
                                           Padding="12,6"
                                           Margin="0,0,8,0"/>
                                    <Button Name="OpenFolderButton"
                                           Content="Open folder" 
                                           Click="OpenFolderButton_Click"
                                           Style="{DynamicResource ModernButtonStyle}"
                                           Padding="12,6"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Upload Recording Section -->
                            <StackPanel Margin="0,12,0,0" Orientation="Vertical">
                                <TextBlock Text="Fetch recording from PBX (if no local file) and upload to AmoCRM:"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          FontSize="12"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,6"/>
                                <Button Name="UploadRecordingButton"
                                       Content="Upload Recording" 
                                       Click="UploadRecordingButton_Click"
                                       Style="{DynamicResource ModernButtonStyle}"
                                       Padding="12,6"
                                       HorizontalAlignment="Left"
                                       Visibility="Collapsed"/>

                                <TextBlock Name="UploadMissedCallTextBlock"
                                           Text="If the call was rejected or not answered and you want to create a missed call card, click this button:"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,6"
                                           Visibility="Collapsed"/>
                                <Button Name="UploadMissedCallButton"
                                        Content="Upload missed call"
                                        Click="UploadMissedCallButton_Click"
                                        Style="{DynamicResource ModernButtonStyle}"
                                        Padding="12,6"
                                        HorizontalAlignment="Left"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Technical Details -->
                    <TextBlock Text="Technical Details" 
                              FontSize="18" FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,20,0,12"/>
                    
                    <Border Background="{DynamicResource BackgroundMediumBrush}"
                           CornerRadius="4"
                           Padding="0"
                           Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Tab Control -->
                            <TabControl Name="LogsTabControl"
                                       Grid.Row="0"
                                       SelectionChanged="LogsTabControl_SelectionChanged"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Margin="0,0,0,0">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="16,8"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TabItem">
                                                    <Border Name="Border"
                                                           Background="{TemplateBinding Background}"
                                                           BorderThickness="0"
                                                           Margin="0,0,4,0">
                                                        <ContentPresenter ContentSource="Header"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.Resources>
                                
                                <TabItem Header="All Logs" Name="AllLogsTab"/>
                                <TabItem Header="AmoCRM Logs" Name="AmoCrmLogsTab"/>
                                <TabItem Header="WebRTC Logs" Name="WebRtcLogsTab"/>
                                <TabItem Header="SIP Logs" Name="SipLogsTab"/>
                            </TabControl>
                            
                            <!-- Log Content Area -->
                            <Grid Grid.Row="1" Margin="12,0,12,12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                             HorizontalScrollBarVisibility="Disabled"
                                             MaxHeight="400"
                                             VerticalAlignment="Stretch"
                                             PanningMode="VerticalOnly">
                                    <TextBox Name="TechnicalDetailsTextBlock"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            TextWrapping="Wrap"
                                            IsReadOnly="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Text="Loading logs..."
                                            VerticalScrollBarVisibility="Disabled"
                                            HorizontalScrollBarVisibility="Disabled"
                                            SelectionBrush="{DynamicResource AccentGreenBrush}"
                                            SelectionOpacity="0.5">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </ScrollViewer>
                                <Button HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Content="Copy" 
                                       Click="CopyTechnicalDetailsButton_Click"
                                       Background="Transparent"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       BorderThickness="0"
                                       Padding="8,4"
                                       FontSize="11"
                                       Cursor="Hand"
                                       Margin="0,4,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="16,8,16,16">
                <Button Content="Close" 
                       Click="CloseButton_Click"
                       Style="{DynamicResource ModernButtonStyle}"
                       HorizontalAlignment="Right"
                       Padding="16,8"/>
            </Grid>
            </Grid>
        </Border>

        <Border x:Name="WindowStroke"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
    </Grid>
</Window>

