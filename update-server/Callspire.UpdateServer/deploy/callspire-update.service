# Callspire Update Server — systemd unit
#
# Install:
#   1. dotnet publish -c Release -o /opt/callspire-update/app
#   2. sudo mkdir -p /var/lib/callspire-update/data
#   3. sudo cp deploy/callspire-update.env.example /etc/callspire-update.env
#      sudo nano /etc/callspire-update.env   # set PublicBaseUrl, Admin__Password
#   4. sudo chmod 600 /etc/callspire-update.env
#   5. sudo chown -R www-data:www-data /var/lib/callspire-update/data
#   6. sudo chown -R root:root /opt/callspire-update/app
#      sudo chmod -R a+rX /opt/callspire-update/app
#   7. which dotnet  → if not /usr/bin/dotnet, fix ExecStart below (or symlink dotnet into PATH)
#   8. sudo cp deploy/callspire-update.service /etc/systemd/system/
#   9. sudo systemctl daemon-reload
#  10. sudo systemctl enable --now callspire-update.service

[Unit]
Description=Callspire Update Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/callspire-update/app
ExecStart=/usr/bin/dotnet /opt/callspire-update/app/Callspire.UpdateServer.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=callspire-update

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5088
EnvironmentFile=-/etc/callspire-update.env

# Hardening (optional; drop if something breaks)
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
