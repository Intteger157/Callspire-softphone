@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var ctx = HttpContextAccessor.HttpContext;
    var path = ctx?.Request.Path ?? default;
    var isAuth = ctx?.User?.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Callspire Update</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-bg" aria-hidden="true"></div>
    <div class="admin-shell">
        <header class="admin-header">
            <a href="/" class="brand">Callspire <span>Update</span></a>
            <nav class="admin-nav" aria-label="Main">
                @if (!isAuth)
                {
                    <a href="/Login" class="@(path.StartsWithSegments("/Login") ? "is-active" : null)">Sign in</a>
                }
                else
                {
                    <a href="/Dashboard" class="@(path.StartsWithSegments("/Dashboard") ? "is-active" : null)">Dashboard</a>
                    <a href="/ReleaseHistory" class="@(path.StartsWithSegments("/ReleaseHistory") ? "is-active" : null)">Release history</a>
                }
                <a href="/update.json" target="_blank" rel="noopener" class="nav-external">update.json</a>
                <a href="/Callspire-setup.exe" class="nav-external">Installer</a>
                @if (isAuth)
                {
                    @Html.Raw("<form method=\"post\" action=\"/api/logout\" class=\"nav-signout-form\"><button type=\"submit\" class=\"nav-signout-btn\">Sign out</button></form>")
                }
            </nav>
        </header>
        <main class="admin-main">
            @RenderBody()
        </main>
        <footer class="admin-footer">
            Callspire update server · admin panel
        </footer>
    </div>
</body>
</html>
