<Window x:Class="Softphone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Softphone" Height="700" Width="1100" MinHeight="500" MinWidth="700"
        WindowStyle="None" 
        AllowsTransparency="False"
        Background="{StaticResource BackgroundDarkBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <!-- Global ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="GridRoot" Background="{StaticResource BackgroundDarkBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}"/>
                                <RowDefinition Height="0.00001*"/>
                                <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="1" Background="{StaticResource BackgroundDarkBrush}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                    <Track.Thumb>
                                        <Thumb Background="{StaticResource BackgroundLightBrush}">
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        BorderThickness="0"
                                                                        CornerRadius="4"
                                                                        Margin="2"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundDarkBrush}" 
            CornerRadius="8" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1"
            ClipToBounds="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Grid x:Name="RootGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True"
              RenderOptions.BitmapScalingMode="LowQuality"
              RenderOptions.CachingHint="Cache">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" 
                        CornerRadius="8,8,0,0" ClipToBounds="True">
                    <Grid MouseDown="TitleBar_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Softphone" 
                          FontSize="14" FontWeight="SemiBold" 
                          Margin="16,10,0,10" 
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="─" Width="46" Height="32" 
                           Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                           BorderThickness="0" Click="MinimizeButton_Click"
                           FontSize="16" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" Width="46" Height="32" 
                           Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                           BorderThickness="0" Click="CloseButton_Click"
                           FontSize="16" Cursor="Hand"
                           WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/> 
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0" Background="{StaticResource BackgroundMediumBrush}" 
                       BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                       CornerRadius="0,0,8,8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <Border Grid.Row="0" Margin="4,16,4,16" Height="48">
                            <Border Background="{StaticResource AccentBlueBrush}" 
                                   CornerRadius="24" 
                                   Width="48" Height="48">
                                <TextBlock Text="S" FontSize="20" FontWeight="Bold" 
                                          Foreground="White" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                            </Border>
                        </Border>

                        <!-- Navigation Buttons -->
                        <StackPanel Grid.Row="1">
                            <Button Style="{StaticResource SidebarButtonStyle}" 
                                   Click="DialerButton_Click" Name="DialerButton"
                                   ToolTip="Dialer">
                                <ic:SymbolIcon Symbol="Dialpad" Width="24" Height="24" IconVariant="Regular" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" 
                                   Click="HistoryButton_Click" Name="HistoryButton"
                                   ToolTip="History">
                                <ic:SymbolIcon Symbol="History" Width="24" Height="24" IconVariant="Regular"/>
                            </Button>
                        </StackPanel>

                        <!-- Bottom Buttons (Settings and Logs) -->
                        <StackPanel Grid.Row="2">
                            <Button Style="{StaticResource SidebarButtonStyle}" 
                                   Click="SettingsButton_Click" 
                                   Margin="0,0,0,0"
                                   ToolTip="Settings">
                                <ic:SymbolIcon Symbol="Settings" Width="24" Height="24" IconVariant="Regular"/>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" 
                                   Click="ShowLogsButton_Click" 
                                   Margin="0,0,0,16"
                                   ToolTip="Logs">
                                <ic:SymbolIcon Symbol="DocumentText" Width="24" Height="24" IconVariant="Regular"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                    <!-- Content Area -->
                    <Grid Grid.Column="1" Background="{StaticResource BackgroundDarkBrush}">
                        <!-- Dialer View -->
                    <Grid Name="DialerView" Visibility="Visible" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" 
                          MaxWidth="400" MinWidth="280">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Status -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Name="StatusLabel"
                                      Text="Status:"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"/>
                                <Border Name="WebRtcIndicator"
                                       Width="8" Height="8"
                                       CornerRadius="4"
                                       Background="{StaticResource TextSecondaryBrush}"
                                       Visibility="Collapsed"
                                       ToolTip="WebRTC mode active"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            </StackPanel>
                            <TextBlock Name="StatusTextBlock"
                                      Text="Not connected" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="14"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Phone Number Input -->
                        <TextBox Grid.Row="1" 
                                 Name="PhoneNumberTextBox"
                                 Text="Enter the number"
                                 FontSize="28"
                                 FontWeight="Light"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,0,32"
                                 BorderThickness="0,0,0,2"
                                 BorderBrush="{StaticResource AccentBlueBrush}"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Center"
                                 CaretBrush="{StaticResource AccentBlueBrush}"
                                 GotFocus="PhoneNumberTextBox_GotFocus"
                                 LostFocus="PhoneNumberTextBox_LostFocus"
                                 KeyDown="PhoneNumberTextBox_KeyDown"
                                 TextChanged="PhoneNumberTextBox_TextChanged"/>

                        <!-- Numpad -->
                        <Grid Grid.Row="2" 
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="3" Grid.Column="0" Content="*" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="#" Style="{StaticResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8"/>
                            <Button Grid.Row="4" Grid.Column="1" Name="CallButton"
                                   Style="{StaticResource NumpadCallButtonStyle}" 
                                   Click="CallButton_Click"
                                   Margin="8,16,8,8"
                                   HorizontalAlignment="Center"
                                   IsEnabled="False">
                                <ic:SymbolIcon Symbol="Call" Width="24" Height="24" IconVariant="Regular" Foreground="White"/>
                            </Button>
                            <Button Grid.Row="4" Grid.Column="2" Name="BackspaceButton"
                                   Style="{StaticResource BackspaceButtonStyle}" 
                                   Click="BackspaceButton_Click"
                                   Margin="8,16,8,8">
                                <ic:SymbolIcon Symbol="Backspace" Width="20" Height="20" IconVariant="Regular"/>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- History View -->
                    <Grid Name="HistoryView" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Call History" 
                                      FontSize="24" 
                                      FontWeight="Light"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      VerticalAlignment="Center"/>
                            <Button Name="ClearHistoryButton"
                                   Content="Clear History"
                                   HorizontalAlignment="Right"
                                   Background="{StaticResource BackgroundMediumBrush}"
                                   Foreground="{StaticResource AccentRedBrush}"
                                   BorderThickness="0"
                                   Padding="12,6"
                                   FontSize="14"
                                   Cursor="Hand"
                                   Click="ClearHistoryButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- History List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                            <ItemsControl Name="HistoryItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BackgroundMediumBrush}"
                                               CornerRadius="8"
                                               Padding="16,12"
                                               Margin="0,0,0,8"
                                               BorderBrush="{StaticResource BorderBrush}"
                                               BorderThickness="1"
                                               MouseDown="HistoryItem_MouseDown"
                                               Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ic:SymbolIcon Grid.Column="0"
                                                               Symbol="{Binding CallDirectionIcon}" 
                                                               Width="20" Height="20"
                                                               Foreground="{Binding CallDirectionColor}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,16,0"
                                                               IconVariant="Regular"/> 

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PhoneNumber}"
                                                              FontSize="16"
                                                              FontWeight="SemiBold"
                                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding CallTimeText}"
                                                              FontSize="12"
                                                              Foreground="{StaticResource TextSecondaryBrush}"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="16,0">
                                                    <TextBlock Text="{Binding DurationText}"
                                                              FontSize="12"
                                                              Foreground="{StaticResource TextSecondaryBrush}"
                                                              HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Status}"
                                                              FontSize="12"
                                                              Foreground="{Binding StatusColor}"
                                                              HorizontalAlignment="Right"/>
                                                </StackPanel>

                                                <Button Grid.Column="3"
                                                       Width="36"
                                                       Height="36"
                                                       Style="{StaticResource NumpadCallButtonStyle}"
                                                       Background="{StaticResource AccentGreenBrush}"
                                                       Margin="8,0,0,0"
                                                       Tag="{Binding PhoneNumber}"
                                                       Click="CallFromHistoryButton_Click"
                                                       Padding="10">
                                                       <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                           <ic:SymbolIcon Symbol="Call" IconVariant="Regular" Foreground="White"/>
                                                       </Viewbox>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <TextBlock Grid.Row="1" Name="EmptyHistoryTextBlock"
                                  Text="No call history"
                                  FontSize="16"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                    </Grid>
                    </Grid>
                </Grid>
            
            <!-- Контейнер для скрытого WebView2 (поверх всего контента, но невидим) -->
            <Grid x:Name="WebRtcHostGrid"
                  Width="1" Height="1"
                  Opacity="0"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"/>
            </Grid>
    </Border>
</Window>

