<Window x:Class="Softphone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Softphone" Height="600" Width="900"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundDarkBrush}" 
            CornerRadius="8" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Softphone" 
                          FontSize="14" FontWeight="SemiBold" 
                          Margin="16,10,0,10" 
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="─" Width="46" Height="32" 
                           Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                           BorderThickness="0" Click="MinimizeButton_Click"
                           FontSize="16" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" Width="46" Height="32" 
                           Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                           BorderThickness="0" Click="CloseButton_Click"
                           FontSize="16" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource BackgroundMediumBrush}" 
                       BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <Border Grid.Row="0" Margin="8" Height="64">
                            <Border Background="{StaticResource AccentBlueBrush}" 
                                   CornerRadius="32" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Width="48" Height="48">
                                <TextBlock Text="S" FontSize="20" FontWeight="Bold" 
                                          Foreground="White" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                            </Border>
                        </Border>

                        <!-- Navigation Buttons -->
                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                            <Button Content="👥 Contacts" Style="{StaticResource SidebarButtonStyle}" 
                                   Click="ContactsButton_Click" Name="ContactsButton"/>
                            <Button Content="📞 Dialer" Style="{StaticResource SidebarButtonStyle}" 
                                   Click="DialerButton_Click" Name="DialerButton"/>
                            <Button Content="🕒 History" Style="{StaticResource SidebarButtonStyle}" 
                                   Click="HistoryButton_Click" Name="HistoryButton"/>
                        </StackPanel>

                        <!-- Settings Button -->
                        <Button Grid.Row="2" Content="⚙ Settings" 
                               Style="{StaticResource SidebarButtonStyle}" 
                               Click="SettingsButton_Click" 
                               Margin="0,0,0,8"/>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Column="1" Background="{StaticResource BackgroundDarkBrush}">
                    <!-- Contacts View -->
                    <Grid Name="ContactsView" Visibility="Collapsed" Margin="24">
                        <TextBlock Text="Contacts view — will be implemented later" 
                                  FontSize="16" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Dialer View -->
                    <Grid Name="DialerView" Visibility="Visible" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- SIP Connection Settings -->
                        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" 
                               CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="SIP Connection" 
                                          FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="1" Text="SIP Server:" Margin="0,0,0,4"/>
                                <TextBox Grid.Row="2" Name="SipServerTextBox" 
                                        Style="{StaticResource ModernTextBoxStyle}" 
                                        Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="3" Text="Username:" Margin="0,0,0,4"/>
                                <TextBox Grid.Row="4" Name="SipUsernameTextBox" 
                                        Style="{StaticResource ModernTextBoxStyle}" 
                                        Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="5" Text="Password:" Margin="0,0,0,4"/>
                                <PasswordBox Grid.Row="6" Name="SipPasswordBox" 
                                            Width="300" 
                                            Background="{StaticResource BackgroundLightBrush}"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            Padding="12,8"
                                            FontSize="14"
                                            FontFamily="Segoe UI"
                                            Margin="0,0,0,12"
                                            HorizontalAlignment="Left"/>
                                <Button Grid.Row="7" Content="Connect" 
                                       Background="{StaticResource AccentBlueBrush}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Padding="16,8"
                                       Margin="0,12,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Cursor="Hand"
                                       Click="ConnectButton_Click"
                                       HorizontalAlignment="Left">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4752C4"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Status -->
                        <TextBlock Grid.Row="1" Name="StatusTextBlock" 
                                  Text="Status: Not connected" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,16"/>

                        <!-- Dialer -->
                        <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" 
                               CornerRadius="6" Padding="24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Phone Number" 
                                          FontSize="14" Margin="0,0,0,8"/>
                                <TextBox Grid.Row="1" Name="PhoneNumberTextBox" 
                                        Style="{StaticResource ModernTextBoxStyle}" 
                                        FontSize="18" 
                                        Padding="16,12"
                                        Margin="0,0,0,16"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" 
                                           HorizontalAlignment="Center">
                                    <Button Content="CALL" Name="CallButton" 
                                           Style="{StaticResource CallButtonStyle}" 
                                           Click="CallButton_Click" 
                                           Margin="0,0,12,0"
                                           IsEnabled="False"/>
                                    <Button Content="HANG UP" Name="HangupButton" 
                                           Style="{StaticResource HangupButtonStyle}" 
                                           Click="HangupButton_Click"
                                           IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Call Status -->
                        <TextBlock Grid.Row="3" Name="CallStatusTextBlock" 
                                  Text="" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,16"/>
                    </Grid>

                    <!-- History View -->
                    <Grid Name="HistoryView" Visibility="Collapsed" Margin="24">
                        <TextBlock Text="History view — will be implemented later" 
                                  FontSize="16" 
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

