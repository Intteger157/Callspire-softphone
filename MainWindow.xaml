<Window x:Class="Softphone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Softphone" Height="780" Width="1250" MinHeight="560" MinWidth="780"
        WindowStyle="None" 
        AllowsTransparency="False"
        Background="{DynamicResource BackgroundDarkBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8,8,8,8" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <!-- Global ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource BackgroundDarkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="GridRoot" Background="{DynamicResource BackgroundDarkBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition MaxHeight="{x:Static SystemParameters.VerticalScrollBarButtonHeight}"/>
                                <RowDefinition Height="0.00001*"/>
                                <RowDefinition MaxHeight="{x:Static SystemParameters.VerticalScrollBarButtonHeight}"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="1" Background="{DynamicResource BackgroundDarkBrush}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                    <Track.Thumb>
                                        <Thumb Background="{DynamicResource BackgroundLightBrush}">
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        BorderThickness="0"
                                                                        CornerRadius="4"
                                                                        Margin="2"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Surface (clipped) + Stroke overlay (does not affect layout), so corners stay rounded and close button can sit flush -->
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" 
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Margin="0"
          ClipToBounds="True">
        <Border x:Name="WindowSurface"
                Background="{DynamicResource BackgroundDarkBrush}"
                CornerRadius="8"
                ClipToBounds="False"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0">

        <Grid x:Name="RootGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True"
              RenderOptions.BitmapScalingMode="LowQuality"
              RenderOptions.CachingHint="Cache"
              Margin="0">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border x:Name="TitleBarBorder"
                        Grid.Row="0"
                        Background="{DynamicResource BackgroundMediumBrush}" 
                        CornerRadius="8,8,0,0"
                        ClipToBounds="False"
                        VerticalAlignment="Top"
                        Margin="0"
                        HorizontalAlignment="Stretch">
                    <Grid Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                          MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                          MouseMove="TitleBar_MouseMove">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                          Margin="16,10,0,10" 
                            VerticalAlignment="Center">
                    <Image Width="18"
                           Height="18"
                           Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/icon.ico"/>
                    <TextBlock Text="Softphone"
                               FontSize="14"
                               FontWeight="SemiBold"
                          VerticalAlignment="Center"/>
                </StackPanel>
                <!-- User Account Info in Title Bar -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center"
                           Margin="0,0,12,0">
                    <!-- Online Status Indicator (Green Checkmark) -->
                    <Border Name="OnlineStatusIndicator"
                           Visibility="Collapsed"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center">
                        <ic:SymbolIcon Symbol="CheckmarkCircle" 
                                      Width="14" 
                                      Height="14" 
                                      Foreground="{DynamicResource AccentGreenBrush}"/>
                    </Border>
                    <!-- User Account Text -->
                    <TextBlock Name="UserAccountTextBlock"
                              Text="Not connected"
                              FontSize="12"
                              FontWeight="Regular"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              VerticalAlignment="Center">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Name="UserAccountToolTipTextBlock" 
                                              Text="Not connected"
                                              FontSize="12"/>
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="─" Width="46"
                           Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                           BorderThickness="0" Click="MinimizeButton_Click"
                           FontSize="16" Cursor="Hand"
                           VerticalAlignment="Stretch"
                           WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        Background="{TemplateBinding Background}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Maximize/restore disabled by request -->
                    <Button Content="✕"
                            Click="CloseButton_Click"
                            Style="{DynamicResource TitleBarCloseButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/> 
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border x:Name="SidebarBorder"
                       Grid.Column="0" Background="{DynamicResource BackgroundMediumBrush}" 
                       BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                       CornerRadius="0,0,0,8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <Border Grid.Row="0" Margin="4,16,4,16" Height="48">
                            <Border Background="{DynamicResource AccentBlueBrush}" 
                                   CornerRadius="24" 
                                   Width="48" Height="48">
                                <TextBlock Text="S" FontSize="20" FontWeight="Bold" 
                                          Foreground="White" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                            </Border>
                        </Border>

                        <!-- Navigation Buttons -->
                        <StackPanel Grid.Row="1">
                            <Button Style="{DynamicResource SidebarButtonStyle}" 
                                   Click="DialerButton_Click" Name="DialerButton"
                                   ToolTip="Dialer">
                                <ic:SymbolIcon Symbol="Dialpad" Width="24" Height="24" IconVariant="Regular" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button Style="{DynamicResource SidebarButtonStyle}" 
                                   Click="HistoryButton_Click" Name="HistoryButton"
                                   ToolTip="History">
                                <ic:SymbolIcon Symbol="History" Width="24" Height="24" IconVariant="Regular"/>
                            </Button>
                            <Button Style="{DynamicResource SidebarButtonStyle}" 
                                   Click="StatisticsButton_Click" Name="StatisticsButton"
                                   ToolTip="Statistics">
                                <ic:SymbolIcon Symbol="ChartMultiple" Width="24" Height="24" IconVariant="Regular"/>
                            </Button>
                        </StackPanel>

                        <!-- Bottom Buttons (Settings and Logs) -->
                        <StackPanel Grid.Row="2">
                            <Button Style="{DynamicResource SidebarButtonStyle}" 
                                   Click="SettingsButton_Click" 
                                   Margin="0,0,0,0"
                                   ToolTip="Settings">
                                <ic:SymbolIcon Symbol="Settings" Width="24" Height="24" IconVariant="Regular"/>
                            </Button>
                            <Button Style="{DynamicResource SidebarButtonStyle}" 
                                   Click="ShowLogsButton_Click" 
                                   Margin="0,0,0,16"
                                   ToolTip="Logs">
                                <ic:SymbolIcon Symbol="DocumentText" Width="24" Height="24" IconVariant="Regular"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                    <!-- Content Area -->
                    <Grid Grid.Column="1" Background="{DynamicResource BackgroundDarkBrush}">
                        <!-- Dialer View -->
                    <Grid Name="DialerView" Visibility="Visible" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" 
                          MaxWidth="400" MinWidth="280">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Status -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <Border HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Left">
                            <!-- Status indicators: shared label column + left-aligned rows -->
                            <StackPanel Name="StatusPanel"
                                       HorizontalAlignment="Left"
                                       Orientation="Vertical"
                                       Grid.IsSharedSizeScope="True">
                                <!-- Main connection status -->
                                <Grid Margin="0,0,0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ConnectionStatusLabelCol"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                              Name="MainConnectionStatusLabelTextBlock"
                                              Text="PBX:"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextAlignment="Left"
                                              TextTrimming="CharacterEllipsis"
                                              Margin="0,0,8,0"/>
                                    <Border Grid.Column="1"
                                           Name="MainStatusIndicator"
                                           Width="8" Height="8"
                                           CornerRadius="4"
                                           Background="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="2"
                                              Name="MainStatusTextBlock"
                                              Text="Not connected"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="3"
                                            Name="MainRefreshButton"
                                            Width="20" Height="20"
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Reconnect main connection"
                                            Click="MainRefreshButton_Click"
                                            Style="{StaticResource StatusRefreshButtonStyle}">
                                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                                
                                <!-- Secondary connection status -->
                                <Grid Name="SecondaryStatusPanel"
                                      Margin="0,0,0,4"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ConnectionStatusLabelCol"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                              Name="SecondaryConnectionStatusLabelTextBlock"
                                              Text="SIP:"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextAlignment="Left"
                                              TextTrimming="CharacterEllipsis"
                                              Margin="0,0,8,0"/>
                                    <Border Grid.Column="1"
                                           Name="SecondaryStatusIndicator"
                                           Width="8" Height="8"
                                           CornerRadius="4"
                                           Background="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="2"
                                              Name="SecondaryStatusTextBlock"
                                              Text="Not connected"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="3"
                                            Name="SecondaryRefreshButton"
                                            Width="20" Height="20"
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Reconnect secondary connection"
                                            Click="SecondaryRefreshButton_Click"
                                            Style="{StaticResource StatusRefreshButtonStyle}">
                                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                                
                                <!-- AmoCRM integration status -->
                                <Grid Name="AmoCrmStatusPanel"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ConnectionStatusLabelCol"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                              Text="AmoCRM:"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextAlignment="Left"
                                              Margin="0,0,8,0"/>
                                    <Border Grid.Column="1"
                                           Name="AmoCrmStatusIndicator"
                                           Width="8" Height="8"
                                           CornerRadius="4"
                                           Background="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="2"
                                              Name="AmoCrmStatusTextBlock"
                                              Text="Not connected"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                            </StackPanel>
                            </Border>

                            <!-- SIP auth-failure warning banner (shown when MikoPBX
                                 reports recent rejected REGISTER attempts for this
                                 extension — early warning before Fail2Ban bans us). -->
                            <Border Name="SipAuthFailureBanner"
                                    Background="#3c1f12"
                                    BorderBrush="#b0532f"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#x26A0;"
                                               Foreground="#ffc16b"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Name="SipAuthFailureBannerText"
                                               Text=""
                                               Foreground="#ffd9b0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Phone Number Input with Backspace -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" Grid.ColumnSpan="2"
                                     Name="PhoneNumberTextBox"
                                     Text="Enter the number"
                                     FontSize="28"
                                     FontWeight="Light"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="0"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Center"
                                     CaretBrush="{DynamicResource AccentBlueBrush}"
                                     GotFocus="PhoneNumberTextBox_GotFocus"
                                     LostFocus="PhoneNumberTextBox_LostFocus"
                                     KeyDown="PhoneNumberTextBox_KeyDown"
                                     TextChanged="PhoneNumberTextBox_TextChanged"/>
                            
                            <Button Grid.Column="1" Name="BackspaceButton"
                                   Style="{DynamicResource BackspaceButtonStyle}" 
                                   Click="BackspaceButton_Click"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center">
                                <ic:SymbolIcon Symbol="Backspace" Width="20" Height="20" IconVariant="Regular"/>
                            </Button>
                            
                            <!-- Blue underline extending under both TextBox and Button -->
                            <Border Grid.Column="0" Grid.ColumnSpan="2"
                                    BorderThickness="0,0,0,2"
                                    BorderBrush="{DynamicResource AccentBlueBrush}"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,0"/>
                        </Grid>

                        <!-- Numpad and Call Buttons (separate grids for independence) -->
                        <StackPanel Grid.Row="2" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top">

                            <!-- CallerID selector (visible when user has assigned CallerIDs) -->
                            <StackPanel Name="CallerIdPanel"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10">
                                <TextBlock Text="Caller ID"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <ComboBox Name="CallerIdComboBox"
                                          Style="{DynamicResource ModernComboBoxStyle}"
                                          HorizontalAlignment="Center"
                                          Width="260"
                                          Height="34"
                                          FontSize="14"
                                          FontWeight="Normal"
                                          ToolTip="Select outbound Caller ID"/>
                            </StackPanel>
                            
                            <!-- Numpad buttons grid (independent) -->
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                                <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                                <Button Grid.Row="3" Grid.Column="0" Content="*" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                                <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="#" Style="{DynamicResource NumpadButtonStyle}" Click="NumpadButton_Click" Margin="8,2,8,2"/>
                            </Grid>
                            
                            <!-- Call buttons grid (aligned with numpad column 1, but independent) -->
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Single call button (shown when only one connection active) -->
                                <Button Grid.Column="1" Name="CallButton"
                                       Style="{DynamicResource NumpadCallButtonStyle}" 
                                       Click="CallButton_Click"
                                       HorizontalAlignment="Center"
                                       Margin="8,0,8,0"
                                       IsEnabled="False">
                                    <ic:SymbolIcon Symbol="Call" Width="24" Height="24" IconVariant="Regular" Foreground="White"/>
                                </Button>
                                
                                <!-- Split call button (shown when two connections active) -->
                                <Grid Grid.Column="1" Name="SplitCallButtonPanel"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      Margin="8,0,8,0"
                                      Height="56" Width="130">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left half: Primary connection -->
                                    <Button Grid.Column="0" Name="SplitCallPrimaryButton"
                                            Click="SplitCallPrimary_Click"
                                            ToolTip="Call via primary connection"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border"
                                                                    Background="{DynamicResource AccentGreenBrush}"
                                                                    CornerRadius="28,0,0,28"
                                                                    SnapsToDevicePixels="True">
                                                                <StackPanel Orientation="Vertical" 
                                                                            HorizontalAlignment="Center" 
                                                                            VerticalAlignment="Center">
                                                                    <ic:SymbolIcon Symbol="Call" Width="20" Height="20" 
                                                                                   IconVariant="Regular" Foreground="White"
                                                                                   HorizontalAlignment="Center"/>
                                                                    <TextBlock Name="SplitCallPrimaryLabel" Text="PBX" FontSize="9" FontWeight="SemiBold" 
                                                                              Foreground="#CCFFFFFF" Margin="0,2,0,0"
                                                                              HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#1FB158"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#178835"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#556455"/>
                                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    
                                    <!-- Divider -->
                                    <Border Grid.Column="1" Width="1.5" Background="#33FFFFFF" 
                                            VerticalAlignment="Stretch"/>
                                    
                                    <!-- Right half: Secondary connection -->
                                    <Button Grid.Column="2" Name="SplitCallSecondaryButton"
                                            Click="SplitCallSecondary_Click"
                                            ToolTip="Call via additional connection (SIP)"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border"
                                                                    Background="{DynamicResource AccentGreenBrush}"
                                                                    CornerRadius="0,28,28,0"
                                                                    SnapsToDevicePixels="True">
                                                                <StackPanel Orientation="Vertical" 
                                                                            HorizontalAlignment="Center" 
                                                                            VerticalAlignment="Center">
                                                                    <ic:SymbolIcon Symbol="Call" Width="20" Height="20" 
                                                                                   IconVariant="Regular" Foreground="White"
                                                                                   HorizontalAlignment="Center"/>
                                                                    <TextBlock Name="SplitCallSecondaryLabel" Text="SIP" FontSize="9" FontWeight="SemiBold" 
                                                                              Foreground="#CCFFFFFF" Margin="0,2,0,0"
                                                                              HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#1FB158"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#178835"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="border" Property="Background" Value="#556455"/>
                                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- History View -->
                    <Grid Name="HistoryView" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel>
                            <TextBlock Text="Call History" 
                                      FontSize="24" 
                                      FontWeight="Light"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Name="HistoryFilterHintTextBlock"
                                      FontSize="12"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      Margin="0,4,0,0"
                                      Visibility="Collapsed"/>
                            </StackPanel>
                            <Button Name="ClearHistoryButton"
                                   Content="Clear History"
                                   HorizontalAlignment="Right"
                                   Background="{DynamicResource BackgroundMediumBrush}"
                                   Foreground="{DynamicResource AccentRedBrush}"
                                   BorderThickness="0"
                                   Padding="12,6"
                                   FontSize="14"
                                   Cursor="Hand"
                                   Click="ClearHistoryButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource BackgroundMediumBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentRedBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- History List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                            <ItemsControl Name="HistoryItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BackgroundMediumBrush}"
                                               CornerRadius="8"
                                               Padding="16,12"
                                               Margin="0,0,0,8"
                                               BorderBrush="{DynamicResource BorderBrush}"
                                               BorderThickness="1"
                                               MouseDown="HistoryItem_MouseDown"
                                               Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ic:SymbolIcon Grid.Column="0"
                                                               Symbol="{Binding CallDirectionIcon}" 
                                                               Width="20" Height="20"
                                                               Foreground="{Binding CallDirectionColor}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,16,0"
                                                               IconVariant="Regular"/> 

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PhoneNumberDisplay}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <Border Background="{Binding TransportBrush}"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TransportLabel}"
                                                                       FontSize="10"
                                                                       Foreground="White"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CallTimeText}"
                                                              FontSize="12"
                                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="16,0">
                                                    <TextBlock Text="{Binding DurationText}"
                                                              FontSize="12"
                                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                                              HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Status}"
                                                              FontSize="12"
                                                              Foreground="{Binding StatusColor}"
                                                              HorizontalAlignment="Right"/>
                                                </StackPanel>

                                                <Button Grid.Column="3"
                                                       Width="36"
                                                       Height="36"
                                                       Style="{DynamicResource NumpadCallButtonStyle}"
                                                       Background="{DynamicResource AccentGreenBrush}"
                                                       Margin="8,0,0,0"
                                                       Tag="{Binding PhoneNumber}"
                                                       Click="CallFromHistoryButton_Click"
                                                       Padding="10">
                                                       <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                           <ic:SymbolIcon Symbol="Call" IconVariant="Regular" Foreground="White"/>
                                                       </Viewbox>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <TextBlock Grid.Row="1" Name="EmptyHistoryTextBlock"
                                  Text="No call history"
                                  FontSize="16"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                    </Grid>

                    <!-- Statistics View -->
                    <Grid Name="StatisticsView" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Call Statistics"
                                          FontSize="24"
                                          FontWeight="Light"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Operational analytics from the last 7 days of call history"
                                          FontSize="13"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Name="StatisticsExportCsvButton"
                                   Content="Export CSV"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Padding="14,8"
                                   FontSize="13"
                                   Cursor="Hand"
                                   Click="StatisticsExportCsvButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource BackgroundMediumBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Filters -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Period" VerticalAlignment="Center" Margin="0,0,10,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1" Name="StatisticsPeriodComboBox"
                                     Style="{DynamicResource ModernComboBoxStyle}"
                                     SelectionChanged="StatisticsFilter_Changed" Height="34" FontSize="14"/>
                            <TextBlock Grid.Column="3" Text="Connection" VerticalAlignment="Center" Margin="0,0,10,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="4" Name="StatisticsConnectionComboBox"
                                     Style="{DynamicResource ModernComboBoxStyle}"
                                     SelectionChanged="StatisticsFilter_Changed" Height="34" FontSize="14"/>
                            <TextBlock Grid.Column="6" Text="Direction" VerticalAlignment="Center" Margin="0,0,10,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="7" Name="StatisticsDirectionComboBox"
                                     Style="{DynamicResource ModernComboBoxStyle}"
                                     SelectionChanged="StatisticsFilter_Changed" Height="34" FontSize="14"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Name="StatisticsCustomRangePanel" Orientation="Horizontal"
                                   Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <DatePicker Name="StatisticsCustomFromDatePicker"
                                       Style="{DynamicResource ModernDatePickerStyle}"
                                       SelectedDateChanged="StatisticsCustomDatePicker_SelectedDateChanged"
                                       Margin="0,0,16,0"/>
                            <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <DatePicker Name="StatisticsCustomToDatePicker"
                                       Style="{DynamicResource ModernDatePickerStyle}"
                                       SelectedDateChanged="StatisticsCustomDatePicker_SelectedDateChanged"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                            <StackPanel Name="StatisticsDashboardsPanel">
                                <TextBlock Name="StatisticsPeriodHintTextBlock" FontSize="13"
                                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- KPI row -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{DynamicResource StatisticsCardBorderStyle}" Margin="0,0,8,0"
                                            Cursor="Hand" MouseLeftButtonUp="StatisticsKpi_Click" Tag="All">
                                        <StackPanel>
                                            <TextBlock Text="Total" Style="{DynamicResource StatisticsCardLabelStyle}"/>
                                            <TextBlock Name="StatsKpiTotal" Style="{DynamicResource StatisticsCardValueStyle}"/>
                                            <TextBlock Name="StatsKpiDirectionHint" Style="{DynamicResource StatisticsCardHintStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{DynamicResource StatisticsCardBorderStyle}" Margin="0,0,8,0"
                                            Cursor="Hand" MouseLeftButtonUp="StatisticsKpi_Click" Tag="Answered">
                                        <StackPanel>
                                            <TextBlock Text="Answered" Style="{DynamicResource StatisticsCardLabelStyle}"/>
                                            <TextBlock Name="StatsKpiAnswered" Style="{DynamicResource StatisticsCardValueStyle}"
                                                      Foreground="{DynamicResource AccentGreenBrush}"/>
                                            <TextBlock Name="StatsKpiSuccessRate" Style="{DynamicResource StatisticsCardHintStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{DynamicResource StatisticsCardBorderStyle}" Margin="0,0,8,0"
                                            Cursor="Hand" MouseLeftButtonUp="StatisticsKpi_Click" Tag="Unanswered">
                                        <StackPanel>
                                            <TextBlock Text="Unanswered" Style="{DynamicResource StatisticsCardLabelStyle}"/>
                                            <TextBlock Name="StatsKpiUnanswered" Style="{DynamicResource StatisticsCardValueStyle}"
                                                      Foreground="{DynamicResource AccentRedBrush}"/>
                                            <TextBlock Name="StatsKpiUnansweredHint" Style="{DynamicResource StatisticsCardHintStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{DynamicResource StatisticsCardBorderStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Talk time" Style="{DynamicResource StatisticsCardLabelStyle}"/>
                                            <TextBlock Name="StatsKpiTalkTime" Style="{DynamicResource StatisticsCardValueStyle}"/>
                                            <TextBlock Name="StatsKpiAvgTalk" Style="{DynamicResource StatisticsCardHintStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{DynamicResource StatisticsCardBorderStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Contact rate" Style="{DynamicResource StatisticsCardLabelStyle}"/>
                                            <TextBlock Name="StatsKpiContactRate" Style="{DynamicResource StatisticsCardValueStyle}"/>
                                            <TextBlock Name="StatsKpiRingTime" Style="{DynamicResource StatisticsCardHintStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="5" Style="{DynamicResource StatisticsCardBorderStyle}"
                                            Cursor="Hand" MouseLeftButtonUp="StatisticsKpi_Click" Tag="Missed">
                                        <StackPanel>
                                            <TextBlock Text="Missed incoming" Style="{DynamicResource StatisticsCardLabelStyle}"/>
                                            <TextBlock Name="StatsKpiMissed" Style="{DynamicResource StatisticsCardValueStyle}"
                                                      Foreground="{DynamicResource AccentRedBrush}"/>
                                            <TextBlock Name="StatsKpiFailedCancelled" Style="{DynamicResource StatisticsCardHintStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Charts row -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{DynamicResource StatisticsCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Calls by day" FontSize="15" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <ItemsControl Name="StatsDailyChartItems">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Bottom" Margin="2,0">
                                                            <Border Height="{Binding BarHeight}" MinHeight="4"
                                                                   VerticalAlignment="Bottom"
                                                                   Background="{DynamicResource AccentBlueBrush}"
                                                                   CornerRadius="3,3,0,0"
                                                                   ToolTip="{Binding ToolTipText}"/>
                                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                                      HorizontalAlignment="Center" TextAlignment="Center"
                                                                      Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{DynamicResource StatisticsCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Activity by hour" FontSize="15" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Name="StatsPeakHourText" FontSize="12"
                                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                <ItemsControl Name="StatsHourlyChartItems">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Width="28" VerticalAlignment="Bottom" Margin="1,0">
                                                                <Border Height="{Binding BarHeight}" MinHeight="2"
                                                                       VerticalAlignment="Bottom"
                                                                       Background="{DynamicResource AccentGreenBrush}"
                                                                       CornerRadius="2,2,0,0"
                                                                       ToolTip="{Binding Total, StringFormat={}{0} calls}"/>
                                                                <TextBlock Text="{Binding Label}" FontSize="9"
                                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                                          HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Outcome + Connection compare -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{DynamicResource StatisticsCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Outcome breakdown" FontSize="15" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <TextBlock Name="StatsOutcomeAnswered" Style="{DynamicResource StatisticsCardHintStyle}" Margin="0,0,0,6"/>
                                            <TextBlock Name="StatsOutcomeCancelled" Style="{DynamicResource StatisticsCardHintStyle}" Margin="0,0,0,6"/>
                                            <TextBlock Name="StatsOutcomeAgentCancel" Style="{DynamicResource StatisticsCardHintStyle}" Margin="0,0,0,6"/>
                                            <TextBlock Name="StatsOutcomeFailed" Style="{DynamicResource StatisticsCardHintStyle}" Margin="0,0,0,6"/>
                                            <TextBlock Name="StatsOutcomeMissed" Style="{DynamicResource StatisticsCardHintStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{DynamicResource StatisticsCardBorderStyle}" Name="StatsConnectionComparePanel">
                                        <StackPanel>
                                            <TextBlock Text="By connection" FontSize="15" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <ItemsControl Name="StatsConnectionCompareItems">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                               Padding="0,0,0,10" Margin="0,0,0,10">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding Detail}" FontSize="12"
                                                                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Transport + CRM -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{DynamicResource StatisticsCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="SIP vs WebRTC" FontSize="15" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <ItemsControl Name="StatsTransportItems">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Name="StatsTransportEmptyText" FontSize="12"
                                                      Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"
                                                      Text="No transport data for this filter"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{DynamicResource StatisticsCardBorderStyle}" Name="StatsCrmPanel">
                                        <StackPanel>
                                            <TextBlock Text="AmoCRM" FontSize="15" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <TextBlock Name="StatsCrmLinked" Style="{DynamicResource StatisticsCardHintStyle}" Margin="0,0,0,6"
                                                      Cursor="Hand" MouseLeftButtonUp="StatisticsCrmMetric_Click" Tag="CrmLinkedToLead"/>
                                            <TextBlock Name="StatsCrmSentToContact" Style="{DynamicResource StatisticsCardHintStyle}" Margin="0,0,0,6"
                                                      Cursor="Hand" MouseLeftButtonUp="StatisticsCrmMetric_Click" Tag="CrmSentToContact"/>
                                            <TextBlock Name="StatsCrmRecorded" Style="{DynamicResource StatisticsCardHintStyle}" Margin="0,0,0,6"
                                                      Cursor="Hand" MouseLeftButtonUp="StatisticsCrmMetric_Click" Tag="CrmWithRecording"/>
                                            <TextBlock Name="StatsCrmUploaded" Style="{DynamicResource StatisticsCardHintStyle}" Margin="0,0,0,6"
                                                      Cursor="Hand" MouseLeftButtonUp="StatisticsCrmMetric_Click" Tag="CrmUploadedToAmo"/>
                                            <TextBlock Name="StatsCrmUploadIssues" Style="{DynamicResource StatisticsCardHintStyle}"
                                                      Cursor="Hand" MouseLeftButtonUp="StatisticsCrmMetric_Click" Tag="CrmRecordingNotInAmo"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Caller ID + Top numbers -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{DynamicResource StatisticsCardBorderStyle}" Name="StatsCallerIdPanel">
                                        <StackPanel>
                                            <TextBlock Text="Outbound Caller ID" FontSize="15" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <ItemsControl Name="StatsCallerIdItems">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Name="StatsCallerIdEmptyText" FontSize="12"
                                                      Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"
                                                      Text="No Caller ID data in this period"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{DynamicResource StatisticsCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Top numbers" FontSize="15" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <TextBlock Text="Click a row to view in history" FontSize="11"
                                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <ItemsControl Name="StatsTopNumbersItems">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="4"
                                                               Background="{DynamicResource BackgroundDarkBrush}"
                                                               Cursor="Hand" MouseLeftButtonUp="StatisticsTopNumber_Click"
                                                               Tag="{Binding PhoneNumber}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding PhoneNumber}"
                                                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Detail}"
                                                                          Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Name="StatsTopNumbersEmptyText" FontSize="12"
                                                      Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"
                                                      Text="No calls in this period"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Name="StatisticsLegacyHintTextBlock"
                                          Text="Calls before dual-line tracking may appear under the main connection in exports."
                                          FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                          TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    </Grid>
                </Grid>
            
            <!-- Контейнер для скрытого WebView2 (поверх всего контента, но невидим) -->
            <Grid x:Name="WebRtcHostGrid"
                  Width="1" Height="1"
                  Opacity="0"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"/>
            </Grid>
    </Border>

        <!-- Border stroke overlay (no layout inset) -->
        <Border x:Name="WindowStroke"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                            <Setter Property="CornerRadius" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</Window>

