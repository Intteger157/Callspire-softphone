## Callspire — .gitignore
## Build outputs, IDE noise, local secrets, sibling repos, distribution artifacts.

# ── User-specific IDE / editor ───────────────────────────────────────────────
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.iml

.vs/
.idea/

# VS Code — local workspace settings (remove this block to share settings.json)
.vscode/

# Cursor IDE (local AI workflow — never commit)
.cursor/

# ── .NET / MSBuild build results ─────────────────────────────────────────────
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

project.lock.json
project.fragment.lock.json
artifacts/

# WPF design-time / temp project
*_wpftmp.csproj
*_wpftmp.*

# Ad-hoc compile verification output
_compile_verify_out*/
_build_test_out/

# Local publish output (build.ps1 / build.sh / dotnet publish -o publish/...)
publish/

# MSTest / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage/
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# ── macOS / Linux distribution artifacts ─────────────────────────────────────
*.dmg
*.pkg
*.app/

# ── Secrets & credentials (never commit) ───────────────────────────────────
*.pfx
*.p12
.env
.env.*
!.env.example
credentials.json
**/secrets.json

# ── App user data (stored in %LOCALAPPDATA%\Callspire on Windows) ────────────
settings.json
call_history.json
Callspire/

# ── Native AEC (clone speexdsp locally; CMake output is generated) ─────────
native-aec/speexdsp/
native-aec/build/
native-aec/**/webrtc_apm.dll

# ── Android ──────────────────────────────────────────────────────────────────
# Legacy Gradle project (superseded by Callspire.Android)
android-softphone/

# Scoped Gradle paths — do NOT use **/build/ (ignores repo-root build/ too)
android-softphone/.gradle/
android-softphone/**/build/
**/.gradle/
**/local.properties
*.apk
*.aab

# ── ffmpeg (large; install locally — see tools/README_FFMPEG.txt) ─────────────
tools/Windows/ffmpeg-*/
tools/Windows/**/bin/*.exe
tools/Windows/**/bin/*.dll
tools/MacOS/ffmpeg
tools/macOS/ffmpeg
tools/Linux/ffmpeg
tools/ffmpeg
tools/ffmpeg.exe

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# Backup / scratch files
*.bak
*.bak-*

# Windows reserved device name (accidental file creation)
nul

# ── OpenSpec (local AI workflow artifacts) ───────────────────────────────────
openspec/

# ── Sibling repositories (vendored locally, not part of this monorepo) ───────
amocrm-widget/
callspire-pbx-gateway/
softphone-web/
callspire-web-softphone/
update-server/

# ── Build / distribution artifacts (not source) ─────────────────────────────
build/

# ── Separate tools (not part of Callspire softphone) ─────────────────────────
asterisk-webcfg/

# ── GitHub Actions (enable locally if needed) ────────────────────────────────
.github/
