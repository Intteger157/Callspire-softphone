## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*

# Settings file (now in %LOCALAPPDATA%\Callspire)
# Эти файлы хранятся в %LOCALAPPDATA%\Callspire\ и НЕ должны попадать в репозиторий
settings.json
call_history.json

# User data directory (если случайно создан в корне проекта)
Callspire/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Ad-hoc compile verification output (dotnet build -o ...)
_compile_verify_out*/
_build_test_out/

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# AmoCRM Widget - отдельный репозиторий
amocrm-widget/

# Callspire PBX Gateway — отдельный репозиторий (Callspire-PBX-Gateway)
callspire-pbx-gateway/

# Callspire web softphone — отдельный репозиторий (Callspire-web-softphone)
softphone-web/
callspire-web-softphone/

# Callspire update server — отдельный репозиторий (Callspire-Update-Server)
update-server/

# SpeexDSP sources — clone locally per native-aec/README.md
native-aec/speexdsp/

# Windows reserved names
nul

# Android
**/.gradle/
**/local.properties
**/build/
*.apk
*.aab
