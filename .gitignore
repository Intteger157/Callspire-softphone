## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*

# Settings file (now in %LOCALAPPDATA%\Callspire)
# Эти файлы хранятся в %LOCALAPPDATA%\Callspire\ и НЕ должны попадать в репозиторий
settings.json
call_history.json

# User data directory (если случайно создан в корне проекта)
Callspire/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# AmoCRM Widget - отдельный репозиторий
amocrm-widget/

# Callspire PBX Gateway — отдельный репозиторий (github.com/.../Callspire-PBX-Gateway)
callspire-pbx-gateway/

# Update server runtime data (installers + update.json)
update-server/**/data/

# Update server publish output (contains appsettings snapshots etc)
update-server/**/publish/

# Windows reserved names
nul

# Android
**/.gradle/
**/local.properties
**/build/
*.apk
*.aab
